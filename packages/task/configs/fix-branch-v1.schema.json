{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/fix-branch-v1.schema.json",
  "title": "Task priority fix branch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin_item", "owner", "scope", "priority", "rollback", "validation", "target_item", "resume_item"],
  "properties": {
    "schema_version": {"const": "fix-branch/v1"},
    "origin_item": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"},
    "owner": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "priority": {"enum": ["priority"]},
    "rollback": {"type": "string", "minLength": 1},
    "validation": {"type": "string", "minLength": 1},
    "target_item": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"},
    "resume_item": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"}
  }
}
