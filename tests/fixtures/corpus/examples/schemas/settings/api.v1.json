{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:settings:api:v1",
  "title": "HTTP API settings",
  "description": "Settings section 'api' owned by platform. Every leaf carries x-skm metadata read by the settings registry.",
  "type": "object",
  "additionalProperties": false,
  "x-skm-section": {
    "id": "api",
    "owner": "platform",
    "title": "HTTP API",
    "validators": []
  },
  "x-skm-codegen": {
    "python": {
      "module": "skm.platform.config.generated.settings",
      "class": "ApiSettings",
      "kind": "settings_view"
    },
    "typescript": {
      "file": "settings.ts",
      "name": "ApiSettings"
    }
  },
  "properties": {
    "bind": {
      "type": "string",
      "pattern": "^(\\[[0-9a-fA-F:]+\\]|[A-Za-z0-9.-]{1,253}):[0-9]{1,5}$",
      "default": "127.0.0.1:8765",
      "description": "Listen address host:port of skm serve.",
      "x-skm": {
        "chain": "host",
        "levels": [
          "instance",
          "host"
        ],
        "merge": "replace",
        "reload": "restart",
        "override": true,
        "sensitivity": "public",
        "portable": false,
        "lockable": true,
        "nullable": false,
        "pack": false,
        "confirm": false,
        "ui": {
          "group": "Server",
          "order": 10,
          "widget": "text"
        }
      }
    },
    "allowed_hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(\\[[0-9a-fA-F:]+\\]|[A-Za-z0-9.*-]{1,253})(:[0-9]{1,5})?$"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Accepted Host headers; empty: derived from api.bind for loopback (127.0.0.1, localhost, [::1] with the port).",
      "x-skm": {
        "chain": "host",
        "levels": [
          "instance",
          "host"
        ],
        "merge": "replace",
        "reload": "restart",
        "override": false,
        "sensitivity": "public",
        "portable": false,
        "lockable": true,
        "nullable": false,
        "pack": false,
        "confirm": false,
        "ui": {
          "group": "Server",
          "order": 20,
          "widget": "tags"
        }
      }
    },
    "min_client_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "default": "2.0.0",
      "description": "Clients sending an older SKM-Client-Version get CLIENT_TOO_OLD.",
      "x-skm": {
        "chain": "work",
        "levels": [
          "instance"
        ],
        "merge": "replace",
        "reload": "live",
        "override": false,
        "sensitivity": "public",
        "portable": true,
        "lockable": true,
        "nullable": false,
        "pack": false,
        "confirm": false,
        "ui": {
          "group": "Limits",
          "order": 10,
          "widget": "text"
        }
      }
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 268435456,
      "default": 16777216,
      "description": "Largest JSON response; larger queries must paginate.",
      "x-skm": {
        "chain": "work",
        "levels": [
          "instance"
        ],
        "merge": "replace",
        "reload": "live",
        "override": false,
        "sensitivity": "public",
        "portable": true,
        "lockable": true,
        "nullable": false,
        "pack": false,
        "confirm": false,
        "ui": {
          "group": "Limits",
          "order": 20,
          "widget": "number"
        }
      }
    },
    "schema_check_interval_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 3600,
      "default": 30,
      "description": "How often skm serve compares skm_core.schema_migrations with the known schema version; a newer schema turns readiness to fail (SCHEMA_TOO_NEW).",
      "x-skm": {
        "chain": "host",
        "levels": [
          "instance",
          "host"
        ],
        "merge": "replace",
        "reload": "restart",
        "override": false,
        "sensitivity": "public",
        "portable": false,
        "lockable": true,
        "nullable": false,
        "pack": true,
        "confirm": false,
        "ui": {
          "group": "API",
          "order": 10,
          "widget": "number"
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trusted": {
          "type": "boolean",
          "default": false,
          "description": "Trust X-Forwarded-* headers from a reverse proxy.",
