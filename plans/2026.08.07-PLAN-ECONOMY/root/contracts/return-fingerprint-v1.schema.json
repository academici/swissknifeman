{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/contracts/return-fingerprint-v1.schema.json",
  "title": "Return Fingerprint v1",
  "$comment": "Machine contract with exactly one illustrative example; the example is not a measured baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fingerprint_version",
    "namespace",
    "tuple",
    "digest",
    "metrics"
  ],
  "properties": {
    "fingerprint_version": {
      "const": "v1"
    },
    "namespace": {
      "enum": [
        "classified",
        "provisional",
        "ungroupable"
      ]
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "friction_class",
        "seam"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "pattern": "^P[0-9]+(?:\\.[0-9]+)?$"
        },
        "friction_class": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "friction",
            "result",
            "schema_valid",
            "schema_errors"
          ],
          "properties": {
            "friction": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "result": {
              "type": "string",
              "minLength": 1
            },
            "schema_valid": {
              "type": "boolean"
            },
            "schema_errors": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "seam": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "file",
            "rule_or_contract_locus",
            "defect_class"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "rule_or_contract_locus": {
              "type": "string",
              "minLength": 1
            },
            "defect_class": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "event_ordinal": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provisional_share",
        "ungroupable_share",
        "schema_invalid_rows",
        "non_item_subjects"
      ],
      "properties": {
        "provisional_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ungroupable_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "schema_invalid_rows": {
          "type": "integer",
          "minimum": 0
        },
        "non_item_subjects": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "namespace": {
            "const": "classified"
          }
        },
        "required": [
          "namespace"
        ]
      },
      "then": {
        "properties": {
          "tuple": {
            "allOf": [
              {
                "properties": {
                  "seam": {
                    "type": "object"
                  },
                  "friction_class": {
                    "$ref": "#/$defs/valid_friction_class"
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "event_ordinal"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "namespace": {
            "const": "provisional"
          }
        },
        "required": [
          "namespace"
        ]
      },
      "then": {
        "properties": {
          "tuple": {
            "allOf": [
              {
                "properties": {
                  "seam": {
                    "type": "null"
                  },
                  "friction_class": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/valid_friction_class"
                      },
                      {
                        "anyOf": [
                          {
                            "properties": {
                              "friction": {
                                "minItems": 1
                              }
                            }
                          },
                          {
                            "properties": {
                              "result": {
                                "enum": [
                                  "blocked",
                                  "escalated",
                                  "audit-red"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "event_ordinal"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "namespace": {
            "const": "ungroupable"
          }
        },
        "required": [
          "namespace"
        ]
      },
      "then": {
        "properties": {
          "tuple": {
            "required": [
              "event_ordinal"
            ],
            "properties": {
              "seam": {
                "type": "null"
              },
              "friction_class": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/invalid_friction_class"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/valid_friction_class"
                      },
                      {
                        "properties": {
                          "friction": {
                            "maxItems": 0
                          },
                          "result": {
                            "enum": [
                              "in-progress",
                              "closed-green",
                              "closed-deviations",
                              "no-op",
                              "audit-green"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "valid_friction_class": {
      "type": "object",
      "properties": {
        "friction": {
          "items": {
            "enum": [
              "escalation",
              "routing-blocked",
              "red-audit",
              "deviation",
              "retry",
              "no-op"
            ]
          }
        },
        "result": {
          "enum": [
            "in-progress",
            "closed-green",
            "closed-deviations",
            "blocked",
            "escalated",
            "no-op",
            "audit-green",
            "audit-red"
          ]
        },
        "schema_valid": {
          "const": true
        },
        "schema_errors": {
          "maxItems": 0
        }
      }
    },
    "invalid_friction_class": {
      "type": "object",
      "properties": {
        "schema_valid": {
          "const": false
        },
        "schema_errors": {
          "minItems": 1
        }
      }
    }
  },
  "examples": [
    {
      "fingerprint_version": "v1",
      "namespace": "classified",
      "tuple": {
        "subject": "P4.1",
        "friction_class": {
          "friction": [
            "escalation"
          ],
          "result": "escalated",
          "schema_valid": true,
          "schema_errors": []
        },
        "seam": {
          "file": "packages/task/lib/task/task_contract.py",
          "rule_or_contract_locus": "pre_mutation authority predicate",
          "defect_class": "authority-boundary"
        }
      },
      "digest": "13012e2e569543c1de4871ccc7c383d6a9971323417f77cfa4f016d17a3efaf0",
      "metrics": {
        "provisional_share": 0,
        "ungroupable_share": 0,
        "schema_invalid_rows": 0,
        "non_item_subjects": 0
      }
    }
  ]
}
