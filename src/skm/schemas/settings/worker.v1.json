          "type": "integer",
          "minimum": 10,
          "maximum": 7200,
          "default": 600,
          "description": "Timeout of git calls marked long (clone, fetch, push, gc).",
          "x-skm": {
            "chain": "host",
            "levels": ["instance", "host"],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": false,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "ui": {"group": "Git", "order": 40, "widget": "number"}
