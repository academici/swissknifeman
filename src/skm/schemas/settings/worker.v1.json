          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
          "default": "2.38",
          "description": "Oldest git accepted on this host (worktree and sparse features).",
          "x-skm": {
            "chain": "host",
            "levels": ["instance", "host"],
            "merge": "replace",
            "reload": "restart",
            "override": false,
            "sensitivity": "public",
