{
 "catalog_version": "1.1.0",
 "launch": {
  "scout": {
   "claude-code": {
    "model_class": "economy",
    "effort": "low",
    "transport": "text",
    "argv": [
     "claude",
     "-p",
     "--model",
     "{model}",
     "--effort",
     "{effort}",
     "--tools",
     "",
     "--no-session-persistence"
    ],
    "timeout_s": 300,
    "model_set": "supported"
   },
   "codex": {
    "model_class": "economy",
    "effort": "low",
    "transport": "text",
    "argv": [
     "codex",
     "-a",
     "never",
     "exec",
     "--sandbox",
     "read-only",
     "--model",
     "{model}",
     "-c",
     "model_reasoning_effort=\"{effort}\"",
     "--ephemeral",
     "-"
    ],
    "timeout_s": 300,
    "model_set": "supported"
   }
  },
  "executor": {
   "claude-code": {
    "model_class": "implementation",
    "effort": "high",
    "transport": "jsonl",
    "argv": [
     "python3",
     "{orch}/scripts/ro-run.py",
     "--rw",
     "{cwd}",
     "--",
     "claude",
     "-p",
     "--output-format",
     "stream-json",
     "--verbose",
     "--model",
     "{model}",
     "--effort",
     "{effort}",
     "--permission-mode",
     "acceptEdits",
     "--allowedTools",
     "Bash",
     "--no-session-persistence"
    ],
    "timeout_s": 3600,
    "model_set": "supported"
   },
   "codex": {
    "model_class": "implementation",
    "effort": "high",
    "transport": "jsonl",
    "argv": [
     "codex",
     "-a",
     "never",
     "exec",
     "--json",
     "--sandbox",
     "workspace-write",
     "--model",
     "{model}",
     "-c",
     "model_reasoning_effort=\"{effort}\"",
     "-"
    ],
    "timeout_s": 3600,
    "model_set": "supported"
   },
   "grok": {
    "model_class": "implementation",
    "effort": "high",
    "transport": "acp",
    "argv": [
     "grok",
     "agent",
     "stdio"
    ],
    "timeout_s": 3600,
    "model_set": "unknown"
   }
  },
  "bounded-implementer": {
   "claude-code": {
    "model_class": "economy",
    "effort": "medium",
    "transport": "jsonl",
    "argv": [
     "claude",
     "-p",
     "--output-format",
     "stream-json",
     "--verbose",
     "--model",
     "{model}",
     "--effort",
     "{effort}",
     "--permission-mode",
     "acceptEdits",
     "--no-session-persistence"
    ],
    "timeout_s": 1800,
    "model_set": "supported"
   },
   "codex": {
    "model_class": "economy",
    "effort": "medium",
    "transport": "jsonl",
    "argv": [
     "codex",
     "-a",
     "never",
     "exec",
     "--json",
     "--sandbox",
     "workspace-write",
     "--model",
     "{model}",
     "-c",
     "model_reasoning_effort=\"{effort}\"",
     "-"
    ],
    "timeout_s": 1800,
    "model_set": "supported"
   },
   "grok": {
    "model_class": "economy",
    "effort": "medium",
    "transport": "acp",
    "argv": [
     "grok",
     "agent",
     "stdio"
    ],
    "timeout_s": 1800,
    "model_set": "unknown"
   }
  },
  "reviewer": {
   "claude-code": {
    "model_class": "implementation",
    "effort": "high",
    "transport": "jsonl",
    "argv": [
     "claude",
     "-p",
     "--output-format",
     "stream-json",
     "--verbose",
     "--model",
     "{model}",
     "--effort",
     "{effort}",
     "--disallowedTools",
     "Edit,Write,NotebookEdit",
     "--no-session-persistence"
    ],
    "timeout_s": 1800,
    "model_set": "supported"
   },
   "codex": {
    "model_class": "implementation",
    "effort": "high",
    "transport": "jsonl",
    "argv": [
     "codex",
     "-a",
     "never",
     "exec",
     "--json",
     "--sandbox",
     "read-only",
     "--model",
     "{model}",
     "-c",
     "model_reasoning_effort=\"{effort}\"",
     "-"
    ],
    "timeout_s": 1800,
    "model_set": "supported"
   },
   "grok": {
    "model_class": "implementation",
    "effort": "high",
    "transport": "jsonl",
    "argv": [
     "python3",
     "{orch}/scripts/ro-run.py",
     "--rw",
     "{cwd}/vendor",
     "--",
     "grok",
     "--cwd",
     "{cwd}",
     "--prompt-file",
     "/dev/stdin",
     "--model",
     "{model}",
     "--effort",
     "{effort}",
     "--permission-mode",
     "bypassPermissions",
     "--disallowed-tools",
     "search_replace,write",
     "--output-format",
     "streaming-messages-json"
    ],
    "timeout_s": 3600,
    "model_set": "supported"
   }
  },
  "triager": {
   "claude-code": {
    "model_class": "implementation",
    "effort": "medium",
    "transport": "jsonl",
    "argv": [
     "python3",
     "{orch}/scripts/ro-run.py",
     "--",
     "claude",
     "-p",
     "--output-format",
     "stream-json",
     "--verbose",
     "--model",
     "{model}",
     "--effort",
     "{effort}",
     "--permission-mode",
     "acceptEdits",
     "--allowedTools",
     "Bash",
     "--disallowedTools",
     "Edit,Write,NotebookEdit",
     "--no-session-persistence"
    ],
    "timeout_s": 1800,
    "model_set": "supported"
   },
   "codex": {
    "model_class": "implementation",
    "effort": "medium",
    "transport": "jsonl",
    "argv": [
     "codex",
     "-a",
     "never",
     "exec",
     "--json",
     "--sandbox",
     "read-only",
     "--model",
     "{model}",
     "-c",
     "model_reasoning_effort=\"{effort}\"",
     "-"
    ],
    "timeout_s": 1800,
    "model_set": "supported"
   }
  },
  "registrar": {
   "claude-code": {
    "model_class": "economy",
    "effort": "low",
    "transport": "jsonl",
    "argv": [
     "claude",
     "-p",
     "--output-format",
     "stream-json",
     "--verbose",
     "--model",
     "{model}",
     "--effort",
     "{effort}",
     "--tools",
     "Bash,Read",
     "--allowedTools",
     "Bash(python3 *orch.py source register *)",
     "--no-session-persistence"
    ],
    "timeout_s": 600,
    "model_set": "supported"
   },
   "codex": {
    "model_class": "economy",
    "effort": "low",
    "transport": "jsonl",
    "argv": [
     "codex",
     "-a",
     "never",
     "exec",
     "--json",
     "--sandbox",
     "workspace-write",
     "--model",
     "{model}",
     "-c",
     "model_reasoning_effort=\"{effort}\"",
     "-"
    ],
    "timeout_s": 600,
    "model_set": "supported"
   }
  }
 }
}
