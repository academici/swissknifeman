{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:orch:event-data:orch-review-added:v1",
  "title": "orch.review.added",
  "description": "The risk score added a review the run policy did not have.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the run."
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the piece of work (the input id of the work source)."
    },
    "item": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Reference of the piece of work in its plan."
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Risk score."
    },
    "threshold": {
      "type": "integer",
      "minimum": 0,
      "description": "review.dynamic_threshold."
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Feature."
          },
          "weight": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "weight"
        ],
        "additionalProperties": false
      },
      "description": "Features of the score."
    }
  },
  "required": [
    "run_id",
    "work_id",
    "score",
    "threshold",
    "features"
  ],
  "additionalProperties": false
}
