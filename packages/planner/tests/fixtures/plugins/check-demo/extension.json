{
  "$schema": "urn:swissknifeman:aicore:extension:v1",
  "id": "check-demo",
  "kind": "command",
  "version": "0.1.0",
  "description": "Demo plan check: reports one error and one warning, or fails on request.",
  "protocol": {"min": "1", "max": "1"},
  "entrypoint": ["python3", "plugin.py"],
  "provides": {"points": ["planner:check"]},
  "permissions": {"env": ["CHECK_DEMO_MODE", "CHECK_DEMO_MARKS"]},
  "timeout_seconds": 20
}
