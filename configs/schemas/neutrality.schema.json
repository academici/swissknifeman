{
  "$id": "urn:swissknifeman:hub:neutrality:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neutrality gate rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "terms", "scope", "allow"],
  "properties": {
    "$schema": {"const": "urn:swissknifeman:hub:neutrality:v1"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "pattern": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude_globs"],
      "properties": {
        "include": {"$ref": "#/$defs/strings"},
        "exclude_globs": {"$ref": "#/$defs/strings"}
      }
    },
    "allow": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path_glob", "term", "reason"],
            "properties": {
              "path_glob": {"type": "string", "minLength": 1},
              "term": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["json_fields", "term", "reason"],
            "properties": {
              "json_fields": {"$ref": "#/$defs/strings"},
              "term": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9-]*\\|[^|\\r\\n]+$": {"type": "integer", "minimum": 1}
      }
    },
    "baseline": {
      "description": "configs/neutrality-baseline.json; only positive occurrence counts are stored.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "counts"],
      "properties": {
        "schema_version": {"const": 1},
        "counts": {"$ref": "#/$defs/counts"}
      }
    },
    "report": {
      "description": "public-hygiene --json; legacy path/content/plan rules and config errors use line 0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["violations", "improved", "counts"],
      "properties": {
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line", "term", "reason"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 0},
              "term": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "improved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "old", "new"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[^|\\r\\n]+$"},
              "old": {"type": "integer", "minimum": 1},
              "new": {"type": "integer", "minimum": 0}
            }
          }
        },
        "counts": {"$ref": "#/$defs/counts"}
      }
    }
  }
}
