    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(git_guardrails|safe_dirs|plan_guard|pack_guard|managed_guard|changelog_gate|review_gate|command_log|session_start|run_report)$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "warn",
              "strict"
            ]
          },
          "default": {
            "git_guardrails": "strict",
            "safe_dirs": "strict",
            "plan_guard": "strict",
            "pack_guard": "warn",
            "managed_guard": "warn",
            "changelog_gate": "off",
            "review_gate": "warn",
            "command_log": "off",
            "session_start": "warn",
            "run_report": "off"
