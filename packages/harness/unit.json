{
  "$schema": "urn:swissknifeman:aicore:unit:v1",
  "id": "harness",
  "title": "Provider environment setup: permissions, MCP, hooks, instructions",
  "kind": "capability",
  "version": "0.7.1",
  "stability": "beta",
  "destination": "hub",
  "requires": [
    {"unit": "aicore", "range": "^0.1", "description": "Shared helpers (today the root core package)."}
  ],
  "provides": {
    "cli": ["bin/harness"],
    "plugins": [{"name": "harness", "manifest": ".claude-plugin/plugin.json"}],
    "doctor": [
      {"id": "harness.environment", "category": "environment", "probe": ["bin/harness", "doctor"], "output": "text"}
    ]
  },
  "dev": {
    "test": ["bash", "scripts/test.sh"],
    "validate": ["bash", "scripts/validate.sh"]
  }
}
