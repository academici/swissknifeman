usage: plan.py decide [-h] [--plans-root PLANS_ROOT] --accept ACCEPT
                      --rationale RATIONALE [--by {owner,agent}]
                      [--actor ACTOR]
                      plan D#

accept an open decision

positional arguments:
  plan                  plan id, PLAN<N> or path
  D#

options:
  -h, --help            show this help message and exit
  --plans-root PLANS_ROOT
                        plans/ directory (default: nearest up from cwd)
  --accept ACCEPT       option id or decision text
  --rationale RATIONALE
  --by {owner,agent}
  --actor ACTOR         PROVIDER/MODEL[/EFFORT] (default: the item executor,
                        else plan authoring)
