{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:runtimes:view:runtimes:v1",
  "title": "RuntimesView",
  "description": "runtimes owner contract; see the runtimes module.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runtime_id": {
        "$ref": "urn:skm:extensions:defs:v1#/$defs/runtime_id"
      },
      "registered": {
        "type": "boolean"
      },
      "adapter_version": {
        "type": "string",
        "minLength": 0
      },
      "installations": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host_id": {
              "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "auth_state": {
              "type": "string",
              "enum": [
                "ok",
                "missing",
                "expired",
                "unknown"
              ]
            },
            "detected_at": {
              "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
            }
          },
          "required": [
            "host_id",
            "version",
            "auth_state",
            "detected_at"
          ]
        }
      },
      "allowed_in_scope": {
        "type": "boolean"
      }
    },
    "required": [
      "runtime_id",
      "registered",
      "adapter_version",
      "installations",
      "allowed_in_scope"
    ]
  },
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.runtimes.generated.views",
      "class": "RuntimesView",
      "kind": "alias"
    },
    "typescript": {
      "file": "runtimes.ts",
      "name": "RuntimesView"
    }
  }
}
