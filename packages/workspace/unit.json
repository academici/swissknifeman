{
  "$schema": "urn:swissknifeman:aicore:unit:v1",
  "id": "workspace",
  "title": "Portable workspace: the plans of all projects in one git root",
  "kind": "capability",
  "version": "0.1.0",
  "stability": "development",
  "destination": "hub",
  "requires": [
    {
      "unit": "aicore",
      "range": "^0.1",
      "description": "Foundation: locations, workspace documents and bindings, configuration, events."
    }
  ],
  "execution": {
    "project": "optional",
    "cwd": "preserve",
    "writes": "project-and-machine"
  },
  "provides": {
    "cli": [
      "bin/workspace"
    ],
    "config": "configs/config.schema.json",
    "contracts": [
      {
        "id": "urn:swissknifeman:workspace:command",
        "path": "schemas/command/v1",
        "version": "v1",
        "stability": "development"
      },
      {
        "id": "urn:swissknifeman:workspace:event-data",
        "path": "schemas/event-data/v1",
        "version": "v1",
        "stability": "development",
        "direction": "output"
      },
      {
        "id": "urn:swissknifeman:workspace:plans-migrator",
        "path": "schemas/plans-migrator/v1",
        "version": "v1",
        "stability": "development"
      },
      {
        "id": "urn:swissknifeman:workspace:publish-report",
        "path": "schemas/publish-report/v1",
        "version": "v1",
        "stability": "development"
      }
    ],
    "events": [
      "workspace.root.initialized",
      "workspace.project.attached",
      "workspace.migration.applied",
      "workspace.migration.rolled-back",
      "workspace.sync.committed",
      "workspace.sync.pulled",
      "workspace.sync.conflict",
      "workspace.sync.pushed"
    ],
    "extension_points": [
      {
        "id": "plans-migrator",
        "description": "The command that moves the plans of a checkout into the workspace (migrate); filled by a bridge, never imported."
      }
    ],
    "doctor": [
      {
        "id": "workspace.layout",
        "category": "state",
        "probe": [
          "bin/workspace",
          "doctor"
        ],
        "output": "text"
      }
    ]
  },
  "permissions": {
    "filesystem": [
      "project",
      "state",
      "home"
    ],
    "network": true,
    "shell": true
  },
  "dev": {
    "test": [
      "bash",
      "scripts/test.sh"
    ]
  }
}
