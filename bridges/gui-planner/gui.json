{
  "$schema": "urn:swissknifeman:gui:contribution:v1",
  "commands": [
    {
      "concurrency_key": "gui-planner:{project_id}:{plan_id}",
      "confirmation": "risk-based",
      "description": "Merge-patch editable fields of an item; refused when the revision changed or the item is being executed.",
      "effects": [
        "plan.write"
      ],
      "exec": {
        "kind": "invoke"
      },
      "id": "gui-planner.item-set",
      "input": [
        {
          "description": "A JSON object of editable item fields.",
          "name": "patch",
          "required": true,
          "title": "JSON patch",
          "type": "string"
        },
        {
          "name": "expected_revision",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "required": true,
          "title": "Revision the form was built on",
          "type": "string"
        }
      ],
      "risk": "medium",
      "scope": "item",
      "timeout_s": 60,
      "title": "Edit item"
    },
    {
      "concurrency_key": "gui-planner:{project_id}:{plan_id}",
      "confirmation": "risk-based",
      "description": "Merge-patch editable fields of a phase; refused when the revision changed.",
      "effects": [
        "plan.write"
      ],
      "exec": {
        "kind": "invoke"
      },
      "id": "gui-planner.phase-set",
      "input": [
        {
          "name": "phase",
          "pattern": "^P[0-9]+$",
          "required": true,
          "title": "Phase",
          "type": "string"
        },
        {
          "description": "A JSON object of editable phase fields.",
          "name": "patch",
          "required": true,
          "title": "JSON patch",
          "type": "string"
        },
        {
          "name": "expected_revision",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "required": true,
          "title": "Revision the form was built on",
          "type": "string"
        }
      ],
      "risk": "medium",
      "scope": "plan",
      "timeout_s": 60,
      "title": "Edit phase"
    },
    {
      "concurrency_key": "gui-planner:{project_id}:{plan_id}",
      "confirmation": "risk-based",
      "description": "Accept an open decision with a rationale.",
      "effects": [
        "plan.write"
      ],
      "exec": {
        "kind": "invoke"
      },
      "id": "gui-planner.decision-decide",
      "input": [
        {
          "name": "decision",
          "pattern": "^D[0-9]+$",
          "required": true,
          "title": "Decision",
          "type": "string"
        },
        {
          "name": "accept",
          "required": true,
          "title": "Accepted option or text",
          "type": "string"
        },
        {
          "name": "rationale",
          "required": true,
          "title": "Rationale",
          "type": "string"
        },
        {
          "default": "owner",
          "enum": [
            "owner",
            "agent"
          ],
          "name": "by",
          "required": false,
          "title": "Decided by",
          "type": "enum"
        }
      ],
      "risk": "medium",
      "scope": "plan",
      "timeout_s": 60,
      "title": "Decide"
    },
    {
      "concurrency_key": "gui-planner:{project_id}:{plan_id}",
      "confirmation": "always",
      "description": "Reopen a finished item (owner amendment); the item returns to todo.",
      "effects": [
        "plan.write"
      ],
      "exec": {
        "kind": "invoke"
      },
      "id": "gui-planner.item-reopen",
      "input": [
        {
          "name": "reason",
          "required": true,
          "title": "Reason",
          "type": "string"
        }
      ],
      "risk": "high",
      "scope": "item",
      "timeout_s": 60,
      "title": "Reopen item"
    },
    {
      "concurrency_key": "gui-planner:{project_id}:{plan_id}",
      "confirmation": "always",
      "description": "Record an owner gate grant for the items that wait for it.",
      "effects": [
        "plan.write"
      ],
      "exec": {
        "kind": "invoke"
      },
      "id": "gui-planner.grant",
      "input": [
        {
          "name": "gate",
          "pattern": "^[A-Z0-9][A-Z0-9._-]*$",
          "required": true,
          "title": "Gate",
          "type": "string"
        },
        {
          "name": "note",
          "required": true,
          "title": "Note quoting the owner",
          "type": "string"
        }
      ],
      "risk": "high",
      "scope": "plan",
      "timeout_s": 60,
      "title": "Grant gate"
    },
    {
      "concurrency_key": "gui-planner:{project_id}:{plan_id}",
      "confirmation": "none",
      "description": "Record a deviation, blocker, difficulty, assumption or note for a phase or an item.",
      "effects": [
        "plan.write"
      ],
      "exec": {
        "kind": "invoke"
      },
      "id": "gui-planner.log-note",
      "input": [
        {
          "name": "target",
          "pattern": "^P[0-9]+(\\.[0-9]+)?$",
          "required": true,
          "title": "Phase or item",
          "type": "string"
        },
        {
          "enum": [
            "deviation",
            "blocker",
            "difficulty",
            "assumption",
            "note"
          ],
          "name": "type",
          "required": true,
          "title": "Type",
          "type": "enum"
        },
        {
          "name": "summary",
          "required": true,
          "title": "Summary",
          "type": "string"
        }
      ],
      "risk": "low",
      "scope": "plan",
      "timeout_s": 60,
      "title": "Log a note"
    }
  ],
  "forms": [
    {
      "fields": [
        {
          "group": "intent",
          "order": 0,
          "pointer": "/title",
          "widget": "text"
        },
        {
