{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:orch:event-data:orch-agent-questioned:v1",
  "title": "orch.agent.questioned",
  "description": "An agent asked a question; a blocking one stops the piece until it is answered.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the run."
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the piece of work (the input id of the work source)."
    },
    "item": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Reference of the piece of work in its plan."
    },
    "step": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Step of the agent."
    },
    "agent_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Agent run that asked, when known."
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the question."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision of the question."
    },
    "blocking": {
      "type": "boolean",
      "description": "Whether the question blocks the piece."
    }
  },
  "required": [
    "run_id",
    "work_id",
    "step",
    "question_id",
    "blocking"
  ],
  "additionalProperties": false
}
