                }
              }
            }
          }
        },
        "skill_listing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fraction": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 0.5,
              "default": 0.01,
              "description": "Share of the context window the client's skill listing may take.",
              "x-skm": {
                "chain": "work",
                "levels": [
                  "instance"
                ],
                "merge": "replace",
                "reload": "live",
                "override": false,
                "sensitivity": "public",
                "portable": true,
                "lockable": true,
                "nullable": false,
                "pack": true,
                "confirm": false,
                "ui": {
                  "group": "Budget",
                  "order": 30,
                  "widget": "number"
                }
              }
            },
            "context_window": {
              "type": "integer",
              "minimum": 8000,
              "maximum": 10000000,
              "default": 1000000,
              "description": "Context window assumed for the skill listing share.",
              "x-skm": {
                "chain": "work",
                "levels": [
                  "instance"
                ],
                "merge": "replace",
                "reload": "live",
                "override": false,
                "sensitivity": "public",
                "portable": true,
                "lockable": true,
                "nullable": false,
