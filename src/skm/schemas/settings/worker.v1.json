          "description": "Author and committer email of commits made by SKM.",
          "x-skm": {
            "chain": "host",
            "levels": ["instance", "host"],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": false,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "ui": {"group": "Git", "order": 20, "widget": "text"}
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 60,
          "description": "Timeout of an ordinary git call.",
          "x-skm": {
            "chain": "host",
            "levels": ["instance", "host"],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": false,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "ui": {"group": "Git", "order": 30, "widget": "number"}
