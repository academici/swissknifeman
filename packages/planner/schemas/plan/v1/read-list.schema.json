{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:task:plan:read-list:v1",
  "title": "Read List",
  "type": "array",
  "description": "Deterministically ordered document rows matching every supplied filter.",
  "items": {
    "type": "object",
    "description": "One lightweight document row.",
    "properties": {
      "ref": {
        "description": "Local document reference.",
        "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/ref"
      },
      "title": {
        "type": [
          "string",
          "null"
        ],
        "description": "Document title, or null when absent."
      },
      "status": {
        "type": [
          "string",
          "null"
        ],
        "description": "Document status, or null when this kind has no status."
      }
    },
    "required": [
      "ref",
      "title",
      "status"
    ],
    "additionalProperties": false
  }
}
