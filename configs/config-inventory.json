        "packages/aicore/lib/aicore/config/example.py",
        "scripts/ecosystem-units.py"
      ],
      "released": false,
      "note": "planner thresholds, defaults of new plans and items, review loop policies, view templates, orchestration scenarios, events and external checks in [planner]"
    },
    {
      "path": "packages/maind/configs/config.schema.json",
