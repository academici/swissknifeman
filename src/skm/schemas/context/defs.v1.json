          ]
        },
        "research": {
          "type": "array",
          "items": {
            "$ref": "urn:skm:context:defs:v1#/$defs/ResearchItem"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "urn:skm:context:defs:v1#/$defs/HistoryItem"
          }
        }
      },
