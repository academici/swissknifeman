      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "step_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_no": {
          "type": "integer"
        },
        "round_no": {
          "type": "integer"
        }
      },
      "required": [
        "role",
        "stage_id",
        "step_ref",
        "attempt_no",
        "round_no"
      ]
    },
    "RuntimeTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "context_window_tokens": {
          "type": "integer"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_source": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "config_mode": {
          "enum": [
            "isolated",
            "inherit"
          ]
        },
        "self_loads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
            }
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "self_loaded_instruction_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "runtime_id",
        "model",
        "context_window_tokens",
        "capabilities",
        "tools",
        "notes",
        "route_source",
        "operation",
        "config_mode",
