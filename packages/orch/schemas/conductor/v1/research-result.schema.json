{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:orch:conductor:research-result:v1",
  "title": "research-result",
  "description": "Closed result of the researcher role: the claims it found, each with the sources it rests on. A statement without a source belongs to unknowns, never to claims.",
  "type": "object",
  "properties": {
    "query": {
      "description": "The question that was researched.",
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "description": "Statements that a source supports.",
      "type": "array",
      "items": {
        "description": "One statement and the sources behind it.",
        "type": "object",
        "properties": {
          "text": {
            "description": "The statement.",
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "description": "URLs or repository paths the statement rests on; at least one.",
            "type": "array",
            "minItems": 1,
            "items": {
              "description": "URL or path.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "text",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "contradictions": {
      "description": "Places where sources disagree, one line each.",
      "type": "array",
      "items": {
        "description": "A disagreement between sources.",
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "description": "What could not be established or has no source, one line each.",
      "type": "array",
      "items": {
        "description": "Something unknown.",
        "type": "string",
        "minLength": 1
      }
    },
    "sources_used": {
      "description": "Ids of the configured research sources that were asked.",
      "type": "array",
      "items": {
        "description": "Source id of [orch.research.sources].",
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "query",
    "claims",
    "contradictions",
    "unknowns",
    "sources_used"
  ],
  "additionalProperties": false
}
