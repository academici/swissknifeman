usage: orch.py prepare [-h] --binding {cao,claude-only,native}
                       [--provider PROVIDER] --input INPUT --policy POLICY
                       --out OUT [--dry-run] [--routing ROUTING]
                       [--roles-dir ROLES_DIR]

options:
  -h, --help            show this help message and exit
  --binding {cao,claude-only,native}
  --provider PROVIDER
  --input INPUT
  --policy POLICY
  --out OUT             directory for prompts and profiles
  --dry-run
  --routing ROUTING     routing config holding the model mappings
  --roles-dir ROLES_DIR
