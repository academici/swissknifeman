        "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
      }
    },
    "row_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "plan_id",
    "lifecycle_state",
    "changed",
    "abandoned_draft_ids",
    "row_version"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.planning.generated.results",
      "class": "ArchivePlanResult",
      "kind": "dataclass"
    },
    "typescript": {
