{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:demo:command:echo-secret:v1",
  "title": "EchoSecret",
  "description": "Test-only command of the demo module: like Echo, with a secret field that is part of the request digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace_id", "text", "secret"],
  "properties": {
    "workspace_id": {"type": "string", "format": "uuid"},
    "text": {"type": "string", "minLength": 1, "maxLength": 200},
    "secret": {"type": "string", "minLength": 1, "maxLength": 200, "x-skm-secret": true}
  }
}
