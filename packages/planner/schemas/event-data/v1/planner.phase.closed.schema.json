{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:planner:event-data:planner-phase-closed:v1",
  "title": "planner.phase.closed",
  "description": "Data of the planner.phase.closed event. A phase was closed.",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Id of the plan the event belongs to.",
      "minLength": 1
    },
    "short_id": {
      "type": "string",
      "description": "Short id of the plan such as PLAN7.",
      "pattern": "^PLAN[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "description": "Title of the phase.",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "description": "Repository the plan belongs to.",
      "minLength": 1
    },
    "phase_id": {
      "type": "string",
      "description": "Id of the closed phase.",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "description": "Closure result of the phase.",
      "enum": [
        "done",
        "done_with_deviations",
        "blocked",
        "skipped"
      ]
    },
    "closed_at": {
      "type": "string",
      "description": "When the phase was closed (RFC 3339).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "summary": {
      "type": "string",
      "description": "One-line summary of the item statuses.",
      "minLength": 1
    }
  },
  "required": [
    "plan_id",
    "title",
    "phase_id",
    "result",
    "closed_at"
  ],
  "additionalProperties": false
}
