# agent-memory (Node-демон) — порты/URL узла. Скопируй в .env и поправь под себя.
# Эти значения переопределяют порт из config/memory/iii-config.yaml и .maind.json —
# задавай отдельные порты, чтобы не конфликтовать с другим узлом (например Brain).
AGENTMEMORY_PORT=4111
AGENTMEMORY_STREAM_PORT=4112
AGENTMEMORY_VIEWER_PORT=4113
AGENTMEMORY_URL=http://127.0.0.1:4111
AGENTMEMORY_III_CONFIG=config/memory/iii-config.yaml

# LLM — опционально. Включает сжатие/суммаризацию памяти.
# ANTHROPIC_API_KEY=
