usage: plan.py new [-h] [--plans-root PLANS_ROOT] --codename CODENAME --title
                   TITLE [--repository REPOSITORY] [--owner OWNER] --actor
                   ACTOR [--message MESSAGE | --message-file MESSAGE_FILE]
                   [--date DATE]

create a plan

options:
  -h, --help            show this help message and exit
  --plans-root PLANS_ROOT
                        plans/ directory (default: nearest up from cwd)
  --codename CODENAME   CODE-NAME [A-Z][A-Z0-9-]*
  --title TITLE
  --repository REPOSITORY
  --owner OWNER
  --actor ACTOR         PROVIDER/MODEL[/EFFORT]
  --message MESSAGE     first owner message, verbatim
  --message-file MESSAGE_FILE
  --date DATE           YYYY.MM.DD (default today)
