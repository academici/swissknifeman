{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:workspace:view:repository:v1",
  "title": "RepositoryView",
  "description": "workspace view contract from the owning specification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repository_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "title": {
      "type": "string"
    },
    "canonical_remote": {
      "anyOf": [
        {
          "$ref": "urn:skm:workspace:defs:v1#/$defs/normalized_remote"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "github",
        "gitlab",
        "bitbucket",
        "gitea",
        "other",
        "none"
      ]
    },
    "external_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "row_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
    }
  },
  "required": [
    "repository_id",
    "workspace_id",
    "title",
    "canonical_remote",
    "provider",
    "external_id",
    "row_version",
    "created_at"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.workspace.generated.views",
      "class": "RepositoryView",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "workspace.ts",
      "name": "RepositoryView"
    }
  }
}
