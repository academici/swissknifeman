    "co2/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n",
    "home/state/workspaces/axioma/bindings.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:workspace-bindings:v1\",\n  \"projects\": {\n    \"billium\": {\n      \"paths\": [\n        \"{tmp}/co1\",\n        \"{tmp}/co2\"\n      ],\n      \"primary\": \"{tmp}/co1\",\n      \"bound_at\": \"2026-10-17T09:30:00Z\"\n    }\n  }\n}\n"
   },
   "env": {
