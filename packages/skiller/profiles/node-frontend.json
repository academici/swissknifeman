{
  "name": "node-frontend",
  "description": "Vue/Vite frontend (SPA or Inertia): components, state, e2e tests",
  "buckets": ["system", "architect", "frontend", "quality", "devops"],
  "include_meta": false,
  "agent_pack": ["node-frontend", "_common"],
  "harness_presets": ["base", "node"],
  "mcp": ["context7", "playwright"],
  "model_tiers": {
    "reviewer": "opus",
    "spec-writer": "opus",
    "orchestrator": "opus",
    "component-builder": "sonnet",
    "slice-builder": "sonnet",
    "test-writer": "sonnet"
  }
}
