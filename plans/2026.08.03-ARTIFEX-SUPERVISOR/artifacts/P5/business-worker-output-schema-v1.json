{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://artifex.local/schemas/business-worker-output-v1.json",
  "title": "Artifex bounded business worker output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "refused"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 512
    }
  }
}
