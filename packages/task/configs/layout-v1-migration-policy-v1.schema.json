{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:task:layout-v1-migration-policy:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "generated_at",
    "inventory_sha256",
    "read_budget_contract",
    "rows"
  ],
  "properties": {
    "$schema": {
      "const": "urn:swissknifeman:task:layout-v1-migration-policy:v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "read_budget_contract": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "source_digest",
          "source_plan_sha256",
          "defect_class",
          "transform",
          "semantic_invariant",
          "rollback"
        ],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "defect_class": {
            "enum": [
              "routing-normalization",
              "current-state-import",
              "decision-id-map",
              "skeleton-preservation",
              "read-budget-carrier",
              "semantic-handoff",
              "already-v2-admission"
            ]
          },
          "transform": {"type": "string", "minLength": 1},
          "semantic_invariant": {"type": "string", "minLength": 1},
          "rollback": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
