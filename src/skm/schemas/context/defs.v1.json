{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:context:defs:v1",
  "title": "ContextDefinitions",
  "description": "context contract declarations; semantic rules belong to the context module.",
  "$defs": {
