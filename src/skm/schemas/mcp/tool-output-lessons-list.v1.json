{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-output:lessons-list:v1",
  "title": "skm_lessons_list output",
  "description": "Output for the skm_lessons_list MCP tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lesson_id": {
            "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        },
        "required": [
          "lesson_id",
          "title",
          "body",
          "confidence"
        ]
      }
    },
    "items_truncated": {
      "$ref": "urn:skm:mcp:tool-output-truncation-receipt:v1"
    }
  },
  "required": [
    "items"
  ]
}
