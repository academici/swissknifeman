// Source: anonymized production project
{
    "semi": true,
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 4,
    "htmlWhitespaceSensitivity": "css",

    "plugins": ["prettier-plugin-tailwindcss"],

    "tailwindFunctions": ["clsx", "cn", "cva", "tv"],

    "tailwindStylesheet": "resources/css/app.css",

    "overrides": [
        {
            "files": "**/*.yml",
            "options": { "tabWidth": 2 }
        }
    ]
}

// Explanation (in real .prettierrc do not leave comments - JSON doesn't allow them):
//
//   plugins: prettier-plugin-tailwindcss   — auto-sorting of classes in canonical
//                                            ok Tailwind every time it is formatted.
//   tailwindFunctions: [clsx, cn, cva, tv]  — functions whose string arguments are also plugin
//                                            counts and sorts as classes. Without this classes
//                                            inside cn(...) / cva(...) remain unsorted.
//   tailwindStylesheet: resources/css/app.css — for Tailwind v4 plugin needs path to CSS-login
//                                            (live there @theme-tokens), otherwise he doesn't know custom
//                                            utilities. B v3 indicated tailwindConfig: tailwind.config.js.
