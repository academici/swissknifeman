{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:task:plan:read-artifact:v1",
  "title": "Read Artifact",
  "type": "object",
  "description": "Declared artifact metadata and optional inline content.",
  "properties": {
    "ref": {
      "type": "string",
      "description": "Requested artifact reference.",
      "pattern": "^((?:[a-z0-9-]+:)?PLAN[0-9]+\\.)?(P[0-9]+(\\.[0-9]+(/U[0-9]+)?)?|D[0-9]+|knowledge/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?(#[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)?|artifact/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)$"
    },
    "path": {
      "type": "string",
      "description": "Declared plan or repository path.",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "description": "Declared artifact role.",
      "enum": [
        "input",
        "output"
      ]
    },
    "exists": {
      "type": "boolean",
      "description": "Whether the path is a regular file."
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 of the exact file bytes, or null when absent.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content": {
      "description": "Full JSON value for .json artifacts, otherwise UTF-8 text; omitted unless inline was requested and the file exists."
    }
  },
  "required": [
    "ref",
    "path",
    "role",
    "exists",
    "sha256"
  ],
  "additionalProperties": false
}
