{
  "name": "@swissknifeman/gui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SKM GUI frontend: one build for browser mode and the desktop shell.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "budget": "node scripts/check-budget.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "gen:types": "node scripts/gen-types.mjs",
    "check": "node scripts/gen-types.mjs --check && tsc --noEmit -p tsconfig.json && eslint . && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
