{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:gui:contribution:v1",
  "title": "contribution",
  "description": "GUI contribution (gui.json) of a hub unit or an external extension: routes, widgets, queries, commands, forms, configuration sections and docs it adds to the GUI. Rules beyond the schema (id prefixes, references, conflicts, paths inside the owner root) are checked by the gui resolver.",
  "type": "object",
  "required": ["$schema", "owner", "version", "gui_protocol"],
  "properties": {
    "$schema": {
      "const": "urn:swissknifeman:gui:contribution:v1",
      "description": "Contract id of this document."
    },
    "owner": {
      "$ref": "urn:swissknifeman:aicore:common:v1#/$defs/module_id",
      "description": "Id of the unit or extension that owns the file; equals the id of its unit.json or extension.json."
    },
    "version": {
      "$ref": "urn:swissknifeman:aicore:common:v1#/$defs/semver",
      "description": "Version of this contribution."
    },
    "gui_protocol": {
      "type": "object",
      "description": "Range of GUI host protocol versions the contribution works with; min <= max.",
      "required": ["min", "max"],
      "properties": {
        "min": {"$ref": "#/$defs/protocol_version", "description": "Lowest supported host protocol version."},
        "max": {"$ref": "#/$defs/protocol_version", "description": "Highest supported host protocol version."}
      },
      "additionalProperties": false
    },
    "requires_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Contracts the host must support for this contribution to be accepted.",
      "items": {
        "type": "object",
        "description": "One required contract.",
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^urn:swissknifeman:[a-z0-9-]+:[a-z0-9-]+(:[a-z0-9-]+)*$",
            "description": "Contract id without the version, such as urn:swissknifeman:gui:view-data."
          },
          "version": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$",
            "description": "Contract major version such as v1."
          }
        },
        "additionalProperties": false
      }
    },
    "handler": {
      "type": "object",
      "description": "The aicore extension that answers the gui:query and gui:command points; required when a query or an invoke command exists.",
      "required": ["extension"],
      "properties": {
        "extension": {
          "$ref": "urn:swissknifeman:aicore:common:v1#/$defs/relpath",
          "description": "Path of the extension.json (kind command) relative to the owner root."
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "description": "Pages the contribution adds under /x/<owner>/.",
      "items": {"$ref": "#/$defs/route", "description": "One route."}
    },
    "widgets": {
      "type": "array",
      "minItems": 1,
      "description": "Dashboard widgets.",
      "items": {"$ref": "#/$defs/widget", "description": "One widget."}
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "description": "Read-only queries answered through the gui:query point.",
      "items": {"$ref": "#/$defs/query", "description": "One query."}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "description": "Commands the host may run on behalf of the user.",
      "items": {"$ref": "#/$defs/command", "description": "One command."}
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "description": "UI annotations of canonical schemas, addressed by JSON pointer.",
      "items": {"$ref": "#/$defs/form", "description": "One form."}
    },
    "config_sections": {
      "type": "array",
      "minItems": 1,
      "description": "Configuration sections of modules shown in the settings screen.",
      "items": {"$ref": "#/$defs/config_section", "description": "One configuration section."}
    },
    "docs": {
      "type": "array",
      "minItems": 1,
      "description": "Documentation trees rendered as markdown routes.",
      "items": {"$ref": "#/$defs/docs", "description": "One documentation tree."}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "description": "GUI host protocol version: a positive integer as a string."
    },
    "local_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "description": "Id of a route, widget, query, command, form, configuration section or docs tree: <owner>.<name>[.<name>...]."
    },
    "field_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Name of an input or parameter field."
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Name of an icon from the host icon set."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Text shown to the user; rendered as text, never as HTML."
    },
    "view": {
      "enum": ["resource-list", "resource-detail", "schema-form", "metric-group", "status-table", "timeline", "log-stream",
               "markdown", "dependency-graph", "board", "command-form"],
      "description": "Host view that renders the data; the data of a query follows the same kind of view-data/v1."
    },
    "scope": {
      "enum": ["fleet", "project", "plan", "item", "run"],
      "description": "Context the host must pass: the fleet, a project, a plan, a plan item or a run."
    },
    "scalar": {
      "type": ["string", "number", "boolean"],
      "description": "A scalar value."
    },
    "route": {
      "type": "object",
      "description": "A page of the contribution.",
      "required": ["id", "title", "path", "view", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id", "description": "Route id."},
        "title": {"$ref": "#/$defs/title", "description": "Page title."},
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(/(:[a-z][a-z0-9_]*|[a-z0-9-]+))*$",
          "description": "Path relative to /x/<owner>/; segments are literals or :name parameters that the query params declare."
        },
        "view": {"$ref": "#/$defs/view", "description": "Host view of the page."},
        "scope": {"$ref": "#/$defs/scope", "description": "Context of the page."},
        "query": {"$ref": "#/$defs/local_id", "description": "Query that fills the page; required for every view except command-form and markdown with docs."},
        "command": {"$ref": "#/$defs/local_id", "description": "Command of a command-form page."},
        "docs": {"$ref": "#/$defs/local_id", "description": "Docs tree of a markdown page."},
        "nav": {
          "type": "object",
          "description": "Place of the page in the navigation; absent means the page is reached only by links.",
          "required": ["section"],
          "properties": {
            "section": {"enum": ["fleet", "project", "plan", "settings", "plugins"], "description": "Navigation section."},
            "order": {"type": "integer", "minimum": 0, "maximum": 1000, "description": "Order inside the section (lower first)."},
            "icon": {"$ref": "#/$defs/icon", "description": "Navigation icon."}
          },
          "additionalProperties": false
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Commands offered on the page.",
          "items": {"$ref": "#/$defs/local_id", "description": "Command id."}
        }
      },
      "additionalProperties": false
    },
    "widget": {
      "type": "object",
      "description": "A dashboard widget filled by a query.",
      "required": ["id", "title", "view", "query", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id", "description": "Widget id."},
        "title": {"$ref": "#/$defs/title", "description": "Widget title."},
        "view": {"enum": ["metric-group", "status-table", "timeline", "resource-list"], "description": "Host view of the widget."},
        "query": {"$ref": "#/$defs/local_id", "description": "Query that fills the widget."},
        "scope": {"enum": ["fleet", "project"], "description": "Dashboard the widget belongs to."},
        "size": {"enum": ["small", "medium", "large"], "default": "medium", "description": "Size of the widget."}
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "description": "A typed input or parameter field. For argv: a boolean with a flag adds only the flag when true; another value with a flag adds the flag, then the value as its own element; without a flag the value is positional.",
      "required": ["name", "title", "type", "required"],
      "properties": {
        "name": {"$ref": "#/$defs/field_name", "description": "Field name."},
        "title": {"$ref": "#/$defs/title", "description": "Field label."},
        "description": {"type": "string", "minLength": 1, "description": "Help text of the field."},
        "type": {
          "enum": ["string", "integer", "number", "boolean", "enum", "project-path", "plan-ref", "item-ref", "model-ref", "secret-ref"],
          "description": "Value type; reference types are checked by the host (project-path stays inside the project after realpath)."
        },
        "required": {"type": "boolean", "description": "Whether a value must be given."},
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Allowed values of an enum field.",
          "items": {"type": "string", "minLength": 1, "description": "One allowed value."}
        },
        "pattern": {"type": "string", "minLength": 1, "description": "Regular expression a string value must match."},
        "minimum": {"type": "number", "description": "Lowest numeric value."},
        "maximum": {"type": "number", "description": "Highest numeric value."},
        "default": {"$ref": "#/$defs/scalar", "description": "Value used when none is given."},
        "flag": {
          "type": "string",
          "pattern": "^--[a-z][a-z0-9-]*$",
          "description": "Long option that carries the value in argv; flags are appended after the argv parts in input order."
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "description": "A read-only query; always executed through the gui:query point of the handler.",
      "required": ["id", "title", "scope", "returns"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id", "description": "Query id."},
        "title": {"$ref": "#/$defs/title", "description": "Query title."},
        "description": {"type": "string", "minLength": 1, "description": "What the query returns."},
        "scope": {"$ref": "#/$defs/scope", "description": "Context of the query."},
        "params": {
          "type": "array",
          "minItems": 1,
          "description": "Parameters of the query.",
          "items": {"$ref": "#/$defs/field", "description": "One parameter."}
        },
        "returns": {"$ref": "#/$defs/view", "description": "Kind of view-data/v1 the query answers."},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 120, "default": 30, "description": "Deadline of one answer in seconds."},
        "cache_s": {"type": "integer", "minimum": 0, "maximum": 3600, "default": 0, "description": "How long the host may reuse an answer, in seconds."}
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "description": "A command the host runs after authorization; its argv is built only from literals and typed input values.",
      "required": ["id", "title", "scope", "effects", "risk", "confirmation", "timeout_s", "exec"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id", "description": "Command id."},
        "title": {"$ref": "#/$defs/title", "description": "Command title."},
        "description": {"type": "string", "minLength": 1, "description": "What the command does."},
        "scope": {"$ref": "#/$defs/scope", "description": "Context of the command."},
        "input": {
          "type": "array",
          "minItems": 1,
          "description": "Typed input fields.",
          "items": {"$ref": "#/$defs/field", "description": "One input field."}
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Effects the command may have; the host authorizes each.",
          "items": {
            "enum": ["read", "project.write", "plan.write", "config.write", "process.spawn", "network", "secrets.read", "terminal"],
            "description": "One effect; terminal is reserved and refused in v1."
          }
        },
        "risk": {"enum": ["low", "medium", "high"], "description": "Risk class of the command."},
        "confirmation": {"enum": ["none", "risk-based", "always"], "description": "When the user must confirm the run."},
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Optional abilities; dry-run needs dry_run, stream and cancel need an argv exec.",
          "items": {"enum": ["dry-run", "cancel", "stream"], "description": "One ability."}
        },
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 86400, "description": "Deadline of the run in seconds."},
        "concurrency_key": {
          "type": "string",
          "pattern": "^[a-z0-9:._{}-]+$",
          "description": "Runs with the same key do not overlap; placeholders {project_id}, {plan_id}, {item_id} only."
        },
        "exec": {
          "description": "How the command runs.",
          "oneOf": [
            {"$ref": "#/$defs/exec_invoke", "description": "Through the gui:command point of the handler."},
            {"$ref": "#/$defs/exec_argv", "description": "As an argv array without a shell."}
          ]
        },
        "dry_run": {
          "description": "How a dry run is requested.",
          "oneOf": [
            {
              "type": "object",
              "description": "Literal arguments appended to argv for a dry run.",
              "required": ["argv_append"],
              "properties": {
                "argv_append": {
                  "type": "array",
                  "minItems": 1,
                  "description": "Arguments appended at the end.",
                  "items": {"type": "string", "minLength": 1, "description": "One literal argument."}
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "A boolean input field that the host sets to true for a dry run.",
              "required": ["input"],
              "properties": {
                "input": {"$ref": "#/$defs/field_name", "description": "Name of the boolean input field."}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "exec_invoke": {
      "type": "object",
      "description": "Execution through the aicore plugin protocol (one process per call).",
      "required": ["kind"],
      "properties": {
        "kind": {"const": "invoke", "description": "Execution kind."}
      },
      "additionalProperties": false
    },
    "exec_argv": {
      "type": "object",
      "description": "Execution as an argv array without a shell; argv[0] is a literal path inside the owner root.",
      "required": ["kind", "argv", "cwd"],
      "properties": {
        "kind": {"const": "argv", "description": "Execution kind."},
        "argv": {
          "type": "array",
          "minItems": 1,
          "description": "Argument vector; each element is a literal or exactly one input value, never joined with other text.",
          "items": {"$ref": "#/$defs/argv_part", "description": "One argv element."}
        },
        "cwd": {"enum": ["project", "owner"], "description": "Working folder: the trusted project root or the owner root."},
        "env": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Environment variables passed through on top of the clean environment.",
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "Variable name."}
        }
      },
      "additionalProperties": false
    },
    "argv_part": {
      "description": "One argv element: a literal string or one input value.",
      "oneOf": [
        {"type": "string", "minLength": 1, "description": "A literal argument."},
        {
          "type": "object",
          "description": "The value of one input field as a whole element.",
          "required": ["input"],
          "properties": {
            "input": {"$ref": "#/$defs/field_name", "description": "Name of a declared input field without a flag."}
          },
          "additionalProperties": false
        }
      ]
    },
    "form": {
      "type": "object",
      "description": "UI annotations of a canonical schema; the canonical schema itself does not change.",
      "required": ["id", "schema", "fields"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id", "description": "Form id."},
        "schema": {
          "type": "string",
          "pattern": "^urn:swissknifeman:[a-z0-9:-]+(#(/[A-Za-z0-9_$-]+)*)?$",
          "description": "Canonical schema the form edits, optionally with a pointer into it."
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "description": "Groups of fields.",
          "items": {
            "type": "object",
            "description": "One group.",
            "required": ["id", "title"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Group id inside the form."},
              "title": {"$ref": "#/$defs/title", "description": "Group title."},
              "order": {"type": "integer", "minimum": 0, "maximum": 1000, "description": "Order of the group (lower first)."}
            },
            "additionalProperties": false
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "description": "Annotations of fields of the schema.",
          "items": {
            "type": "object",
            "description": "Annotation of one field.",
            "required": ["pointer"],
            "properties": {
              "pointer": {"type": "string", "pattern": "^(/[A-Za-z0-9_.$-]+)*$", "description": "JSON pointer of the field in the document."},
              "group": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Group id."},
              "order": {"type": "integer", "minimum": 0, "maximum": 1000, "description": "Order inside the group (lower first)."},
              "widget": {
                "enum": ["text", "textarea", "number", "toggle", "select", "model-picker", "path-picker", "secret-ref", "list", "map", "json"],
                "description": "Widget that edits the field."
              },
              "readonly": {"type": "boolean", "description": "Shown but not editable; UX only, the owner refuses the write."},
              "hidden": {"type": "boolean", "description": "Not shown."},
              "confirm": {"type": "boolean", "description": "A change of the field needs an explicit confirmation."}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "config_section": {
      "type": "object",
      "description": "A configuration section of a module in the settings screen.",
      "required": ["id", "module", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id", "description": "Section id."},
        "module": {"$ref": "urn:swissknifeman:aicore:common:v1#/$defs/module_id", "description": "Module whose configuration the section edits."},
        "title": {"$ref": "#/$defs/title", "description": "Section title."},
        "form": {"$ref": "#/$defs/local_id", "description": "Form that annotates the section."}
      },
      "additionalProperties": false
    },
    "docs": {
      "type": "object",
      "description": "A documentation tree inside the owner root.",
      "required": ["id", "title", "root", "index"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id", "description": "Docs id."},
        "title": {"$ref": "#/$defs/title", "description": "Docs title."},
        "root": {"$ref": "urn:swissknifeman:aicore:common:v1#/$defs/relpath", "description": "Folder of the tree relative to the owner root."},
        "index": {"$ref": "urn:swissknifeman:aicore:common:v1#/$defs/relpath", "description": "First page relative to the tree folder."}
      },
      "additionalProperties": false
    }
  }
}
