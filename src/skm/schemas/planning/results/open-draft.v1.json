{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:planning:result:open-draft:v1",
  "title": "OpenDraftResult",
  "description": "planning owner contract; see the planning module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "draft_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "plan_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "base_revision_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "edit_version": {
      "type": "integer",
      "minimum": 1
    },
    "document_digest": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/digest"
    }
  },
  "required": [
    "draft_id",
    "plan_id",
    "base_revision_id",
    "edit_version",
    "document_digest"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.planning.generated.results",
      "class": "OpenDraftResult",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "planning.ts",
      "name": "OpenDraftResult"
    }
  }
}
