{
  "$schema": "urn:swissknifeman:authoring-carrier-matrix:v1",
  "contract_version": "1.0.0",
  "source_language": "en",
  "overlay_locales": ["ru"],
  "rows": [
    {
      "carrier_id": "code.comments",
      "pattern": "**/*.{py,sh,js,ts,php}:comments",
      "class": "english-only",
      "canonical_owner": "owning package source",
      "localization": "forbidden",
      "overlay_namespace": null,
      "generated_owner": null,
      "migration_admission": "owner+preimage+review+rollback",
      "rollback": "restore exact source preimage"
    },
    {
      "carrier_id": "code.docstrings",
      "pattern": "**/*.{py,js,ts,php}:internal-docstrings",
      "class": "english-only",
      "canonical_owner": "owning package source",
      "localization": "forbidden",
      "overlay_namespace": null,
      "generated_owner": null,
      "migration_admission": "owner+preimage+review+rollback",
      "rollback": "restore exact source preimage"
    },
    {
      "carrier_id": "development.docs",
      "pattern": "docs/**|packages/*/docs/**|README.md|CONTRIBUTING.md",
      "class": "english-only",
      "canonical_owner": "documentation source",
      "localization": "forbidden",
      "overlay_namespace": null,
      "generated_owner": "declared docs generator when marked generated",
      "migration_admission": "owner+preimage+review+generated-owner+rollback",
      "rollback": "restore source and regenerated target preimages"
    },
    {
      "carrier_id": "diagnostic.message",
      "pattern": "provider-neutral diagnostic message catalogs",
      "class": "render-resource",
      "canonical_owner": "diagnostic contract owner",
      "localization": "sparse-overlay",
      "overlay_namespace": "diagnostic.<package>.<code>.message",
      "generated_owner": "diagnostic renderer",
      "migration_admission": "owner+preimage+semantic-review+rollback",
      "rollback": "restore catalog preimage"
    },
    {
      "carrier_id": "generated.provider-target",
      "pattern": ".claude/**|.agents/**|**/.claude-plugin/**|**/.codex-plugin/**|*lock*.json",
      "class": "generated-target",
      "canonical_owner": "none; derived only",
      "localization": "renderer-only",
      "overlay_namespace": null,
      "generated_owner": "declared provider adapter/generator",
      "migration_admission": "regenerate-only+exact-target-preimage+rollback",
      "rollback": "restore exact provider-qualified target preimages"
    },
    {
      "carrier_id": "legacy.skill-ru",
      "pattern": "packages/skiller/skills/**/SKILL.ru.md",
      "class": "legacy-input",
      "canonical_owner": "unresolved until P4 admission",
      "localization": "input-only",
      "overlay_namespace": null,
      "generated_owner": null,
      "migration_admission": "owner+source-preimage+equivalence+generated-owner+rollback",
      "rollback": "preserve or restore exact legacy preimage"
    },
    {
      "carrier_id": "machine.identity",
      "pattern": "IDs|paths|commands|schema keys|placeholders|parser literals|codes|URLs|provenance",
      "class": "machine-identity",
      "canonical_owner": "owning contract/schema/source",
      "localization": "immutable-token",
      "overlay_namespace": null,
      "generated_owner": null,
      "migration_admission": "byte-parity+owner+preimage+rollback",
      "rollback": "restore exact owning source preimage"
    },
    {
      "carrier_id": "plan.human-text",
      "pattern": "plans/**:human-renderable prose",
      "class": "render-resource",
      "canonical_owner": "plan semantic source",
      "localization": "sparse-overlay",
      "overlay_namespace": "plan.<plan_id>.<section_id>",
      "generated_owner": "plan renderer for generated views",
      "migration_admission": "owner+preimage+semantic-review+generated-owner+rollback",
      "rollback": "restore source and generated view preimages"
    },
    {
      "carrier_id": "plugin.human-metadata",
      "pattern": "canonical plugin name/description/category/tag metadata",
      "class": "semantic-source",
      "canonical_owner": "owning package metadata",
      "localization": "sparse-overlay",
      "overlay_namespace": "plugin.<plugin_id>.<field>",
      "generated_owner": "publication generator",
      "migration_admission": "owner+preimage+semantic-review+generated-owner+rollback",
      "rollback": "restore metadata and regenerated manifest preimages"
    },
    {
      "carrier_id": "provider.human-message",
      "pattern": "provider adapter user-facing messages",
      "class": "render-resource",
      "canonical_owner": "provider-neutral message catalog",
      "localization": "sparse-overlay",
      "overlay_namespace": "message.<package>.<message_id>",
      "generated_owner": "owning provider adapter",
      "migration_admission": "owner+preimage+semantic-review+generated-owner+rollback",
      "rollback": "restore catalog and provider target preimages"
    },
    {
      "carrier_id": "semantic.command",
      "pattern": "packages/task/commands/*.md",
      "class": "semantic-source",
      "canonical_owner": "task command catalog",
      "localization": "sparse-overlay",
      "overlay_namespace": "command.<command_id>.<section_id>",
      "generated_owner": "task provider command renderer",
      "migration_admission": "owner+preimage+semantic-review+generated-owner+rollback",
      "rollback": "restore command and provider projection preimages"
    },
    {
      "carrier_id": "semantic.skill",
      "pattern": "packages/skiller/skills/**/SKILL.md",
      "class": "semantic-source",
      "canonical_owner": "skiller skill registry",
      "localization": "sparse-overlay",
      "overlay_namespace": "skill.<semantic_id>.<section_id>",
      "generated_owner": "skiller publication generator",
      "migration_admission": "owner+preimage+semantic-review+generated-owner+rollback",
      "rollback": "restore skill, overlay, registry, and provider target preimages"
    }
  ]
}
