    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author_name": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1,
          "default": "SKM Worker",
          "description": "Author and committer name of commits made by SKM.",
          "x-skm": {
            "chain": "host",
            "levels": ["instance", "host"],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": false,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "ui": {"group": "Git", "order": 10, "widget": "text"}
