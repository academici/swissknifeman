{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-input:plan-publication-preview:v1",
  "title": "skm_plan_publication_preview input",
  "description": "Input for the skm_plan_publication_preview MCP tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan": {
      "type": "string",
      "minLength": 1
    },
    "draft_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "expected_edit_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "plan",
    "draft_id",
    "expected_edit_version"
  ]
}
