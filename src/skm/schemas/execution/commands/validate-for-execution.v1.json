{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:execution:command:validate-for-execution:v1",
  "title": "ValidateForExecution",
  "description": "execution contract declarations; semantic rules belong to the execution module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
