      "otherwise": "ILLEGAL_TRANSITION"
    },
    "OBSERVED": {
      "on": {
        "validation_green": "ACCEPTED",
        "validation_red": "ROLLED_BACK",
        "reconcile_preimage": "ROLLED_BACK",
        "reconcile_postimage": "VALIDATING",
        "reconcile_partial": "ROLLED_BACK",
        "reconcile_third_state": "INCIDENT",
        "source_drift": "INCIDENT",
        "journal_invalid": "INCIDENT",
        "owner_decision_abort": "ABORTED"
      },
      "otherwise": "ILLEGAL_TRANSITION"
    },
    "VALIDATING": {
      "on": {
        "validation_green": "ACCEPTED",
        "validation_red": "ROLLED_BACK",
        "source_drift": "INCIDENT",
        "journal_invalid": "INCIDENT",
        "owner_decision_abort": "ABORTED"
      },
      "otherwise": "ILLEGAL_TRANSITION"
    },
    "ACCEPTED": {
      "on": {
        "dispatch_ready": "READY",
        "source_drift": "INCIDENT",
        "journal_invalid": "INCIDENT",
        "finish_run": "COMPLETED"
      },
      "otherwise": "ILLEGAL_TRANSITION"
    },
    "ROLLED_BACK": {
      "on": {
        "dispatch_ready": "READY",
        "budget_exhausted": "BUDGET_EXHAUSTED",
        "journal_invalid": "INCIDENT",
        "owner_decision_abort": "ABORTED"
      },
      "otherwise": "ILLEGAL_TRANSITION"
    },
    "OWNER_ATTENTION": {
      "on": {
        "owner_decision_continue": "READY",
        "owner_decision_abort": "ABORTED",
        "journal_invalid": "INCIDENT"
      },
      "otherwise": "OWNER_DECISION_REQUIRED"
    },
    "PROVIDER_UNAVAILABLE": {
      "on": {
        "owner_decision_continue": "READY",
        "owner_decision_abort": "ABORTED",
        "budget_exhausted": "BUDGET_EXHAUSTED",
        "journal_invalid": "INCIDENT"
      },
      "otherwise": "OWNER_DECISION_REQUIRED"
    },
    "BUDGET_EXHAUSTED": {
      "on": {
        "owner_decision_continue": "READY",
        "owner_decision_abort": "ABORTED",
        "journal_invalid": "INCIDENT"
      },
      "otherwise": "BUDGET_LIMIT"
    },
    "INCIDENT": {
      "on": {
        "owner_decision_continue": "READY",
        "owner_decision_abort": "ABORTED"
      },
      "otherwise": "OWNER_DECISION_REQUIRED"
    },
    "COMPLETED": {
      "on": {},
      "otherwise": "ILLEGAL_TRANSITION"
    },
    "ABORTED": {
      "on": {},
      "otherwise": "ILLEGAL_TRANSITION"
    }
