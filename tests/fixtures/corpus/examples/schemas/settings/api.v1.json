            "chain": "work",
            "levels": [
              "instance"
            ],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": false,
            "confirm": false,
            "ui": {
              "group": "Limits",
              "order": 40,
              "widget": "number"
            }
          }
        },
        "max_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 500,
