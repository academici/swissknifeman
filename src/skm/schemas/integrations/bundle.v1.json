{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:integrations:bundle:v1",
  "title": "IntegrationBundleManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:skm:integrations:bundle:v1"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude_code",
          "codex",
          "antigravity",
          "cursor",
          "gemini_cli",
          "grok"
        ]
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
          }
        },
        "required": [
          "key",
          "profile"
        ]
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key"
        ]
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "enum": [
              "claude_code",
              "codex",
              "antigravity",
              "cursor",
              "gemini_cli",
              "grok"
            ]
          },
          "surface": {
            "enum": [
              "instructions",
              "agents",
              "rules",
              "workflows"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^:]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^:]+$"
          },
          "ownership": {
            "enum": [
              "managed_file",
              "managed_block"
            ]
          },
          "block_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,80}$"
          }
        },
        "required": [
          "target",
          "surface",
          "source",
          "path",
          "ownership"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "ownership": {
                  "const": "managed_block"
                }
              }
            },
            "then": {
              "required": [
                "block_id"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "block_id"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "key",
    "version",
    "title",
    "description",
    "targets",
    "agents",
    "skills",
    "assets"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.integrations.generated.documents",
      "class": "IntegrationBundleManifest",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "integrations.ts",
      "name": "IntegrationBundleManifest"
    }
  }
}
