{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:orch:event-data:orch-run-waiting:v1",
  "title": "orch.run.waiting",
  "description": "The piece waits for the owner.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the run."
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the piece of work (the input id of the work source)."
    },
    "item": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Reference of the piece of work in its plan."
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "QUESTION"
      ],
      "description": "What the run waits for."
    },
    "step": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Step that raised the wait."
    },
    "question_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
        "description": "Id of a blocking question."
      },
      "minItems": 1,
      "description": "Blocking questions that wait."
    }
  },
  "required": [
    "run_id",
    "work_id",
    "reason_code"
  ],
  "additionalProperties": false
}
