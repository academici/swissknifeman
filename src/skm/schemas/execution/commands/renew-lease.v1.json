        },
        "last_runtime_event_at": {
          "type": "string",
          "format": "date-time"
        },
        "cpu_active": {
          "type": "boolean"
        },
        "repeated_command_count": {
          "type": "integer",
          "minimum": 0
        },
        "tool_running": {
          "type": "string"
        },
        "process": {
          "$ref": "urn:skm:execution:defs:v1#/$defs/process-identity"
        },
        "worktree_dirty": {
          "type": "boolean"
        },
        "snapshot": {
          "$ref": "urn:skm:execution:defs:v1#/$defs/staged-file"
