usage: plan.py context [-h] [--plans-root PLANS_ROOT] [--stdout] [--budget]
                       [--json] [--repo NAME=PATH]
                       plan item

return complete JSON context (context/<item>.json)

positional arguments:
  plan                  plan id, PLAN<N> or path
  item

options:
  -h, --help            show this help message and exit
  --plans-root PLANS_ROOT
                        plans/ directory (default: nearest up from cwd)
  --stdout              print the pack instead of writing it
  --budget              report the pack size by key and source; writes nothing
  --json                with --budget: print the report as JSON
  --repo NAME=PATH      repository root of references to another repository
                        (repeatable)
