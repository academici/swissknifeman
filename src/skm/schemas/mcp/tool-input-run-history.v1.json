{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-input:run-history:v1",
  "title": "skm_run_history input",
  "description": "Input for the skm_run_history MCP tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string"
    },
    "after": {
      "type": "string"
    },
    "through_seq": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": [
    "run"
  ]
}
