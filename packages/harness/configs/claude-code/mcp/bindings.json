{
  "binding_version": "1.0.0",
  "provider_id": "claude-code",
  "target_scope": "project",
  "target_path": ".mcp.json",
  "servers": {
    "context7": {"type": "http", "url": "https://mcp.context7.com/mcp"},
    "fetch": {"command": "uvx", "args": ["mcp-server-fetch"]},
    "filesystem": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]},
    "github": {"type": "http", "url": "https://api.githubcopilot.com/mcp/"},
    "memory": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-memory"]},
    "perplexity": {"command": "npx", "args": ["-y", "@perplexity-ai/mcp-server"], "env": {"PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"}},
    "playwright": {"command": "npx", "args": ["@playwright/mcp@0.0.78", "--headless", "--output-dir", ".playwright-mcp"]},
    "sequential-thinking": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]}
  }
}
