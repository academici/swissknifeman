{
  "$schema": "urn:swissknifeman:aicore:extension:v1",
  "id": "ext-demo",
  "kind": "command",
  "version": "0.1.0",
  "description": "Sample external extension with a GUI contribution: a list, a flaky query, a slow streamed command and a note command. Writes nothing to disk.",
  "protocol": {"min": "1", "max": "1"},
  "entrypoint": ["python3", "handler/handler.py"],
  "provides": {"points": ["gui:query", "gui:command"], "gui": "gui.json"},
  "timeout_seconds": 30,
  "example_input": {"id": "ext-demo.items", "context": {}, "params": {}}
}
