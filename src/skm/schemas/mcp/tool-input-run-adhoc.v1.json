{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-input:run-adhoc:v1",
  "title": "skm_run_adhoc input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "workflow": {
      "$ref": "urn:skm:execution:workflow:v1",
      "description": "A closed-stage workflow to pin for this run."
    },
    "work_kind": {
      "$ref": "urn:skm:execution:workflow:v1#/$defs/work_kind"
    }
  },
  "required": [
    "prompt"
  ]
}
