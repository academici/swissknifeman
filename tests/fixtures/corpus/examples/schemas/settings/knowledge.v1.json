{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:settings:knowledge:v1",
  "title": "Knowledge settings",
  "description": "Settings section 'knowledge' owned by knowledge. Every leaf carries x-skm metadata read by the settings registry.",
  "type": "object",
  "additionalProperties": false,
  "x-skm-section": {
    "id": "knowledge",
    "owner": "knowledge",
    "title": "Knowledge",
    "validators": [
      {
        "id": "knowledge.ttl_order",
        "keys": [
          "knowledge.memory.default_ttl_hours",
          "knowledge.memory.max_ttl_hours"
        ],
        "rule": "default_ttl_hours <= max_ttl_hours"
      }
    ]
  },
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.knowledge.generated.settings",
      "class": "KnowledgeSettings",
      "kind": "settings_view"
    },
    "typescript": {
      "file": "settings.ts",
      "name": "KnowledgeSettings"
    }
  },
  "properties": {
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_ttl_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72,
          "default": 48,
          "description": "Lifetime of a memory entry when remember names none.",
          "x-skm": {
            "chain": "work",
            "levels": [
              "instance",
              "workspace",
              "project"
            ],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "validators": [
              "knowledge.ttl_order"
            ],
            "ui": {
              "group": "Memory",
              "order": 10,
              "widget": "number"
            }
          }
        },
        "max_ttl_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72,
          "default": 72,
          "description": "Longest lifetime of a memory entry.",
          "x-skm": {
            "chain": "work",
            "levels": [
              "instance"
            ],
            "merge": "narrow",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "validators": [
              "knowledge.ttl_order"
            ],
            "narrow": {
              "direction": "min"
            },
            "ui": {
              "group": "Memory",
              "order": 20,
              "widget": "number"
            }
          }
        },
        "max_chars": {
          "type": "integer",
          "minimum": 50,
          "maximum": 2000,
          "default": 800,
          "description": "Largest body of a memory entry.",
          "x-skm": {
            "chain": "work",
            "levels": [
              "instance"
            ],
            "merge": "narrow",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "narrow": {
              "direction": "min"
            },
            "ui": {
              "group": "Memory",
              "order": 30,
              "widget": "number"
            }
          }
        },
        "max_live_per_scope": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 8,
          "description": "Live (unexpired) entries per scope; remember beyond it fails MEMORY_LIMIT_REACHED.",
          "x-skm": {
            "chain": "work",
            "levels": [
              "instance",
              "workspace",
              "project"
            ],
            "merge": "narrow",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "narrow": {
              "direction": "min"
