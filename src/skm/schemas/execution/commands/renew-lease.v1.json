      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^\\u0000]+$"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^\\u0000]+$"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
