{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:planning:view:plan-summary:v1",
  "title": "PlanSummaryView",
  "description": "planning owner contract; see the planning module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "alias": {
      "type": "string",
      "minLength": 0
    },
    "title": {
      "type": "string",
      "minLength": 0
    },
    "purpose": {
      "type": "string",
      "enum": [
        "standard",
        "review_requests"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "current_revision_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_revision_no": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "open_drafts": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
    }
  },
  "required": [
    "plan_id",
    "alias",
    "title",
    "purpose",
    "lifecycle_state",
    "current_revision_id",
    "current_revision_no",
    "open_drafts",
    "updated_at"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.planning.generated.views",
      "class": "PlanSummaryView",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "planning.ts",
      "name": "PlanSummaryView"
    }
  }
}
