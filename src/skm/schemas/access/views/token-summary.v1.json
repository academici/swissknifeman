{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:access:view:token-summary:v1",
  "title": "TokenSummaryView",
  "description": "access view contract from the owning specification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "kind": {
      "$ref": "urn:skm:access:defs:v1#/$defs/token_kind"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "prefix": {
      "type": "string",
      "pattern": "^(live_)?[a-z2-7]{8}$"
    },
    "scope_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "permissions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "urn:skm:access:defs:v1#/$defs/permission"
          },
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_used_at": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "assignment_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "step_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_grants": {
      "anyOf": [
