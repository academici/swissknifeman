{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/final-admission-event-v1.schema.json",
  "schema_version": "final-admission-event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ts", "identity", "final_allowed", "reason", "continuation", "recovery", "sequence"],
  "properties": {
    "schema_version": {"const": "final-admission-event/v1"},
    "ts": {"type": "string"},
    "identity": {"type": "object"},
    "final_allowed": {"type": "boolean"},
    "reason": {"type": "string"},
    "continuation": {"type": ["string", "null"]},
    "recovery": {"type": ["string", "null"]},
    "sequence": {"type": ["integer", "null"]},
    "expected_message_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_message_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
