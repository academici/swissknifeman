{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:knowledge:query:search-memory:v1",
  "title": "SearchMemory",
  "description": "knowledge contract; semantics: the knowledge module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "query": {
      "type": "string"
    },
    "include_shared": {
      "type": "boolean",
      "default": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "urn:skm:knowledge:defs:v1#/$defs/MemoryScopeKind"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "required": [
    "project_id"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.knowledge.generated.queries",
      "class": "SearchMemory",
      "kind": "typeddict"
    },
    "typescript": {
      "file": "knowledge.ts",
      "name": "SearchMemory"
    }
  }
}
