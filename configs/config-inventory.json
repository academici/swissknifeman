{
  "schema_version": 1,
  "_doc": "Every config has one owner and at least one consumer. Checked by scripts/test-config-inventory.py (CI hygiene). Decisions: plan PLAN2 knowledge configs-p11.",
  "scope": [
    "configs/*.json",
    ".codex/config.toml.example",
    ".grok/config.toml.example",
    "packages/*/configs/*.json",
    "bridges/*/*.json",
    "packages/harness/configs/**/*.json",
    "packages/skiller/budget-configs/*.json",
    "packages/skiller/schema/*.json",
    "packages/skiller/.swissknifeman.example/*.json"
  ],
  "entries": [
    {
      "path": "packages/analyst/configs/config.schema.json",
      "owner": "analyst",
      "consumers": [
        "packages/analyst/lib/analyst/settings.py",
        "packages/aicore/lib/aicore/config/model.py",
        "packages/aicore/lib/aicore/config/example.py",
        "scripts/ecosystem-units.py"
      ],
      "released": false,
      "note": "analyst thresholds, schema defaults and generated config.example.toml"
    },
    {
      "path": "packages/harness/configs/config.schema.json",
      "owner": "harness",
      "consumers": [
