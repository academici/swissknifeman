{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:orch:event-data:orch-input-rebuilt:v1",
  "title": "orch.input.rebuilt",
  "description": "The plan changed during the piece and a new input replaced the old one.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the run."
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the piece of work (the input id of the work source)."
    },
    "item": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Reference of the piece of work in its plan."
    },
    "previous_digest": {
      "type": "string",
      "minLength": 1,
      "description": "Digest of the replaced input."
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "description": "Digest of the new input."
    }
  },
  "required": [
    "run_id",
    "work_id",
    "digest"
  ],
  "additionalProperties": false
}
