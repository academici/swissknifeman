{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/audit-impact-v1.schema.json",
  "title": "Task audit impact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification", "affected_items", "affected_edges", "reasons", "continuation"],
  "properties": {
    "schema_version": {"const": "audit-impact/v1"},
    "classification": {"enum": ["unrelated-worktree", "audit-bookkeeping", "local-material", "wide-material", "unclassifiable"]},
    "affected_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"}},
    "affected_edges": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "continuation": {"enum": ["gate-rebind", "delta", "full", "gather-evidence", "owner-review"]}
  }
}
