{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:provider-health-release-membership:v1",
  "title": "Provider health release-membership",
  "description": "Plan-local, sealed release-admission membership. It supplements but never alters provider-health exact-set evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "membership_id", "project_memberships", "authority", "seal"],
  "properties": {
    "schema_version": {"const": "provider-health-release-membership/v1"},
    "contract_version": {"const": "1.0.0"},
    "membership_id": {"$ref": "#/$defs/safeId"},
    "project_memberships": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/membership"}
    },
    "authority": {"$ref": "#/$defs/authority"},
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    }
  },
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "projectId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "membership", "authority_ref"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "membership": {"enum": ["required", "optional"]},
        "authority_ref": {"$ref": "#/$defs/safeId"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "action_digest", "response_digest", "optional_identity_source_sha256"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/safeId"},
        "action_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "response_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "optional_identity_source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "x-semantic-constraints": [
    "project_memberships are unique and sorted by project_id",
    "each sealed P0 project has exactly one explicit required or optional row",
    "exactly one optional row is bound to authority and the admitted optional-identity source",
    "seal.sha256 equals sha256 of canonical JSON without seal",
    "membership changes only project-scoped release blockers; it never removes health rows or global blockers"
  ],
  "x-provenance": {"decision": "D86", "scope": "P6.3"}
}
