{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:learning:defs:v1",
  "title": "LearningDefinitions",
  "description": "learning contract; semantics: the learning module.",
  "$defs": {
    "ConsolidationAction": {
      "type": "string",
      "enum": [
        "add",
        "update",
        "noop",
        "conflict"
      ]
    },
    "ReviewVerdict": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "edit",
        "comment"
      ]
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "attempt",
        "client_session"
      ]
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "unknown"
      ]
    },
    "CandidateState": {
      "type": "string",
      "enum": [
        "observed",
        "candidate",
        "promoted",
        "rejected",
        "deprecated"
      ]
    },
    "ConfidenceTier": {
      "type": "string",
      "enum": [
        "none",
        "tentative",
        "moderate",
        "strong",
        "core"
      ]
    },
    "Detector": {
      "type": "string",
      "enum": [
        "resolved_failure",
        "workaround",
        "pathology",
        "workflow_relaunch"
      ]
    },
    "PathologyCode": {
      "type": "string",
      "enum": [
        "file_reread",
        "tool_error_loop",
        "no_op_run",
        "no_verify",
        "cache_miss",
        "retrieval_stuffing",
        "protected_write",
        "static_context",
        "fanout"
      ]
    },
    "ExposedLessonRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "version": {
          "type": "string"
        },
        "content_digest": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_digest"
      ]
    },
    "DetectorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detector_version": {
          "type": "string"
        },
        "input_schema_version": {
          "type": "string"
        },
        "relevant_metrics": {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
          }
        },
        "decision": {
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "population": {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
          }
        },
        "exclusions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
          }
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_investigation": {
          "type": "string"
        }
      },
      "required": [
        "detector_version",
        "input_schema_version",
        "relevant_metrics",
        "thresholds",
        "source_refs",
        "coverage",
        "decision",
        "severity",
        "population",
        "exclusions",
        "alternative_explanations",
        "suggested_investigation"
      ]
    },
    "CandidateReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "candidate_id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "reviewer_id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "reviewer_kind": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "worker"
          ]
        },
        "verdict": {
          "$ref": "urn:skm:learning:defs:v1#/$defs/ReviewVerdict"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "edited_trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "edited_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "edited_kind": {
          "anyOf": [
            {
              "$ref": "urn:skm:knowledge:defs:v1#/$defs/LessonKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposal_id": {
          "anyOf": [
            {
              "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
        }
      },
      "required": [
        "id",
        "candidate_id",
        "reviewer_id",
        "reviewer_kind",
        "verdict",
        "note",
        "edited_trigger",
        "edited_action",
        "edited_kind",
        "proposal_id",
        "created_at"
      ]
    },
    "CandidateProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "scope_id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "candidate_id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "source_candidate_id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "source_activity_id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        "source_key": {
          "type": "string"
        },
        "observed_at": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
        },
        "received_at": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
        },
        "kind": {
          "$ref": "urn:skm:knowledge:defs:v1#/$defs/LessonKind"
        },
        "trigger": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "detector_version": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "update",
            "conflict"
          ]
        }
      },
      "required": [
        "id",
        "scope_id",
        "candidate_id",
        "source_candidate_id",
        "source_activity_id",
        "source_key",
        "observed_at",
        "received_at",
        "kind",
        "trigger",
        "action",
        "fingerprint",
        "detector_version",
        "relation"
      ]
    },
    "CheckRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "origin": {
          "enum": [
            "agent_shell",
            "check_execution"
          ]
        },
        "check_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "command",
        "ok",
        "origin",
        "check_key"
      ]
    },
    "ErrorLoop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "snippet": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "length",
        "snippet"
      ]
    },
    "RereadEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "count"
      ]
    },
    "WorkflowRelaunch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "statuses": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "name",
        "count",
        "statuses"
      ]
    },
    "AgentUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "input_tokens": {
