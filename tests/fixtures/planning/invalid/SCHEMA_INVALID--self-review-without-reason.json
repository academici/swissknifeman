  "decisions": [
    {
      "id": "0192f5c4-0000-7000-8000-00000000003c",
      "key": "D1",
      "title": "Rotation strategy",
      "date": "2026-10-21",
      "state": "accepted",
      "question": "How do we detect and handle reuse?",
      "options": [
        {
          "key": "A",
          "text": "One-time tokens grouped by family; reuse revokes the family."
        },
        {
          "key": "B",
          "text": "Sliding expiry without rotation."
        }
      ],
      "decision": "A",
      "rationale": "Only A detects replay of a stolen token.",
      "consequences": [
        "A refresh race between tabs revokes the family; the client must single-flight refreshes."
      ],
      "applies_to": [
        "P1.2",
        "P2.2"
      ],
      "origin": {
        "kind": "owner"
      },
      "answered_by": "owner"
    },
