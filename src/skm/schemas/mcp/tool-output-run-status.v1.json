{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-output:run-status:v1",
  "title": "skm_run_status output",
  "description": "Output for the skm_run_status MCP tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "status": {
      "type": "string"
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "by_status"
      ]
    },
    "waiting": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "kind",
          "summary"
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usd_spent": {
          "type": "number",
          "minimum": 0
        },
        "usd_limit": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "usd_spent",
        "usd_limit"
      ]
    },
    "waiting_truncated": {
      "$ref": "urn:skm:mcp:tool-output-truncation-receipt:v1"
    }
  },
  "required": [
    "run_id",
    "status",
    "tasks",
    "waiting",
    "budget"
  ]
}
