{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:knowledge:query:graph-neighbors-http:v1",
  "title": "HttpGraphNeighbors",
  "description": "Graph neighbors query with the HTTP traversal depth cap.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace_id": {
      "$ref": "urn:skm:knowledge:query:graph-neighbors:v1#/properties/workspace_id"
    },
    "edge_types": {
      "$ref": "urn:skm:knowledge:query:graph-neighbors:v1#/properties/edge_types"
    },
    "at_revision": {
      "$ref": "urn:skm:knowledge:query:graph-neighbors:v1#/properties/at_revision"
    },
    "node_key": {
      "$ref": "urn:skm:knowledge:query:graph-neighbors:v1#/properties/node_key"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "default": 1,
      "maximum": 3
    },
    "direction": {
      "$ref": "urn:skm:knowledge:query:graph-neighbors:v1#/properties/direction"
    },
    "project_id": {
      "$ref": "urn:skm:knowledge:query:graph-neighbors:v1#/properties/project_id"
    }
  },
  "required": [
    "workspace_id",
    "node_key"
  ]
}
