{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-output:plan-list:v1",
  "title": "skm_plan_list output",
  "description": "Output for the skm_plan_list MCP tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 0
          },
          "plan_id": {
            "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
          },
          "title": {
            "type": "string",
            "minLength": 0
          },
          "current_revision_no": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "open_drafts": {
            "type": "integer",
            "minimum": 0
          },
          "updated_at": {
            "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
          }
        },
        "required": [
          "alias",
          "plan_id",
          "title",
          "current_revision_no",
          "open_drafts",
          "updated_at"
        ]
      }
    },
    "next": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "items_truncated": {
      "$ref": "urn:skm:mcp:tool-output-truncation-receipt:v1"
    }
  },
  "required": [
    "items",
    "next"
  ]
}
