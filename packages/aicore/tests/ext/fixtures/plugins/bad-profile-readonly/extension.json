{
  "$schema": "urn:swissknifeman:aicore:extension:v1",
  "id": "bad-profile-readonly",
  "kind": "command",
  "version": "0.1.0",
  "description": "Asks for the read-only profile, which the host does not enforce.",
  "protocol": {"min": "1", "max": "1"},
  "entrypoint": ["python3", "plugin.py"],
  "provides": {"points": ["demo:check"]},
  "permissions": {"profile": "read-only"}
}
