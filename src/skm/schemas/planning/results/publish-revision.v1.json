{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:planning:result:publish-revision:v1",
  "title": "PublishRevisionResult",
  "description": "planning owner contract; see the planning module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "revision_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "revision_no": {
      "type": "integer",
      "minimum": 1
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_digest": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/digest"
    },
    "pinned_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "material_key": {
            "type": "string",
            "minLength": 0
          },
          "file_version_id": {
            "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
          },
          "resolved_from": {
            "type": "string",
            "enum": [
              "pinned",
              "latest_at_publish"
            ]
          }
        },
        "required": [
          "material_key",
          "file_version_id",
          "resolved_from"
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "warning",
        "info"
      ]
    }
  },
  "required": [
    "plan_id",
    "revision_id",
    "revision_no",
    "parent_revision_id",
    "content_digest",
    "pinned_materials",
    "counts"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.planning.generated.results",
      "class": "PublishRevisionResult",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "planning.ts",
      "name": "PublishRevisionResult"
    }
  }
}
