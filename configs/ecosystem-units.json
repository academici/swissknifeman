{
  "schema_version": "ecosystem-units/v1",
  "_doc": "Hub map of the module split, read by scripts/ecosystem-units.py. targets: final module ids; module_aliases: current folder id -> target id; retired: folders without unit.json that are being removed; foundation: the shared base module and the names its code is imported under today; transitional_roots: root-level trees still being moved; version_sources: where the version of each module is read from (unit.json must equal it); ownership: files that move to another module (longest path wins); path_patterns: regexes with a named group 'target' that find paths of other folders in module files (climb: count only ../ runs that leave the module); path_suffixes: file suffixes scanned for path patterns.",
  "targets": [
    "aicore",
    "skiller",
    "planner",
    "orch",
    "maind",
    "analyst",
    "harness",
    "brain",
    "bridges/planner-orch",
    "bridges/orch-skiller",
    "bridges/orch-harness",
    "hub",
    "retired"
  ],
  "module_aliases": {
    "task": "planner"
  },
  "retired": [
    "artifex"
  ],
  "foundation": {
    "id": "aicore",
    "aliases": [
      "core"
    ]
  },
  "transitional_roots": [
    "core/",
    "orch/",
    "packages/artifex/",
    "packages/task/"
  ],
  "version_sources": {
    "analyst": {"path": "packages/analyst/package.json", "read": "json:version"},
    "harness": {"path": "packages/harness/package.json", "read": "json:version"},
    "maind": {"path": "packages/maind/package.json", "read": "json:version"},
    "orch": {"path": "packages/orch/lib/orch/__init__.py", "read": "python:__version__"},
    "skiller": {"path": "packages/skiller/package.json", "read": "json:version"},
    "task": {"path": "packages/task/.claude-plugin/plugin.json", "read": "json:version"}
  },
  "path_patterns": [
    {"id": "sibling-package", "regex": "packages/(?P<target>[a-z][a-z0-9-]*)/", "reason": "a module must not name another module's folder; use a bridge or an event"},
    {"id": "repo-escape", "regex": "\\.\\./(?:\\.\\./)*(?P<target>core|configs|scripts|bin|orch)\\b", "reason": "a module must not reach into hub-level folders through relative paths", "climb": true}
  ],
  "path_suffixes": [".py", ".sh", ".js", ".mjs", ".json", ".toml", ".yml", ".yaml"],
