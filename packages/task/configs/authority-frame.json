{
  "version": "authority-frame-v1",
  "frozen_at": "2026-08-09",
  "description": "Repository owner authority frame for executable-plan decisions; deny by default and monotonic.",
  "default": "reserved",
  "contract": "packages/task/configs/authority-frame-v1.schema.json",
  "aggregation": {
    "key": [
      "plan_id",
      "item_id",
      "decision_class"
    ],
    "window": "item_lifetime",
    "surface_field": "affected_surfaces",
    "rule": "union_crosses_reserved_predicate=>reserved"
  },
  "decision_classes": {
    "constructive": {
      "semantics": "Technical decision within every declared and frozen boundary.",
      "material_fields": [
        "plan_id",
        "item_id",
        "decision_class",
        "affected_surfaces",
        "predicate_results"
      ],
      "aggregation_rule": "union_crosses_reserved_predicate=>reserved",
      "delegated_limits": {
        "requires_all": [
          "within_declared_scope",
          "no_frozen_contract_change",
          "no_closed_set_extension",
          "reversible",
          "decision_recorded"
        ]
      },
      "owner": "repository_owner",
      "escalation_route": "repository_owner",
      "verdict": "delegated",
      "action_class": "AUTO",
      "attention": "none",
      "on_timeout": "park"
    },
    "scope_change": {
      "semantics": "Decision that changes declared phases, items, goals, files, or scope boundaries.",
      "material_fields": [
        "plan_id",
        "item_id",
        "decision_class",
        "affected_surfaces"
      ],
      "aggregation_rule": "union_crosses_reserved_predicate=>reserved",
      "delegated_limits": {},
      "owner": "repository_owner",
      "escalation_route": "repository_owner",
      "verdict": "reserved",
      "action_class": "OWNER",
      "attention": "batched",
      "on_timeout": "park"
    },
    "authority_change": {
      "semantics": "Decision that changes this frame, a decision class, a ceiling, or reader rights.",
      "material_fields": [
        "plan_id",
        "item_id",
        "decision_class",
        "affected_surfaces"
      ],
      "aggregation_rule": "union_crosses_reserved_predicate=>reserved",
      "delegated_limits": {},
      "owner": "repository_owner",
      "escalation_route": "repository_owner",
      "verdict": "reserved",
      "action_class": "OWNER",
      "attention": "batched",
      "on_timeout": "park"
    },
    "irreversible_semantics": {
      "semantics": "Decision that freezes, unfreezes, publishes, or irreversibly changes protocol semantics.",
      "material_fields": [
        "plan_id",
        "item_id",
        "decision_class",
        "affected_surfaces"
      ],
      "aggregation_rule": "union_crosses_reserved_predicate=>reserved",
      "delegated_limits": {},
      "owner": "repository_owner",
      "escalation_route": "repository_owner",
      "verdict": "reserved",
      "action_class": "OWNER",
      "attention": "batched",
      "on_timeout": "park"
    }
  }
}
