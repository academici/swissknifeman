  },
  {
   "name": "a relative XDG_DATA_HOME is ignored",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n",
    "h/.local/share/swissknifeman/workspaces/axioma/projects/billium/plans/.keep": ""
   },
   "env": {
    "HOME": "{tmp}/h",
    "XDG_DATA_HOME": "relative/dir"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "kind": "workspace",
    "plans_root": "{tmp}/h/.local/share/swissknifeman/workspaces/axioma/projects/billium/plans",
    "project_id": "billium",
    "reason": "marker-workspace"
   }
  },
  {
   "name": "source root: the primary binding",
   "op": "source_root",
   "files": {
    "co1/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n",
    "co2/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n",
    "home/state/workspaces/axioma/bindings.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:workspace-bindings:v1\",\n  \"projects\": {\n    \"billium\": {\n      \"paths\": [\n        \"{tmp}/co2\",\n        \"{tmp}/co1\"\n      ],\n      \"primary\": \"{tmp}/co1\",\n      \"bound_at\": \"2026-10-17T09:30:00Z\"\n    }\n  }\n}\n"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "plan_dir": "{tmp}/home/data/workspaces/axioma/projects/billium/plans/p1",
   "expect": {
    "source_root": "{tmp}/co1"
   }
  },
