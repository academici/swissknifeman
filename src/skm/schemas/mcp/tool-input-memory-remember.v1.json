{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-input:memory-remember:v1",
  "title": "skm_memory_remember input",
  "description": "Input for the skm_memory_remember MCP tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "key": {
      "type": "string",
      "enum": [
        "context",
        "fact",
        "blocker",
        "coordination",
        "active-handoff"
      ]
    },
    "ttl_hours": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 72,
      "default": 48
    },
    "scope": {
      "type": "string",
      "enum": [
        "project"
      ],
      "default": "project"
    },
    "expected_handoff_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "text",
    "key"
  ]
}
