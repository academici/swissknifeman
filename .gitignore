*.pyc
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
.claude/settings.json
# personal/local Claude-настройки проекта (права, defaultMode — могут содержать
# bypassPermissions; машинно-специфичны, в публичный репо не коммитим). Раньше
# ловилось только глобальным ~/.config/git/ignore — добавлено явно для свежих клонов/CI.
.claude/settings.local.json
# personal per-project hook overrides (autonomy/mode — must not be committed)
.claude/auto-approve.env.ini
.claude/auto-approve.config.json
.claude/memory.env.ini
.claude/memory.config.json
# Эфемерные (временные) артефакты analyst-уроков — машинно-специфичны, не коммитим.
# Важные файлы (events.ndjson, audit.ndjson) остаются.
.claude/analyst/lessons/ephemeral/
.claude/analyst/**/*.ndjson
settings.local.json.bak
MERGE-PLAN.snapshots/
# Приватный конфиг узла maind (пути ко всем проектам); шаблон — config.example.json
config.json
# Machine-owned allowlist safe-dirs (пути машины); шаблон — safe-dirs.example.json,
# читают хук auto-approve (lib/safedirs.py) и CLI `harness safe-dirs`
safe-dirs.json

# Машинно-специфичный MCP-конфиг проекта: абсолютные пути к лаунчеру maind (утечка
# пути + ломает клон у других). Шаблон — .mcp.json.example; реальный файл генерит
# `maind` (sync/deploy → mcpconfig.write_mcp). .bak — бэкап от write_mcp.
.mcp.json
.mcp.json.bak

# Генерируемые maind хук-скрипты проекта (SessionStart/SessionEnd) + их рантайм-state:
# пишет `maind sync` из templates/health/*; лаунчер maind резолвится в самих скриптах
# из env MAIND_BIN → PATH (без машинно-специфичного пути). Не коммитим — как .mcp.json.
.claude/maind-*.sh
.claude/.maind-feature-log.last
.claude/scheduled_tasks.lock

# Сборочные копии per-package доков (источник — packages/<pkg>/docs; см. scripts/docs-sync.sh)
docs/skiller/
docs/harness/
docs/maind/
docs/analyst/

# Внутренние research-доки (аудиты/трекеры) — локально, не публиковать
# (анкор к корню: НЕ затрагивать бакет skills/research реестра)
/research/
*.bak