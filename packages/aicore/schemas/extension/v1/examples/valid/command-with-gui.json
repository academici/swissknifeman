{
  "$schema": "urn:swissknifeman:aicore:extension:v1",
  "id": "board-view",
  "kind": "command",
  "version": "0.1.0",
  "description": "Answers GUI queries and short commands of a board view.",
  "protocol": {
    "min": "1",
    "max": "1"
  },
  "entrypoint": [
    "bin/board-view"
  ],
  "provides": {
    "points": [
      "gui:query",
      "gui:command"
    ],
    "gui": "gui.json"
  }
}
