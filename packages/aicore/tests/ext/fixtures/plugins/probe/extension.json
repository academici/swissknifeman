{
  "$schema": "urn:swissknifeman:aicore:extension:v1",
  "id": "probe",
  "kind": "command",
  "version": "0.1.0",
  "description": "Reports whether an environment variable reached it, never its value.",
  "protocol": {"min": "1", "max": "1"},
  "entrypoint": ["python3", "plugin.py"],
  "provides": {"points": ["demo:check"]},
  "permissions": {"env": ["FIXTURE_PLAIN"], "secrets": ["env://FIXTURE_SECRET"]}
}
