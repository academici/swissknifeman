{
  "name": "@academici/swissknifeman",
  "version": "0.17.16",
  "private": true,
  "license": "MIT",
  "description": "Universal personal registry AI-skills and snippets: one source of truth, installation in any project and any IDE",
  "type": "module",
  "scripts": {
    "docs:sync": "bash ../../scripts/docs-sync.sh",
    "docs:dev": "npm run docs:sync && vitepress dev ../../docs",
    "docs:build": "npm run docs:sync && npm run docs:link-nm && vitepress build ../../docs",
    "docs:link-nm": "[ -e ../../node_modules ] || ln -s \"$(pwd)/node_modules\" ../../node_modules",
    "docs:preview": "vitepress preview ../../docs",
    "docs:standalone:dev": "vitepress dev docs",
    "docs:standalone:build": "vitepress build docs",
    "docs:standalone:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "mermaid": "^11.14.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
