   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n",
    "custom/axioma/projects/billium/plans/.keep": ""
   },
   "env": {
    "SKM_HOME": "{tmp}/home",
    "SKM_WORKSPACES_ROOT": "{tmp}/custom"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "kind": "workspace",
    "plans_root": "{tmp}/custom/axioma/projects/billium/plans",
    "project_id": "billium",
    "reason": "marker-workspace"
   }
  },
  {
   "name": "SKM_HOME places the workspace in data/workspace",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n",
    "home/data/workspaces/axioma/projects/billium/plans/.keep": ""
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "kind": "workspace",
