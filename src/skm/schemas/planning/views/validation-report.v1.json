{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:planning:view:validation-report:v1",
  "title": "ValidationReportView",
  "description": "planning owner contract; see the planning module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "draft_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "edit_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "saved",
        "submitted"
      ]
    },
    "document_digest": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pointer": {
            "type": "string",
            "minLength": 0
          },
          "message": {
            "type": "string",
            "minLength": 0
          },
          "schema_pointer": {
            "type": "string",
            "minLength": 0
          }
        },
        "required": [
          "pointer",
          "message",
          "schema_pointer"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 0
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 0
          },
          "entity_key": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "entity_id": {
            "anyOf": [
              {
                "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "pointer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "entity_key",
          "entity_id",
          "pointer",
          "details"
        ]
      }
    },
    "rule_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 0
          },
          "error_type": {
            "type": "string",
            "minLength": 0
          },
          "message": {
            "type": "string",
            "minLength": 0
          },
          "plugin": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "rule",
          "error_type",
          "message",
          "plugin"
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "error",
        "warning",
        "info"
      ]
    },
    "publishable": {
      "type": "boolean"
    },
    "graph": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tasks": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "tasks",
            "edges"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    }
  },
  "required": [
    "draft_id",
    "edit_version",
    "source",
    "document_digest",
    "schema_issues",
    "findings",
    "rule_failures",
    "counts",
    "publishable",
    "graph",
    "stale"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.planning.generated.views",
      "class": "ValidationReportView",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "planning.ts",
      "name": "ValidationReportView"
    }
  }
}
