#!/usr/bin/env bash
# swissknifeman — корневой управляющий слой зонтика (router + setup-фасад).
# Зонтик = единое управление; пакеты = возможности. Тонкий диспетчер: знает три
# пакета и кросс-пакетный онбординг, сам логику не реализует (делегирует).
#
# Группы (канонично):
#   skills <args>   → skiller  (реестр скиллов: connect, vendor, registry, …)
#   env <args>      → harness  (окружение: permissions, mcp, hooks — полный passthrough)
#   maind <args>    → maind    (хаб: memory, graph, onboard, deploy, sync, health, …)
#   analyst <args>  → analyst  (обучение: digest, review, promote, deprecate, doctor)
#   setup <project> → maind onboard (полный онбординг: скиллы+окружение+память+граф)
#   doctor          → диагностика всех пакетов (fan-out)
#   status [<id>]   → единый 4-слойный инвентарь проекта/флота (maind projects status:
#                     skills+packs+mcp+память + drift→fix); bare/--target → skiller status
#   wf <args>       → harness   (детальный статус фонового workflow-прогона: wf status)
#   -V, --version   → версия зонтика (git describe)
#
# Back-compat: исторические команды swissknifeman = skiller (алиас сохранён):
#   connect vendor integrate update init sync lock status list registry topology
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
SKILLER="$ROOT/packages/skiller/bin/skiller"
HARNESS="$ROOT/packages/harness/bin/harness"
MAIND="$ROOT/packages/maind/bin/maind"
ANALYST="$ROOT/packages/analyst/bin/analyst"

usage() { grep '^#' "$SELF" | sed 's/^# \{0,1\}//' | sed -n '2,20p'; }

need() {  # $1 — путь к лаунчеру пакета
  [[ -x "$1" ]] || { echo "ERROR: не найден лаунчер пакета: $1" >&2
    echo "Репозиторий повреждён/неполон — перезапустите ./install.sh." >&2; exit 1; }
}

CMD="${1:-help}"
case "$CMD" in
  -h|--help|help) usage; exit 0 ;;
  -V|--version|version)
    # Единая версия монорепо из git (тегов мало, --always даёт SHA; --dirty — флаг
    # незакоммиченного). Без .git → "dev". НЕ делегируем в skiller (там version нет).
    echo "swissknifeman $(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo dev)"
    exit 0 ;;
  skills)  shift; need "$SKILLER"; exec "$SKILLER" "$@" ;;
  env)     shift; need "$HARNESS"; exec "$HARNESS" "$@" ;;
  wf)      shift; need "$HARNESS"; exec "$HARNESS" wf "$@" ;;
  maind|hub) shift; need "$MAIND"; exec "$MAIND" "$@" ;;
  analyst) shift; need "$ANALYST"; exec "$ANALYST" "$@" ;;
  setup)   shift; need "$MAIND"; exec "$MAIND" onboard "$@" ;;
  doctor)
    # fan-out на все пакеты. НЕ через need() — он бьёт exit 1 на первом же
    # отсутствующем лаунчере и не даёт проверить остальные; здесь агрегируем rc.
    rc=0
    for entry in "skiller:$SKILLER" "harness:$HARNESS" "maind:$MAIND" "analyst:$ANALYST"; do
      name="${entry%%:*}"; pkg="${entry#*:}"
      echo "== $name =="
      if [[ -x "$pkg" ]]; then "$pkg" doctor || rc=$?
      else echo "ERROR: не найден лаунчер пакета: $pkg" >&2; rc=1; fi
      echo
    done
    exit "$rc" ;;
  status)
    # Зонтичный status: <project-id> или --all/--namespace/--project → единый 4-слойный
    # инвентарь (maind projects status: skills+packs+mcp+память + drift→fix). Без аргумента
    # или со skiller-флагом (--target/--json) → skiller status (back-compat: скиллы проекта).
    shift; first="${1:-}"
    case "$first" in
      --all|--namespace|--project) need "$MAIND"; exec "$MAIND" projects status "$@" ;;
      ""|-*)                       need "$SKILLER"; exec "$SKILLER" status "$@" ;;
      *) need "$MAIND"; shift; exec "$MAIND" projects status --project "$first" "$@" ;;
    esac ;;
  # back-compat: старый алиас swissknifeman → skiller (онбордженные проекты/привычка)
  connect|vendor|integrate|update|init|sync|lock|list|registry|topology)
    need "$SKILLER"; exec "$SKILLER" "$@" ;;
  *) echo "Неизвестная команда: $CMD" >&2; usage >&2; exit 1 ;;
esac
