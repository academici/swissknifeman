          "description": "File name globs (lower case) that block an upload as a probable secret.",
          "x-skm": {
            "chain": "work",
            "levels": [
              "instance"
            ],
            "merge": "append_unique",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "ui": {
              "group": "Safety",
              "order": 20,
              "widget": "tags"
