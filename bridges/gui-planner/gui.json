        },
        {
          "group": "review",
          "order": 0,
          "pointer": "/review/mode",
          "widget": "select"
        },
        {
          "group": "review",
          "order": 10,
          "pointer": "/review/reviewer/class",
          "widget": "select"
        },
        {
          "group": "review",
          "order": 20,
          "pointer": "/review/reviewer/model",
