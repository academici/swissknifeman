{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:policy:task-authority:v1",
  "title": "TaskAuthority",
  "description": "policy owner contract; see the policy module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "write_scope": {
      "anyOf": [
        {
          "type": "array",
