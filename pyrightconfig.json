{
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "include": [
    "packages/aicore/lib",
    "packages/analyst/lib",
    "packages/brain/lib",
    "packages/gui/lib",
    "packages/harness/lib",
    "packages/maind/lib",
    "packages/orch/lib",
    "packages/planner/lib",
    "packages/skiller/lib",
    "packages/workspace/lib"
  ],
  "exclude": ["**/_vendor", "**/__pycache__", "packages/gui/lib/gui/http"],
