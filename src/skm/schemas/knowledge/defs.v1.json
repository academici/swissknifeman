{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:knowledge:defs:v1",
  "title": "KnowledgeDefinitions",
  "description": "knowledge contract; semantics: the knowledge module.",
  "$defs": {
    "GraphBasis": {
      "type": "string",
      "enum": [
        "declared",
        "lsp",
        "ast",
        "text",
        "heuristic"
      ]
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "truncated",
        "unknown"
      ]
    },
    "FreshnessState": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ]
    },
    "LimitationCode": {
      "type": "string",
      "enum": [
        "depth_limit",
        "node_limit",
        "language_unsupported",
        "dynamic_dispatch",
        "generated_excluded",
        "parse_errors",
        "index_stale",
        "index_old",
        "index_dirty",
        "no_index",
        "cross_repository_unresolved"
      ]
    },
    "MemoryState": {
      "type": "string",
      "enum": [
        "live",
        "forgotten",
        "expired",
        "superseded"
      ]
    },
    "LessonKind": {
      "type": "string",
      "enum": [
        "heuristic",
        "procedure",
        "gotcha"
      ]
    },
    "LessonState": {
      "type": "string",
      "enum": [
        "curated",
        "deprecated"
      ]
    },
    "ConfidenceTier": {
      "type": "string",
      "enum": [
        "none",
        "tentative",
        "moderate",
        "strong",
        "core"
      ]
    },
    "MemoryKind": {
      "type": "string",
      "enum": [
        "context",
        "fact",
        "blocker",
        "coordination",
        "active_handoff",
        "health_probe"
      ]
    },
    "MemoryScopeKind": {
      "type": "string",
      "enum": [
        "project",
        "namespace",
        "global"
      ]
    },
    "NodeType": {
      "type": "string",
      "enum": [
        "project",
        "agent",
        "memory",
        "skill",
        "entity",
        "tool",
        "package",
        "doc",
        "symbol"
      ]
    },
    "EdgeType": {
      "type": "string",
      "enum": [
        "uses",
        "knows",
        "relates_to",
        "belongs_to",
        "depends_on",
        "provided_by",
        "requires",
        "references"
      ]
    },
    "GraphAnswer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "urn:skm:knowledge:defs:v1#/$defs/GraphQueryEcho"
        },
        "repository_id": {
          "anyOf": [
            {
              "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "index_generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:skm:knowledge:defs:v1#/$defs/GraphSourceRef"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relation_kind": {
          "anyOf": [
            {
              "$ref": "urn:skm:knowledge:defs:v1#/$defs/EdgeType"
            },
            {
              "enum": [
                "mixed",
                "none"
              ]
            }
          ]
        },
        "completeness": {
          "$ref": "urn:skm:knowledge:defs:v1#/$defs/Completeness"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "urn:skm:knowledge:defs:v1#/$defs/Limitation"
          }
        },
        "freshness": {
          "$ref": "urn:skm:knowledge:defs:v1#/$defs/Freshness"
        },
        "basis": {
          "anyOf": [
            {
              "$ref": "urn:skm:knowledge:defs:v1#/$defs/GraphBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "urn:skm:knowledge:defs:v1#/$defs/AnswerNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "urn:skm:knowledge:defs:v1#/$defs/AnswerEdge"
          }
        },
        "path": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "urn:skm:knowledge:defs:v1#/$defs/GraphStats"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "query",
        "repository_id",
        "revision",
        "index_generation",
        "sources",
        "languages",
        "relation_kind",
        "completeness",
        "limitations",
        "freshness",
        "basis",
        "nodes",
        "edges",
        "path",
        "stats"
      ]
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "Limitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
