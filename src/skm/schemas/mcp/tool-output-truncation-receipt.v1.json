{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-output-truncation-receipt:v1",
  "title": "TruncationReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "truncated": {
      "const": true
    },
    "returned_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_count": {
      "type": "integer",
      "minimum": 1
    },
    "hint": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "truncated",
    "returned_count",
    "total_count",
    "hint"
  ]
}
