{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/terminal-admission-lease-v1.schema.json",
  "schema_version": "terminal-admission-lease/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "sequence", "progress_fingerprint", "continuity_sha256", "lifecycle", "issued_at", "refreshed_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "terminal-admission-lease/v1"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["plan_id", "subject", "command", "run_id", "task_session", "provider", "provider_session", "turn_id"]},
    "sequence": {"type": "integer", "minimum": 1},
    "progress_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "continuity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle": {"enum": ["active", "waiting-owner", "waiting-external", "released"]},
    "issued_at": {"type": "number"},
    "refreshed_at": {"type": "number"},
    "expires_at": {"type": "number"}
  }
}
