{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:execution:role-result:scout:v1",
  "title": "ScoutResult",
  "description": "Context map produced by the read-only scout role; becomes the context_map block of the executor's context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "summary",
    "relevant_paths"
  ],
  "properties": {
    "schema": {
      "const": "urn:skm:execution:role-result:scout:v1"
    },
    "status": {
      "enum": [
        "complete",
        "insufficient"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "relevant_paths": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mount",
          "path",
          "why"
        ],
        "properties": {
          "mount": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "entry_points": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mount",
          "path",
          "why"
        ],
        "properties": {
          "mount": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "suggested_checks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "why"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.execution.generated.documents",
      "class": "ScoutResultDoc",
      "kind": "typeddict"
    },
    "typescript": {
      "file": "execution.ts",
      "name": "ScoutResultDoc"
    }
  }
}
