{
  "schema_version": "decision-request-schema-v1",
  "contract": "decision-request",
  "contract_version": "v1",
  "status": "frozen",
  "kinds": [
    "clarification",
    "authorization"
  ],
  "reason_code_namespace": "P5_DECISION_",
  "reason_codes": [
    "P5_DECISION_POLICY_APPROVED",
    "P5_DECISION_OWNER_APPROVED",
    "P5_DECISION_AUTO_CLARIFIED",
    "P5_DECISION_ESCALATED",
    "P5_DECISION_REJECTED",
    "P5_DECISION_TIMEOUT_PARKED",
    "P5_DECISION_POLICY_ERROR",
    "P5_DECISION_UNKNOWN_OPTION",
    "P5_DECISION_DIGEST_MISMATCH",
    "P5_DECISION_RESPONSE_REUSED",
    "P5_DECISION_RECLASSIFICATION_REQUIRED",
    "P5_DECISION_RECORD_TOO_LARGE",
    "P5_DECISION_FORBIDDEN_CONTENT",
    "P5_DECISION_UNCLASSIFIED_KIND"
  ],
  "computed_by_tool_not_model": [
    "canonical_action",
    "action_digest",
    "material_fields",
    "policy_digest"
  ],
  "assigned_by_authority_frame_not_request": [
    "decision_class",
    "on_timeout"
  ],
  "canonical_action": {
    "profile": "sorted-keys-compact-utf8-v1",
    "serialization": "json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode('utf-8')",
    "digest": "lowercase sha256 hex over the serialized canonical_action bytes",
    "material_fields": [
      "contract_version",
      "kind",
      "decision_class",
      "subject",
      "action",
      "options",
      "default_option",
      "continuation.target",
      "continuation.capabilities",
      "policy_digest"
    ],
    "equivalence": "only a pinned deterministic mapping may declare equivalence; model judgement is forbidden",
    "change_rule": "a change to any material field creates action_version n+1, a new digest, and a new request"
  },
  "options": {
    "min_substantive": 2,
    "max_substantive": 5,
    "mandatory": [
      "escalate",
      "reject"
    ],
    "closed_per_decision_class": true,
    "unknown_option": "reject"
  },
  "timeout_policy": {
    "clarification": {
      "allowed": [
        "park",
        "apply_default",
        "reject"
      ],
      "apply_default_requires": "reversible action inside a preauthorized envelope declared by the authority frame"
    },
    "authorization": {
      "allowed": [
        "park"
      ]
    }
  },
  "constants": {
    "on_policy_error": "reject",
    "on_unknown_option": "reject"
  },
  "request": {
    "additional_properties": false,
    "required": [
      "contract_version",
      "decision_id",
      "action_version",
      "kind",
      "decision_class",
      "subject",
      "action_digest",
      "canonical_action",
      "material_fields",
      "options",
      "default_option",
      "on_timeout",
      "expires_at",
      "evidence",
      "policy_digest",
      "attempted",
      "continuation"
    ],
    "properties": {
      "contract_version": {
        "const": "v1"
      },
      "decision_id": {
        "type": "string",
        "min_length": 1
      },
      "action_version": {
        "type": "integer",
        "minimum": 1
      },
      "kind": {
        "enum_ref": "kinds"
      },
      "decision_class": {
        "type": "string",
        "source": "authority-frame-v1"
      },
      "subject": {
        "type": "object",
        "additional_properties": false,
        "required": [
          "plan_id",
          "phase_id",
          "item_id"
        ],
        "properties": {
          "plan_id": {"type": "string", "min_length": 1},
          "phase_id": {"type": "string", "pattern": "^P[0-9]+$"},
          "item_id": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"}
        }
      },
      "action_digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "canonical_action": {
        "type": "object",
        "source": "tool projection of canonical_action.material_fields"
      },
      "material_fields": {
        "const_ref": "canonical_action.material_fields"
      },
      "options": {
        "type": "array",
        "unique_by": "id",
        "items": {
          "type": "object",
          "additional_properties": false,
          "required": [
            "id",
            "outcome",
            "action_ref",
            "evidence_refs"
          ],
          "properties": {
            "id": {"type": "string", "min_length": 1},
            "outcome": {"enum": ["apply", "park", "escalate", "reject"]},
            "action_ref": {"type": ["string", "null"]},
            "evidence_refs": {"type": "array", "items": {"type": "string"}}
          }
        }
      },
      "default_option": {
        "type": [
          "string",
          "null"
        ]
      },
      "on_timeout": {
        "enum": [
          "park",
          "apply_default",
          "reject"
        ],
        "source": "authority-frame-v1"
      },
      "expires_at": {
        "type": "string",
        "format": "date-time"
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additional_properties": false,
          "required": ["carrier", "anchor", "digest"],
          "properties": {
            "carrier": {"type": "string", "min_length": 1},
            "anchor": {"type": "string", "min_length": 1},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      },
      "policy_digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "source": "authority-frame-v1 instance"
      },
      "attempted": {
        "type": "array",
        "items": {"type": "string", "description": "reference to an existing typed attempt event"}
      },
      "continuation": {
        "type": "object",
        "additional_properties": false,
        "required": [
          "root_session_id",
          "root_run_id",
          "target",
          "capabilities",
          "preferred_mode"
        ],
        "properties": {
          "root_session_id": {"type": "string", "min_length": 1},
          "root_run_id": {"type": "string", "min_length": 1},
          "target": {
            "type": "object",
            "additional_properties": false,
            "required": ["plan_id", "item_id", "resume_command"],
            "properties": {
              "plan_id": {"type": "string", "min_length": 1},
              "item_id": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"},
              "resume_command": {"type": "string", "min_length": 1}
            }
          },
          "capabilities": {
            "type": "object",
            "additional_properties": false,
            "required": ["snapshot_id", "digest", "available"],
            "properties": {
              "snapshot_id": {"type": "string", "min_length": 1},
              "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "available": {"type": "array", "items": {"type": "string"}}
            }
          },
          "preferred_mode": {
            "const": "resume-root"
          }
        }
      }
    }
  },
  "response": {
    "additional_properties": false,
    "required": [
      "decision_id",
      "action_version",
      "selected_option",
      "resolver",
      "resolver_id",
      "policy_digest",
      "action_digest",
      "reason_code",
      "provenance",
      "at"
    ],
    "required_when": {
      "kind==clarification": [
        "reclassified_to"
      ]
    },
    "properties": {
      "decision_id": {"type": "string", "min_length": 1},
      "action_version": {"type": "integer", "minimum": 1},
      "selected_option": {"type": "string", "min_length": 1},
      "resolver": {"enum": ["policy", "owner"]},
      "resolver_id": {"type": "string", "min_length": 1},
      "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "action_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "reason_code": {"enum_ref": "reason_codes"},
      "reclassified_to": {"enum_ref": "kinds"},
      "provenance": {
        "type": "object",
        "additional_properties": false,
        "required": ["source_system", "record_id", "record_version", "verified"],
        "properties": {
          "source_system": {"type": "string", "min_length": 1},
          "record_id": {"type": "string", "min_length": 1},
          "record_version": {"type": "string", "min_length": 1},
          "verified": {"const": true}
        }
      },
      "at": {"type": "string", "format": "date-time"}
    }
  },
  "auto_answer_event": {
    "append_only": true,
    "required": [
      "decision_id",
      "question_class",
      "resolver_id",
      "source_system",
      "source_record_id",
      "source_record_version",
      "before_digest",
      "after_digest",
      "provenance_verified",
      "policy_digest",
      "reclassified_action_digest",
      "reclassified_to"
    ]
  },
  "application": {
    "single_use_key": [
      "decision_id",
      "action_version",
      "action_digest"
    ],
    "recompute_before_apply": [
      "canonical_action",
      "action_digest",
      "policy_digest"
    ],
    "digest_mismatch": "reject and create a new request at action_version n+1",
    "response_reuse": "reject"
  },
  "continuation_fallback": {
    "preferred": "resume-root",
    "allowed_fallback": "cold-start-root",
    "fallback_requires": [
      "exact_reason_code",
      "exact_reason_detail",
      "original_request_unchanged"
    ]
  },
  "record": {
    "max_bytes": 16384,
    "measurement": "byte length of compact UTF-8 canonical JSON before append",
    "on_excess": "reject",
    "forbidden": [
      "model_reasoning",
      "model_transcript",
      "raw_provider_prompt",
      "raw_provider_stream",
      "secrets_or_tokens",
      "environment_file_contents",
      "worker_prose",
      "inline_evidence_payload",
      "return_loop_owner_packet_copy",
      "undeclared_option"
    ]
  }
}
