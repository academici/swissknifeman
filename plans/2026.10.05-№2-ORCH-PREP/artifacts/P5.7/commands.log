  --file FILE           file holding the JSON
  --agent PROVIDER/MODEL[/EFFORT]
                        dispatch: the worker
  --notes NOTES
  --changed PATH        return: a changed path (repeatable)
  --minutes MINUTES
  --executed-by PROVIDER/MODEL[/EFFORT]
                        return: who did the work when not the dispatched
                        worker; route-checked
  --attempt-id ID       return|accept: registration attempt; a repeat is a no-
                        op
  --evidence V1=PATH    accept: check-evidence file of the unit (Task field
                        contract; see `plan.py schema check-evidence`;
                        repeatable)
  --actor ACTOR         PROVIDER/MODEL[/EFFORT] (default: the item executor,
                        else plan authoring)

