  "state_rules": {
    "CREATED": {
      "on": {
        "freeze_run": "READY",
        "source_drift": "OWNER_ATTENTION",
        "owner_decision_abort": "ABORTED"
      },
      "otherwise": "ILLEGAL_TRANSITION"
    },
    "READY": {
      "on": {
        "append_intent": "INTENT_DURABLE",
        "source_drift": "OWNER_ATTENTION",
        "budget_exhausted": "BUDGET_EXHAUSTED",
