{
  "schema_version": "1.0.0",
  "_doc": "Provider-neutral skill distribution channels. Consumed via core.provider.distribution; packages must not hardcode provider if/continue skips.",
  "providers": {
    "claude-code": {
      "connect": {
        "mode": "claude-marketplace",
        "target": ".claude"
      },
      "vendor": {
        "path_param": "claude_path"
      }
    },
    "codex": {
      "connect": {
        "mode": "codex-marketplace",
        "marketplace": ".agents/plugins/marketplace.json",
        "bundle": true
      },
      "vendor": {
        "path_param": "codex_path"
      }
    },
    "cursor": {
      "discovery": {
        "surface": ".agents/skills",
        "decision": "D8",
        "note": "Native Cursor discovery; skiller does not connect/vendor-write a second skill tree."
      }
    }
  }
}
