   },
   "env": {
    "HOME": "{tmp}/h",
    "XDG_DATA_HOME": "{tmp}/xdg"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "kind": "workspace",
    "plans_root": "{tmp}/xdg/swissknifeman/workspaces/axioma/projects/billium/plans",
    "project_id": "billium",
    "reason": "marker-workspace"
   }
  },
