    "ExecutionBlocks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_policy": {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
          }
        },
        "decision_answers": {
          "type": "array",
          "items": {
            "$ref": "urn:skm:context:defs:v1#/$defs/AnswerItem"
          }
        },
        "review_feedback": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_attempt": {
          "anyOf": [
            {
              "$ref": "urn:skm:context:defs:v1#/$defs/PreviousAttemptSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "urn:skm:context:defs:v1#/$defs/CandidateRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings_under_review": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
            }
          }
        },
        "context_map": {
          "anyOf": [
            {
              "$ref": "urn:skm:context:defs:v1#/$defs/ContextMapItem"
            },
            {
              "type": "null"
