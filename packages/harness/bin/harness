#!/usr/bin/env bash
# harness — CLI настройки окружения Claude Code (permissions, MCP, хуки).
# Тонкий лаунчер: проверяет окружение и передаёт управление пакету lib/harness
# (python3 -m harness). Вся логика — в lib/ (импортируемо и тестируемо: см. tests/).
#
# Команды (запускаются из потребляющего проекта / с --target):
#   permissions  влить permissions-пресеты в .claude/settings*.json (alias: apply)
#                [--target P] [--preset a,b] [--file F] [--dry-run] [--list] [--global]
#   mcp          влить MCP-пресеты в .mcp.json, merge-only [--target P] [--mcp a,b] [--list] [--dry-run]
#   hooks        включить хуки по проекту / поставить файлы хуков глобально
#                [--target P] [--auto-approve MODE] [--memory BRAIN:MODE] [--file F] [--global] [--dry-run]
#   agent-packs  детерминированный рендер/апгрейд пака субагентов в проект (без агента)
#                <list|render|upgrade|doctor> [--pack P] [--target P] [--auto] [--answer K=V] [--dry-run]
#   doctor       диагностика окружения (пресеты, скрипт, файлы хуков в ~/.claude)
#   version      версия (git SHA) и путь к пакету
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: harness требует python3 (apt install python3 / brew install python3)" >&2
  exit 1
fi
if [[ ! -d "$REPO_ROOT/lib/harness" || ! -d "$REPO_ROOT/configs/claude-code" ]]; then
  echo "ERROR: пакет harness повреждён (нет lib/harness или configs/claude-code) в $REPO_ROOT" >&2
  echo "Если репозиторий переехал — перезапустите install.sh из нового расположения." >&2
  exit 1
fi

usage() { grep '^#' "$SELF" | sed 's/^# \{0,1\}//' | sed -n '2,17p'; }

CMD="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
  -h|--help|help) usage; exit 0 ;;
  version)
    sha="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "harness $sha ($REPO_ROOT)"
    exit 0 ;;
  permissions|apply|mcp|hooks|agent-packs|doctor) ;;
  *) echo "Неизвестная команда: $CMD" >&2; usage >&2; exit 1 ;;
esac

# Корень монорепо (на два уровня выше пакета) даёт пакет `core` (общий фундамент).
# Fallback на standalone-раскладку: если каталога core рядом нет — путь не добавляется.
# (Python-эквивалент — core.repo.find_monorepo_root; здесь фикс. ../.., т.к. core
#  ещё не на PYTHONPATH — осознанный дубль bash-стороны.)
MONOREPO_ROOT="$(cd "$REPO_ROOT/../.." 2>/dev/null && pwd || true)"
[ -d "$MONOREPO_ROOT/core" ] || MONOREPO_ROOT=""
exec env PYTHONPATH="$REPO_ROOT/lib${MONOREPO_ROOT:+:$MONOREPO_ROOT}${PYTHONPATH:+:$PYTHONPATH}" \
  python3 -m harness "$REPO_ROOT" "$CMD" "$@"
