            "chain": "host",
            "levels": [
              "instance",
              "host"
            ],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": false,
            "lockable": true,
            "nullable": false,
            "pack": false,
            "confirm": false,
            "ui": {
