{
  "schema": 1,
  "pack": "python-backend",
  "version": "0.5.3",
  "description": "Dev-loop for Python web-backend (FastAPI/Django/Flask): agents slice-builder/test-writer/reviewer/type-checker(mypy)/spec-writer(opt.), serial one-branch workflow, SubagentStop review-gate (ruff) + PostToolUse-validator. Knowledge of frameworks is in agent prompts (bucket python thin).",
  "stack": {
    "shape": "backend",
    "language": "python",
    "framework": "python",
    "project_type": "python-backend",
    "detect": {
      "any_of": [
        "pyproject.toml",
        "requirements.txt"
      ]
    }
  },
  "requires": {
    "skills": [
      "venv-dependencies",
      "code-simplifier",
      "test-strategy",
      "api-design",
      "data-schema"
    ],
    "harness_presets": [
      "base",
      "python"
    ]
  },
  "interview": [
    {
      "id": "PACK_PREFIX",
      "q": "Agent name prefix/work flow?",
      "default": "{project_dirname}",
      "kind": "slug"
    },
    {
      "id": "PROJECT_DIR",
      "q": "Absolute path to the project?",
      "detect": "pwd"
    },
    {
      "id": "PY_BIN",
      "q": "Python-binary/venv?",
      "detect": "test -x .venv/bin/python && echo .venv/bin/python || command -v python3",
      "default": "python3"
    },
    {
      "id": "PKG_MANAGER",
      "q": "Dependency manager?",
      "detect": "test -f uv.lock && echo uv || (test -f poetry.lock && echo poetry || echo pip)",
      "enum": [
        "uv",
        "poetry",
        "pip"
      ],
      "default": "pip"
    },
    {
      "id": "WEB_FRAMEWORK",
      "q": "Web framework?",
      "detect": "pyproject.toml:project.dependencies",
      "enum": [
        "fastapi",
        "django",
        "flask",
        "none"
      ],
      "default": "fastapi"
    },
    {
      "id": "TEST_RUNNER_CMD",
      "q": "Test team?",
      "default": "{PY_BIN} -m pytest -q"
    },
    {
      "id": "TYPECHECK_CMD",
      "q": "Type check?",
      "default": "{PY_BIN} -m mypy ."
    },
    {
      "id": "LINT_CMD",
      "q": "Lint?",
      "default": "{PY_BIN} -m ruff check ."
    },
    {
      "id": "BASE_BRANCH",
      "q": "Basic branch?",
      "detect": "git symbolic-ref --short refs/remotes/origin/HEAD",
      "default": "main"
    },
    {
      "id": "CHECK_CMD",
      "q": "Fast review-gate check?",
      "default": "{PY_BIN} -m ruff check . && {PY_BIN} -m ruff format --check ."
    },
    {
      "id": "DOCS_DIR",
      "q": "Where to put it guideline (internal AI-guide, not public docs/)?",
      "default": ".claude/guidelines"
    },
    {
      "id": "MODEL_REVIEWER",
      "q": "Model reviewer?",
      "default": "opus",
      "enum": [
        "inherit",
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    {
      "id": "MODEL_TYPE_CHECKER",
      "q": "Model type-checker?",
      "default": "sonnet",
      "enum": [
        "inherit",
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    {
      "id": "MODEL_SLICE_BUILDER",
      "q": "Model slice-builder?",
      "default": "sonnet",
      "enum": [
        "inherit",
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    {
      "id": "MODEL_TEST_WRITER",
      "q": "Model test-writer?",
      "default": "sonnet",
      "enum": [
        "inherit",
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    {
      "id": "MODEL_SPEC_WRITER",
      "q": "Model spec-writer?",
      "default": "sonnet",
      "enum": [
        "inherit",
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    {
      "id": "GATE_COVERAGE_MIN",
      "q": "Min. coating (%)?",
      "default": "80"
    },
    {
      "id": "GATE_MAX_CRITICAL",
      "q": "Acceptable critical-finds?",
      "default": "0"
    }
  ],
  "files": [
    {
      "src": "agents/slice-builder.md",
      "target": ".claude/agents/{PACK_PREFIX}-slice-builder.md",
      "kind": "template",
      "role": "agent"
    },
    {
      "src": "agents/test-writer.md",
      "target": ".claude/agents/{PACK_PREFIX}-test-writer.md",
      "kind": "template",
      "role": "agent"
    },
    {
      "src": "agents/reviewer.md",
      "target": ".claude/agents/{PACK_PREFIX}-reviewer.md",
      "kind": "template",
      "role": "agent"
    },
    {
      "src": "agents/type-checker.md",
      "target": ".claude/agents/{PACK_PREFIX}-type-checker.md",
      "kind": "template",
      "role": "agent"
    },
    {
      "src": "agents/spec-writer.md",
      "target": ".claude/agents/{PACK_PREFIX}-spec-writer.md",
      "kind": "template",
      "role": "agent",
      "optional": true
    },
    {
      "src": "workflows/dev-loop.js",
      "target": ".claude/workflows/{PACK_PREFIX}-dev-loop.js",
      "kind": "template",
      "role": "workflow"
    },
    {
      "src": "hooks/review-gate.sh",
      "target": ".claude/hooks/review-gate.sh",
      "kind": "verbatim",
      "role": "hook",
      "chmod": "+x"
    },
    {
      "src": "hooks/review-gate.env.ini",
      "target": ".claude/review-gate.env.ini",
      "kind": "template",
      "role": "config",
      "user_owned": true
    },
    {
      "src": "hooks/validate-python.sh",
      "target": ".claude/hooks/validate-python.sh",
      "kind": "verbatim",
      "role": "hook",
      "chmod": "+x"
    },
    {
      "src": "settings/settings.fragment.json",
      "target": ".claude/settings.json",
      "kind": "merge",
      "role": "settings",
      "merge": "hooks.SubagentStop[]+hooks.PostToolUse[] append-if-absent"
    },
    {
      "src": "rules/endpoints.md",
      "target": ".claude/rules/endpoints.md",
      "kind": "template",
      "role": "rule"
    },
    {
      "src": "rules/typing.md",
      "target": ".claude/rules/typing.md",
      "kind": "verbatim",
      "role": "rule"
    },
    {
      "src": "rules/tests.md",
      "target": ".claude/rules/tests.md",
      "kind": "template",
      "role": "rule"
    },
    {
      "src": "docs/subagents-and-workflows.md",
      "target": "{DOCS_DIR}/subagents-and-workflows.md",
      "kind": "template",
      "role": "doc"
    },
    {
      "src": "rules/reviewer-overrides.md",
      "target": ".claude/rules/{PACK_PREFIX}-reviewer-overrides.md",
      "kind": "template",
      "user_owned": true,
      "role": "override"
    }
  ],
  "notes": {
    "verify_workflow": "dev-loop.js — top-level return/await, node --check DO NOT apply.",
    "skill_gap": "Bucket python = 2 skill. Canon of frameworks (FastAPI/Django) and pytest — in agent prompts and rules/, without new skills (anti-bloat). Candidate: python/pytest-conventions.",
    "orchestrator": "General orchestrator - pack _common (same PACK_PREFIX)."
  }
}
