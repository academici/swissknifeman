{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "reader-contract",
  "version": "1.0.0",
  "layouts": {
    "v1": "current monolithic executable-plan layout",
    "v2": "target reader-specific projected layout"
  },
  "readers": [
    "designer",
    "executor",
    "auditor",
    "owner"
  ],
  "carriers": [
    {
      "id": "plan-core",
      "path": "plan.md",
      "owner_reader": "designer",
      "also_read_by": ["executor", "auditor", "owner"],
      "mutability": "handwritten",
      "volatility": "stable",
      "volatility_basis": "plan-design writes identity, context, execution rules, and routing before phase execution; item closure does not rewrite this carrier in layout v2",
      "on_path_of": ["designer", "executor", "auditor", "owner"],
      "class": "spec",
      "layout_versions": ["v2"]
    },
    {
      "id": "status-view",
      "path": "status.md",
      "owner_reader": "owner",
      "also_read_by": ["designer", "auditor"],
      "mutability": "generated-file",
      "volatility": "volatile",
      "volatility_basis": "the status projector rewrites this view after every item or phase transition",
      "on_path_of": ["designer", "auditor", "owner"],
      "class": "state",
      "layout_versions": ["v2"]
    },
    {
      "id": "decision-record",
      "path": "decisions/<D-id>.md",
      "owner_reader": "auditor",
      "also_read_by": ["designer", "owner"],
      "mutability": "append-only",
      "volatility": "slow",
      "volatility_basis": "plan-design or the owner appends a decision only at an explicit design or authority boundary; accepted records are not rewritten",
      "on_path_of": ["designer", "auditor"],
      "class": "history",
      "layout_versions": ["v2"]
    },
    {
      "id": "decision-view",
      "path": "decisions/{current,archive,index}.md",
      "owner_reader": "designer",
      "also_read_by": ["auditor", "owner"],
      "mutability": "generated-file",
      "volatility": "slow",
      "volatility_basis": "the decision index projector rewrites views after a decision is appended or superseded",
      "on_path_of": ["designer", "auditor", "owner"],
      "class": "index",
      "layout_versions": ["v2"]
    },
    {
      "id": "phase-index",
      "path": "phases/<Pn>/<Pn>.md",
      "owner_reader": "designer",
      "also_read_by": ["executor", "auditor", "owner"],
      "mutability": "managed-block",
      "volatility": "slow",
      "volatility_basis": "plan-design writes stable phase context at design boundaries while the status projector updates only the delimited index region on item transitions",
      "on_path_of": ["designer", "executor", "auditor", "owner"],
      "class": "index",
      "managed_block_justification": "phase context and its compact generated item index must remain one addressable phase carrier for cold resolution while preserving separate writer ownership",
      "layout_versions": ["v2"]
    },
    {
      "id": "item-spec",
      "path": "phases/<Pn>/<Pn.m>.md",
      "owner_reader": "executor",
      "also_read_by": ["designer", "auditor"],
      "mutability": "handwritten",
      "volatility": "stable",
      "volatility_basis": "plan-design seals an item specification before execution; attempts and closure never rewrite the specification carrier",
      "on_path_of": ["designer", "executor", "auditor"],
      "class": "spec",
      "layout_versions": ["v2"]
    },
    {
      "id": "item-state",
      "path": "phases/<Pn>/<Pn.m>.state.md",
      "owner_reader": "executor",
      "also_read_by": ["designer", "auditor", "owner"],
      "mutability": "generated-file",
      "volatility": "volatile",
      "volatility_basis": "the item-state projector regenerates this file after every attempt and relevant tree change",
      "on_path_of": ["designer", "executor", "auditor", "owner"],
      "class": "state",
      "layout_versions": ["v2"]
    },
    {
      "id": "phase-closure",
      "path": "phases/<Pn>/<Pn>.closure.md",
      "owner_reader": "owner",
      "also_read_by": ["designer", "auditor"],
      "mutability": "generated-file",
      "volatility": "slow",
      "volatility_basis": "the phase closer generates this once at a terminal phase transition and it is unchanged during later phase execution",
      "on_path_of": ["designer", "auditor", "owner"],
      "class": "state",
      "layout_versions": ["v2"]
    },
    {
      "id": "history-view",
      "path": ".plan-cache/history/<Pn.m>.md",
      "owner_reader": "auditor",
      "also_read_by": [],
      "mutability": "generated-file",
      "volatility": "volatile",
      "volatility_basis": "an audit command materializes or regenerates this non-committed view on demand through the selected journal position",
      "on_path_of": ["auditor"],
      "class": "history",
      "layout_versions": ["v2"]
    },
    {
      "id": "journal",
      "path": "journal.jsonl",
      "owner_reader": "auditor",
      "also_read_by": [],
      "mutability": "append-only",
      "volatility": "volatile",
      "volatility_basis": "task commands append an event at each attempt boundary and never rewrite prior events",
      "on_path_of": ["auditor"],
      "class": "history",
      "layout_versions": ["v1", "v2"]
    },
    {
      "id": "handoff",
      "path": "handoff.md",
      "owner_reader": "owner",
      "also_read_by": ["designer", "auditor"],
      "mutability": "handwritten",
      "volatility": "volatile",
      "volatility_basis": "the closing command rewrites the cold-start handoff after every completed or escalated item",
      "on_path_of": ["designer", "auditor", "owner"],
      "class": "state",
      "layout_versions": ["v1", "v2"]
    },
    {
      "id": "brief",
      "path": "brief/**/*.md",
      "owner_reader": "designer",
      "also_read_by": ["auditor", "owner"],
      "mutability": "handwritten",
      "volatility": "stable",
      "volatility_basis": "the owner supplies or explicitly refines the brief before a design pass; item execution does not rewrite it",
      "on_path_of": ["designer", "auditor", "owner"],
      "class": "evidence",
      "layout_versions": ["v1", "v2"]
    },
    {
      "id": "research",
      "path": "research/**/*.md",
      "owner_reader": "designer",
      "also_read_by": ["auditor"],
      "mutability": "handwritten",
      "volatility": "slow",
      "volatility_basis": "plan-design appends synthesized research at a design boundary rather than during routine item closure",
      "on_path_of": ["designer", "auditor"],
      "class": "evidence",
      "layout_versions": ["v1", "v2"]
    },
    {
      "id": "findings",
      "path": "findings/**/*.md",
      "owner_reader": "auditor",
      "also_read_by": ["designer", "executor", "owner"],
      "mutability": "handwritten",
      "volatility": "slow",
      "volatility_basis": "an execution, research, or audit item writes a scoped finding at its explicit boundary; unrelated item closures do not rewrite it",
      "on_path_of": ["designer", "executor", "auditor", "owner"],
      "class": "evidence",
      "layout_versions": ["v1", "v2"]
    },
    {
      "id": "roadmap",
      "path": "roadmap.md",
      "owner_reader": "owner",
      "also_read_by": ["designer", "auditor"],
      "mutability": "generated-file",
      "volatility": "slow",
      "volatility_basis": "plan-design regenerates the roadmap when phase structure or routing changes, not on ordinary item closure",
      "on_path_of": ["designer", "auditor", "owner"],
      "class": "index",
      "layout_versions": ["v1", "v2"]
    },
    {
      "id": "index",
      "path": "index.md",
      "owner_reader": "owner",
      "also_read_by": ["designer", "auditor"],
      "mutability": "generated-file",
      "volatility": "slow",
      "volatility_basis": "the plan index generator rewrites navigation after structural design changes or archival transitions",
      "on_path_of": ["designer", "auditor", "owner"],
      "class": "index",
      "layout_versions": ["v2"]
    },
    {
      "id": "open-questions",
      "path": "open-questions.md",
      "owner_reader": "owner",
      "also_read_by": ["designer", "auditor"],
      "mutability": "handwritten",
      "volatility": "slow",
      "volatility_basis": "plan-design or the owner changes a question only at a decision or authority boundary",
      "on_path_of": ["designer", "auditor", "owner"],
      "class": "state",
      "layout_versions": ["v1", "v2"]
    },
    {
      "id": "bundle",
      "path": "bundles/<Pn.m>.json",
      "owner_reader": "executor",
      "also_read_by": ["designer", "auditor"],
      "mutability": "generated-file",
      "volatility": "slow",
      "volatility_basis": "the bundle builder regenerates the declared input manifest when an item specification or one of its declared inputs changes",
      "on_path_of": ["designer", "executor", "auditor"],
      "class": "index",
      "layout_versions": ["v2"]
    },
    {
      "id": "artifacts",
      "path": "artifacts/**",
      "owner_reader": "executor",
      "also_read_by": ["designer", "auditor", "owner"],
      "mutability": "generated-file",
      "volatility": "slow",
      "volatility_basis": "the owning item generator creates a reproducible artifact at an explicit item boundary; other item closures do not rewrite it",
      "on_path_of": ["designer", "executor", "auditor", "owner"],
      "class": "evidence",
      "layout_versions": ["v1", "v2"]
    },
    {
      "id": "legacy-plan-monolith",
      "path": "plan.md",
      "owner_reader": "designer",
      "also_read_by": ["executor", "auditor", "owner"],
      "mutability": "managed-block",
      "volatility": "volatile",
      "volatility_basis": "in layout v1 plan-design owns stable prose while every item closure rewrites Meta, Status Board, and Update Log in the same file",
      "on_path_of": ["designer", "executor", "auditor", "owner"],
      "class": "spec",
      "managed_block_justification": "layout v1 already mixes stable plan prose and volatile bookkeeping; the target split is implemented only by P2",
      "layout_versions": ["v1"],
      "superseded_by": "plan-core"
    },
    {
      "id": "legacy-phase-monolith",
      "path": "phases/<Pn>.md",
      "owner_reader": "designer",
      "also_read_by": ["executor", "auditor", "owner"],
      "mutability": "managed-block",
      "volatility": "volatile",
      "volatility_basis": "in layout v1 plan-design owns phase and item specifications while each item closure rewrites Phase Status and completion sections in the same file",
      "on_path_of": ["designer", "executor", "auditor", "owner"],
      "class": "spec",
      "managed_block_justification": "layout v1 physically combines stable phase and item specifications with volatile status and completion bookkeeping until P2 migrates it",
      "layout_versions": ["v1"],
      "superseded_by": "phase-index"
    }
  ]
}
