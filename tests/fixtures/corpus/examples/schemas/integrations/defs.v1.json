{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:integrations:defs:v1",
  "title": "Defs",
  "description": "Normative integrations contract; details and semantic validation: spec/modules/integrations.md.",
  "$defs": {
    "hook_subscription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "class": {
          "type": "string",
          "enum": [
            "enforcement",
            "observation",
            "workflow"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "webhook",
            "command",
            "event_sink"
          ]
        },
        "execution_location": {
          "type": "string",
          "enum": [
            "host",
            "control_plane"
          ]
        },
        "event_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "secret": {
                  "$ref": "urn:skm:config:secret-ref:v1"
                },
                "previous_secret": {
                  "anyOf": [
                    {
                      "$ref": "urn:skm:config:secret-ref:v1"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "headers": {
                  "type": "object",
                  "maxProperties": 16,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "url",
                "secret"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "maxItems": 64
                },
                "cwd": {
                  "type": "string",
                  "enum": [
                    "checkout",
                    "state_dir"
                  ]
                },
                "env_allow": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 32
                },
                "env_refs": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "urn:skm:config:secret-ref:v1"
                  }
                }
              },
              "required": [
                "argv"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sink_id": {
                  "type": "string",
                  "not": {
                    "const": "webhook"
                  }
                },
                "config": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "urn:skm:execution:defs:v1#/$defs/json-value"
                  }
                }
              },
              "required": [
                "sink_id",
                "config"
              ]
            }
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "backoff": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "initial_ms": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 600000
                },
                "factor": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10
                },
                "max_ms": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 86400000
                }
              },
              "required": []
            }
          },
          "required": []
        },
        "failure_policy": {
          "type": "string",
          "enum": [
            "deny",
            "warn",
            "retry"
          ]
        }
      },
      "required": [
        "class",
        "kind",
        "execution_location",
        "event_types",
        "target"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            }
          },
          "then": {
            "properties": {
              "execution_location": {
                "const": "host"
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 64
                  },
                  "cwd": {
                    "type": "string",
                    "enum": [
                      "checkout",
                      "state_dir"
                    ]
                  },
                  "env_allow": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 32
                  },
                  "env_refs": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "urn:skm:config:secret-ref:v1"
                    }
                  }
                },
                "required": [
                  "argv"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "execution_location": {
                "const": "control_plane"
              }
            }
          }
        }
      ]
    },
    "hook_event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "enum": [
            "claude_code",
            "codex",
            "cursor",
            "grok"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "session_start",
            "session_end",
            "user_prompt",
            "pre_tool",
            "post_tool",
            "pre_shell",
            "post_shell",
            "subagent_stop",
            "stop",
            "permission_request"
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "type": "string"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_event_name": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "kind",
        "cwd",
        "paths",
        "raw_event_name"
      ]
    }
  },
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.integrations.generated.documents",
      "class": "Defs",
      "kind": "typeddict"
    },
    "typescript": {
      "file": "integrations.ts",
      "name": "Defs"
    }
  }
}
