{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:task:plan:check-evidence:v1",
  "title": "Check evidence",
  "description": "Planner field contract of one check-evidence file passed to finish --evidence or unit accept --evidence. The $schema value stays open: documents of external executors pass without conversion when their key fields match.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema marker of the producer; any non-empty string, for example urn:swissknifeman:task:plan:check-evidence:v1.",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "description": "Optional contract version of the producer; not checked by planner.",
      "minLength": 1
    },
    "evidence_id": {
      "type": "string",
      "description": "Evidence identifier, unique for the producer.",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "description": "Validation check id of the item or unit.",
      "minLength": 1,
      "pattern": "^V[0-9]+$"
    },
    "subject": {
      "type": "string",
      "description": "Qualified item or unit reference, <plan short id>.<item>[/<U#>].",
      "minLength": 1
    },
    "procedure": {
      "type": "object",
      "description": "Exactly one of cmd (an executed command) or procedure (an observed manual procedure).",
      "properties": {
        "cmd": {
          "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/text",
          "description": "Executed command."
        },
        "procedure": {
          "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/text",
          "description": "Observed manual procedure."
        },
        "cwd": {
          "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/path",
          "description": "Command working directory."
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "description": "Candidate revision under validation.",
      "properties": {
        "head": {
          "type": "string",
          "description": "Candidate Git revision, 7-40 lowercase hex characters.",
          "minLength": 1,
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "dirty_digest": {
          "type": "string",
          "description": "SHA-256 of dirty changes and untracked paths.",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "head"
      ],
      "additionalProperties": false
    },
    "exit": {
      "type": "integer",
      "description": "Observed command exit; never recorded for a manual procedure."
    },
    "verdict": {
      "type": "string",
      "description": "Manual procedure verdict; pass maps to 0 and fail to 1.",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "observation": {
      "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/text",
      "description": "What the manual procedure observed; required with verdict."
    },
    "environment": {
      "type": "object",
      "description": "Validation environment.",
      "properties": {
        "platform": {
          "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/text",
          "description": "Execution platform."
        },
        "python": {
          "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/text",
          "description": "Python version."
        },
        "env_digest": {
          "type": "string",
          "description": "SHA-256 of the environment.",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "log": {
      "type": "object",
      "description": "Validation log file and its digest.",
      "properties": {
        "path": {
          "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/path",
          "description": "Validation log path."
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 of the validation log.",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/ts",
      "description": "Validation start timestamp."
    },
    "finished_at": {
      "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/ts",
      "description": "Validation finish timestamp."
    },
    "producer": {
      "type": "object",
      "description": "Who produced the evidence.",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Producer kind.",
          "minLength": 1,
          "enum": [
            "engine",
            "executor",
            "human"
          ]
        },
        "actor": {
          "$ref": "urn:swissknifeman:task:plan:defs:v1#/$defs/actor",
          "description": "Producer identity."
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "evidence_id",
    "check_id",
    "subject",
    "procedure",
    "candidate",
    "started_at",
    "finished_at",
    "producer"
  ],
  "additionalProperties": false
}
