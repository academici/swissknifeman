{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:execution:role-result:triager:v1",
  "title": "TriagerResult",
  "description": "Triage of review findings (document kind triage-result). Every finding of the review appears exactly once in confirmed or rejected (checked by the server: TRIAGE_INCOMPLETE). Rejected blocker/major findings with a reproduction are re-verified read-only (rule TR).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "confirmed",
    "rejected",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "urn:skm:execution:role-result:triager:v1"
    },
    "confirmed": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "decision"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^F[0-9]{1,3}$"
          },
          "decision": {
            "enum": [
              "fix_now",
              "defer"
            ]
          },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "argv",
              "exit",
              "observed"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "exit": {
                "type": "integer"
              },
              "observed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "fix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^F[0-9]{1,3}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "argv",
              "exit",
              "observed"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "exit": {
                "type": "integer"
              },
              "observed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.execution.generated.documents",
      "class": "TriagerResultDoc",
      "kind": "typeddict"
    },
    "typescript": {
      "file": "execution.ts",
      "name": "TriagerResultDoc"
    }
  }
}
