      ]
    },
    {
      "id": "xdemo.flood",
      "title": "Flood",
      "scope": "fleet",
      "effects": [
        "process.spawn"
      ],
      "risk": "low",
      "confirmation": "none",
      "timeout_s": 30,
      "exec": {
        "kind": "argv",
        "argv": [
          "bin/flood"
        ],
        "cwd": "owner"
      }
    },
    {
      "id": "xdemo.hello",
      "title": "Hello",
      "scope": "fleet",
      "effects": [
        "process.spawn"
      ],
      "risk": "low",
      "confirmation": "none",
      "timeout_s": 30,
      "exec": {
        "kind": "invoke"
      },
      "input": [
        {
          "name": "name",
          "title": "Name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "id": "xdemo.broken",
