{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/phase-reentry-justification-v1.schema.json",
  "title": "Task phase re-entry justification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase_id", "trigger", "evidence_ids", "origin_item", "resume_item"],
  "properties": {
    "schema_version": {"const": "phase-reentry-justification/v1"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]+$"},
    "trigger": {"enum": ["owner-decision-change", "terminal-evidence-invalid", "safety-or-authority-boundary"]},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "origin_item": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"},
    "resume_item": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"}
  }
}
