{
  "schema": "urn:skm:planning:specification:v1",
  "title": "Refresh token rotation",
  "goal": "Issue one-time refresh tokens, revoke the whole token family on reuse, and let the web client refresh silently.",
  "context_md": "Today `/auth/refresh` returns a new access token but keeps the same refresh token for 30 days. A leaked refresh token stays valid until expiry. See material `storage-design`.",
  "non_goals": [
    "Changing the access-token format",
    "Single sign-on across products"
  ],
  "rules": [
    "Never log token values; log token family ids only.",
    "Every database change ships with a reversible migration."
  ],
  "brief": {
    "messages": [
      {
        "key": "M1",
        "at": "2026-10-20",
        "channel": "chat",
        "kind": "owner",
        "text": "Refresh tokens must not be reusable. If someone replays an old one, kill the whole session family."
      },
      {
        "key": "M2",
        "at": "2026-10-21T09:30:00Z",
        "channel": "meeting",
        "kind": "record",
        "text": "Security asked for a manual browser check before release."
      }
    ],
    "constraints": [
      "PostgreSQL 16 is the only store."
    ],
    "environment": [
      "Python 3.12 API, TypeScript web client."
    ],
    "out_of_scope": [
      "Mobile clients"
    ]
  },
  "requirements": [
    {
      "id": "0192f5c4-0000-7000-8000-000000000001",
      "key": "R1",
      "statement": "A refresh token that was already used is rejected, and its whole family is revoked.",
      "priority": "must",
      "source": {
        "kind": "brief_message",
        "ref": "M1"
      },
      "owners": [
        "P1.2"
      ]
    },
    {
      "id": "0192f5c4-0000-7000-8000-000000000002",
      "key": "R2",
      "statement": "The web client refreshes the access token silently before it expires.",
      "priority": "should",
      "source": {
        "kind": "owner"
      },
      "owners": [
        "P2.2"
      ]
    },
    {
      "id": "0192f5c4-0000-7000-8000-000000000003",
      "key": "R3",
      "statement": "Security signs off the change after a manual browser check.",
      "priority": "must",
      "source": {
        "kind": "brief_message",
        "ref": "M2"
      },
      "owners": [
        "P2.3"
      ]
    }
  ],
  "phases": [
    {
      "id": "0192f5c4-0000-7000-8000-00000000000a",
      "key": "P1",
      "title": "Token storage and rotation",
      "goal": "Store refresh tokens as one-time records grouped in families and rotate them on every refresh.",
      "contract": {
        "consumes": [
          "existing users table"
        ],
        "produces": [
          "refresh_tokens table",
          "RotationService"
        ],
        "boundaries": [
          "no API shape change in this phase"
        ]
      },
      "scope": {
        "include": [
          "api/src/auth",
          "api/migrations"
        ],
        "exclude": [
          "web"
        ]
      },
      "depends_on": [],
      "pitfalls": [
        "Clock skew between API nodes: compare with database time."
      ],
      "deliverables": [
        "Migration with downgrade",
        "RotationService with tests"
      ],
      "batches": [
        {
          "key": "B1",
          "items": [
            "P1.1",
            "P1.2"
          ],
          "mode": "recommended",
          "note": "Storage first, then the service that uses it."
        }
      ],
      "design_state": "detailed",
      "strategy": "dag"
    },
    {
      "id": "0192f5c4-0000-7000-8000-00000000000b",
      "key": "P2",
      "title": "Client integration and sign-off",
      "goal": "Expose rotation through the API, use it in the web client and get the security sign-off.",
      "scope": {
        "include": [
          "api/src/http",
          "web/src/auth"
        ],
        "exclude": [
          "api/migrations"
        ]
      },
      "assurance": {
        "impact": "All logged-in web sessions refresh through the new endpoint.",
        "seams": [
          "api↔web refresh contract"
        ],
        "live": true
      },
      "batches": [
        {
          "key": "B1",
          "items": [
            "P2.1",
            "P2.2"
          ],
          "mode": "required",
          "note": "The endpoint and the client change ship together."
        },
        {
          "key": "B2",
          "items": [
            "P2.3"
          ],
          "mode": "recommended"
        }
      ],
      "design_state": "detailed"
    }
  ],
