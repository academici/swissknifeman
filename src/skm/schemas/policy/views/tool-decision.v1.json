{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:policy:view:tool-decision:v1",
  "title": "ToolDecisionView",
  "description": "policy owner contract; see the policy module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny",
        "warn"
      ]
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "rule": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0
      }
    },
    "allowlisted": {
      "type": "boolean"
    }
  },
  "required": [
    "outcome",
    "code",
    "rule",
    "reason",
    "warnings",
    "allowlisted"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.policy.generated.views",
      "class": "ToolDecisionView",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "policy.ts",
      "name": "ToolDecisionView"
    }
  }
}
