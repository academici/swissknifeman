{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: its own adapter commands, the few plugin calls the UI needs",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-api-request",
    "allow-api-subscribe",
    "allow-api-unsubscribe",
    "allow-sidecar-status",
    "allow-sidecar-restart",
    "allow-sidecar-log",
    "updater:default",
    "dialog:allow-open",
    "deep-link:default"
  ]
}
