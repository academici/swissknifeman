#!/usr/bin/env bash
# skiller — CLI skill registry (ex. swissknifeman, alias saved). Symlink in ~/.local/bin
# (./install.sh); registry path is derived from readlink -f of the file itself.
#
# Thin launcher: checks the environment and transfers control to the package
# lib/skiller (python3 -m skiller). All logic is in lib/, what
# makes it importable and testable (see tests/, scripts/test.sh).
#
# Commands (are run from the consuming project, the root is looked up from CWD):
#   connect   connect the project via plugin marketplace Claude Code
#   vendor    vendor skills to the project (Cursor and other agents)
#   integrate integration wizard: checklist for all functionality (skills/hooks/memory/hub)
#   update    update connection/vendoring of the current project (--all: all)
#   init      create .swissknifeman/config.json (mode=vendor) — without copying skills
#   sync      vendor-mode: apply .swissknifeman/config.json (physical. transfer + lock)
#   lock      update skills-lock.json project (external skill map: skm + boost)
#   resolve   resolve skill IDs and transitive requirements (read-only; --json)
#   status    report on the current project (read-only)
#   budget    token budget for skill set (⊕ always/↻ on-trigger/⌥ on-demand)
#   eval      behavioral skill run (evals/: with-skill vs baseline, pressure, triggers)
#   analyze-run   analysis of session transcripts: usage/cache by agent, skill-markers
#   bucket-audit  audit buckets: size/overlap/usage → verdicts keep/thin/merge/dead
#   list      registered projects (~/.swissknifeman/projects.json)
#   topology  local environment map (init|show) — ~/.swissknifeman/topology.json
#   release   monorepo release proposal: [Unreleased]+conventional commits → vX.Y.Z
#             (opt --dry-run; does NOT tag/does not push - prints the command)
#
# Maintainer Commands (work with the registry itself):
#   registry  regenerate skills.json + plugin manifests + graph
#   validate  scripts/validate.sh
#   doctor    environment diagnostics
#   version   version (git SHA) and registry path
set -euo pipefail
# --- swissknifeman dev-clone guard (PLAN3 D13; removed at cutover) ---
_skm_guard_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
while [ "$_skm_guard_dir" != "/" ] && [ ! -e "$_skm_guard_dir/.swissknifeman-dev" ]; do _skm_guard_dir="$(dirname "$_skm_guard_dir")"; done
if [ -e "$_skm_guard_dir/.swissknifeman-dev" ] && [ "${SKM_DEV_ALLOW_LIVE:-}" != "1" ]; then
  _skm_real_home="$(python3 -c 'import os, pwd; print(pwd.getpwuid(os.getuid()).pw_dir)' 2>/dev/null || true)"
  if [ -z "$_skm_real_home" ] || [ "$(readlink -f "${HOME:-/}")" = "$(readlink -f "$_skm_real_home")" ]; then
    echo "SKM_DEV_GUARD: $_skm_guard_dir is a development clone; run inside scripts/dev-sandbox.sh or set SKM_DEV_ALLOW_LIVE=1" >&2
    exit 3
  fi
fi
unset _skm_guard_dir _skm_real_home
# --- end dev-clone guard ---

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# PACKAGE Root (the Skiller package): here skills/, lib/, scripts/, buckets.json.
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: skiller requires python3 (apt install python3 / brew install python3)" >&2
  exit 1
fi
if [[ ! -d "$REPO_ROOT/skills" || ! -d "$REPO_ROOT/lib/skiller" ]]; then
  echo "ERROR: registry skiller not found in $REPO_ROOT" >&2
  echo "If the repository has moved, restart install.sh from the new location." >&2
  exit 1
fi

usage() {
  grep '^#' "$SELF" | sed 's/^# \{0,1\}//' | sed -n '8,32p'
}

CMD="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
  -h|--help|help) usage; exit 0 ;;
  validate) exec "$REPO_ROOT/scripts/validate.sh" "$@" ;;
  connect|vendor|integrate|update|init|sync|lock|resolve|status|budget|eval|analyze-run|bucket-audit|list|registry|doctor|topology|release|attest|version|deliver) ;;
  *) echo "Unknown command: $CMD" >&2; usage >&2; exit 1 ;;
esac

# Root monorepo (two levels above the package) gives the package `core` (general foundation).
# Fallback on standalone-layout: if directory core is not nearby - the path is not added.
# (fixed here as ../.. rather than a Python repo-root search, because core
#  not yet PYTHONPATH — conscious take bash-sides.)
MONOREPO_ROOT="$(cd "$REPO_ROOT/../.." 2>/dev/null && pwd || true)"
[ -d "$MONOREPO_ROOT/core" ] || MONOREPO_ROOT=""
exec env PYTHONPATH="$REPO_ROOT/lib${MONOREPO_ROOT:+:$MONOREPO_ROOT}${PYTHONPATH:+:$PYTHONPATH}" \
  python3 -m skiller "$REPO_ROOT" "$CMD" "$@"
