#!/usr/bin/env bash
# academici — единая консоль монорепо: один швейцарский нож над пакетами экосистемы.
# Тонкий роутер: домен → под-бинарник пакета. Под-бинарники (maind/swissknifeman)
# остаются самостоятельными — academici их не заменяет, а сводит в одну точку входа.
#
# Использование:
#   academici maind <cmd> [args]    → packages/maind/bin/maind <cmd>
#   academici skm   <cmd> [args]    → packages/swissknifeman/bin/swissknifeman <cmd>
#   academici <cmd> [args]          → авто-роут по владельцу (если команда уникальна)
#   academici doctor                → сводная диагностика обоих пакетов
#   academici status                → сводный статус обоих пакетов
#   academici help                  → эта справка
#
# Конфликтные команды (есть в обоих: status/doctor/sync) без префикса домена
# обрабатываются academici-сводкой (status/doctor) или требуют префикс (sync).
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
MAIND="$REPO_ROOT/packages/maind/bin/maind"
SKM="$REPO_ROOT/packages/swissknifeman/bin/swissknifeman"

# Команды, уникально принадлежащие пакету (для авто-роута без префикса).
MAIND_CMDS="start memory service graph agents projects namespaces deploy health workspace run fleet onboard migrate mcp"
SKM_CMDS="connect vendor integrate update lock list registry topology"

usage() { grep '^#' "$SELF" | sed 's/^# \{0,1\}//' | sed -n '2,17p'; }

in_list() { local needle="$1"; shift; local x; for x in $*; do [[ "$x" == "$needle" ]] && return 0; done; return 1; }

CMD="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
  -h|--help|help) usage; exit 0 ;;
  version)
    sha="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "academici $sha ($REPO_ROOT)"
    exit 0 ;;

  # явный домен
  maind)         exec "$MAIND" "$@" ;;
  skm|swissknifeman) exec "$SKM" "$@" ;;

  # сводные команды зонтика (конфликтные имена → агрегируем оба пакета)
  doctor)
    echo "=== maind doctor ==="; "$MAIND" doctor "$@" || true
    echo; echo "=== swissknifeman doctor ==="; "$SKM" doctor "$@" || true
    ;;
  status)
    echo "=== maind status ==="; "$MAIND" status "$@" || true
    echo; echo "=== swissknifeman status ==="; "$SKM" status "$@" || true
    ;;
  sync)
    echo "ERROR: 'sync' есть и в maind, и в swissknifeman — уточните домен:" >&2
    echo "  academici maind sync ...   (артефакты хаба)" >&2
    echo "  academici skm   sync ...   (vendor-скиллы)" >&2
    exit 2 ;;

  *)
    # авто-роут уникальной команды
    if in_list "$CMD" "$MAIND_CMDS"; then exec "$MAIND" "$CMD" "$@"; fi
    if in_list "$CMD" "$SKM_CMDS";  then exec "$SKM"  "$CMD" "$@"; fi
    echo "Неизвестная команда: $CMD" >&2; usage >&2; exit 1 ;;
esac
