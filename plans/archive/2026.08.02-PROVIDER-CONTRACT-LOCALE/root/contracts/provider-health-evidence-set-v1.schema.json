{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:provider-health-evidence-set:v1",
  "title": "mAInd provider-health evidence-set input",
  "description": "Frozen public input carrier for maind projects health --evidence-set. Ordering and digest constraints are normative in x-semantic-constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "evidence_set_id",
    "projects",
    "seal"
  ],
  "properties": {
    "schema_version": {
      "const": "provider-health-evidence-set/v1"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "evidence_set_id": {
      "$ref": "#/$defs/safeId"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "axis_id",
        "selected",
        "required",
        "producer"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/safeId"
        },
        "axis_id": {
          "$ref": "#/$defs/safeId"
        },
        "selected": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "producer": {
          "enum": [
            "sealed",
            "skiller",
            "harness",
            "maind"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "axis_id",
        "state",
        "evidence_id",
        "source_id",
        "observed_at",
        "expires_at"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/safeId"
        },
        "axis_id": {
          "$ref": "#/$defs/safeId"
        },
        "state": {
          "enum": [
            "pass",
            "not-selected",
            "not-required",
            "unsupported",
            "unresolved",
            "unknown",
            "error",
            "unavailable"
          ]
        },
        "evidence_id": {
          "$ref": "#/$defs/safeId"
        },
        "source_id": {
          "$ref": "#/$defs/safeId"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "requirements",
        "evidence"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/projectId"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  },
  "x-semantic-constraints": [
    "projects are unique and sorted by project_id",
    "requirements are unique and sorted by (provider_id, axis_id)",
    "evidence rows are sorted by their complete health-evidence tuple",
    "sealed evidence keys are a subset of requirements whose producer is sealed",
    "each project declares both claude-code and codex providers",
    "seal.sha256 equals sha256 of canonical JSON without seal"
  ],
  "x-provenance": {
    "decision": "D85",
    "source": "packages/maind/lib/maind/provider_health.py",
    "source_commit": "568c25ab4b42065a2c61dc6a7dc8aadbb1ad49b0",
    "source_sha256": "c799b609f7817482a41f28a4fb553ec2ab7d9ab9c7e97b488ca9f3b6b4642ab1"
  }
}
