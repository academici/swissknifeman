          }
        },
        "recall_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20,
          "description": "Entries returned by one recall from the private scope.",
          "x-skm": {
            "chain": "work",
            "levels": [
              "instance",
              "workspace",
              "project"
            ],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "ui": {
              "group": "Memory",
              "order": 50,
              "widget": "number"
