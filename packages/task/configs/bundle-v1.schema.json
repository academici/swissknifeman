{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:task:bundle:v1",
  "title": "Plan item input bundle v1",
  "description": "Committed deterministic manifest for one plan item's declared read inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "item_id",
    "provenance",
    "declaration",
    "entries",
    "manifest_sha256"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "bundle_version": {
      "const": "1.0.0"
    },
    "item_id": {
      "type": "string",
      "pattern": "^P[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "generator_version",
        "calibration_id",
        "model_id"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "generator_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "calibration_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "required_reads",
        "sha256"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declarationUnit"
          }
        },
        "required_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declarationUnit"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "declaration_ref",
          "path",
          "selector",
          "sha256",
          "selected_sha256",
          "estimated_tokens"
        ],
        "properties": {
          "declaration_ref": {
            "$ref": "#/$defs/declarationRef"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "selector": {
            "$ref": "#/$defs/selector"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "selected_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declarationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "ordinal"
      ],
      "properties": {
        "field": {
          "enum": [
            "Inputs",
            "Required Reads"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "whole_file"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "anchor"
          ],
          "properties": {
            "kind": {
              "enum": [
                "section",
                "symbol"
              ]
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "declarationUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "raw",
        "path",
        "selector"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        }
      }
    }
  },
  "examples": [
    {
      "$schema": "urn:swissknifeman:task:bundle:v1",
      "bundle_version": "1.0.0",
      "item_id": "P3.1",
      "provenance": {
        "generator": "illustrative-bundle-builder",
        "generator_version": "1.0.0",
        "calibration_id": "illustrative-calibration-v1",
        "model_id": "illustrative-model"
      },
      "declaration": {
        "inputs": [],
        "required_reads": [
          {
            "ordinal": 1,
            "raw": "root/contracts/read-path-v1.md (slot 4)",
            "path": "root/contracts/read-path-v1.md",
            "selector": {
              "kind": "section",
              "anchor": "Executor path and deterministic resolution"
            }
          }
        ],
        "sha256": "1111111111111111111111111111111111111111111111111111111111111111"
      },
      "entries": [
        {
          "declaration_ref": {
            "field": "Required Reads",
            "ordinal": 1
          },
          "path": "root/contracts/read-path-v1.md",
          "selector": {
            "kind": "section",
            "anchor": "Executor path and deterministic resolution"
          },
          "sha256": "2222222222222222222222222222222222222222222222222222222222222222",
          "selected_sha256": "3333333333333333333333333333333333333333333333333333333333333333",
          "estimated_tokens": 123
        }
      ],
      "manifest_sha256": "4444444444444444444444444444444444444444444444444444444444444444"
    }
  ]
}
