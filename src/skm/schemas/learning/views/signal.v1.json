{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:learning:view:signal:v1",
  "title": "SignalView",
  "description": "learning contract; semantics: the learning module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "signal_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "source": {
      "type": "string",
      "enum": [
        "extract"
      ]
    },
    "observed_at": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
    },
    "sessions_known": {
