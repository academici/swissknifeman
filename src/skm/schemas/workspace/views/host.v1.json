{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:workspace:view:host:v1",
  "title": "HostView",
  "description": "workspace view contract from the owning specification.",
  "type": "object",
  "additionalProperties": false,
