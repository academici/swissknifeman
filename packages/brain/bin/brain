#!/usr/bin/env bash
# brain — CLI of the Obsidian vault module.
# Thin launcher: checks the environment and transfers control to the package lib/brain
# (python3 -m brain). All logic is in lib/ (importable and testable: see tests/).
#
# Commands:
#   vault     print the vault path and where it was found (--json, --project DIR)
#   project   print the vault folder of a project (--json, --project DIR)
#   note      subscriber: write a vault note for a planner.plan.closed event (--event FILE|-, --dry-run)
#   doctor    check the vault, the configuration, the notes folder and the subscription (--json)
#   version   print the version and the library path
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: brain requires python3" >&2
  exit 1
fi
if [[ ! -d "$REPO_ROOT/lib/brain" ]]; then
  echo "ERROR: package lib/brain not found in $REPO_ROOT/lib" >&2
  exit 1
fi

# --- aicore locator ---
# Finds the aicore foundation: $AICORE_ROOT, then <module>/_vendor/aicore, then the sibling <module>/../aicore.
# Canonical copy: packages/aicore/scripts/aicore-locator.sh; copies must stay identical.
_aicore_ok() { [ -f "$1/unit.json" ] && grep -q '"id": *"aicore"' "$1/unit.json"; }
if [ -n "${AICORE_ROOT:-}" ]; then
  _aicore_ok "$AICORE_ROOT" || { echo "AICORE_NOT_FOUND: AICORE_ROOT=$AICORE_ROOT is not an aicore checkout" >&2; exit 2; }
elif _aicore_ok "$REPO_ROOT/_vendor/aicore"; then
  AICORE_ROOT="$REPO_ROOT/_vendor/aicore"
elif _aicore_ok "$REPO_ROOT/../aicore"; then
  AICORE_ROOT="$(cd "$REPO_ROOT/../aicore" && pwd)"
else
  echo "AICORE_NOT_FOUND: no aicore in \$AICORE_ROOT, $REPO_ROOT/_vendor/aicore or $REPO_ROOT/../aicore; set AICORE_ROOT" >&2
  exit 2
fi
export AICORE_ROOT
AICORE_LIB="$AICORE_ROOT/lib"
unset -f _aicore_ok
# --- end aicore locator ---

PYTHONPATH="$REPO_ROOT/lib:$AICORE_LIB${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m brain "$@"
