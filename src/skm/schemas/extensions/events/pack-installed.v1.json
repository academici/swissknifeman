{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:extensions:event:pack-installed:v1",
  "title": "PackInstalled",
  "description": "extensions owner contract; see the extensions module.",
  "type": "object",
  "additionalProperties": false,
