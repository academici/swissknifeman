{
  "description": "Hooks registered by people and by skm",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "skm-hook PreToolUse --target codex --surface lifecycle.git_guardrails --project 01928f6e-7a3b-7c41-9d2e-5b8a1f3c4d60"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "skm-hook PreToolUse --target codex --surface lifecycle.pack_guard --project 01928f6e-7a3b-7c41-9d2e-5b8a1f3c4d60"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "skm-hook SessionStart --target codex --surface context.session_start --project 01928f6e-7a3b-7c41-9d2e-5b8a1f3c4d60"
          }
        ]
      }
    ]
  }
}
