{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/phase-assurance-v1.schema.json",
  "title": "Task phase assurance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "impact", "integration_seams", "live_or_irreversible", "audit_intent", "rationale"],
  "properties": {
    "schema_version": {"const": "phase-assurance/v1"},
    "impact": {"enum": ["isolated", "internal-integration", "public-contract", "security-external"]},
    "integration_seams": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}},
    "live_or_irreversible": {"type": "boolean"},
    "audit_intent": {"enum": ["auto", "required", "direct-close-eligible", "legacy-light"]},
    "rationale": {"type": "string", "minLength": 1}
  }
}
