{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:harness:instruction-scopes:v1",
  "title": "instruction-scopes",
  "description": "Output of `harness instructions scopes --json`: the instruction scopes the catalog defines, in catalog order, with the catalog and contract versions a request must carry.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Contract identifier.",
      "const": "urn:swissknifeman:harness:instruction-scopes:v1"
    },
    "scopes": {
      "description": "Scope ids in catalog order; the first is the root scope.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalog_version": {
      "description": "Instruction catalog version.",
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "description": "Instruction request contract version.",
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "$schema",
    "scopes",
    "catalog_version",
    "contract_version"
  ],
  "additionalProperties": false
}
