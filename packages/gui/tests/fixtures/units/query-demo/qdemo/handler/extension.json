{
  "$schema": "urn:swissknifeman:aicore:extension:v1",
  "id": "qdemo-handler",
  "kind": "command",
  "version": "0.2.0",
  "description": "Test handler of the qdemo queries: canned view-data, a wrong view, a failure, a slow answer and an answer that echoes a secret.",
  "protocol": {"min": "1", "max": "1"},
  "entrypoint": ["python3", "handler.py"],
  "provides": {"points": ["gui:query"]},
  "permissions": {"env": ["SKM_TEST_SECRET", "QDEMO_MARKS"]},
  "timeout_seconds": 30,
  "example_input": {"id": "qdemo.metrics", "context": {}, "params": {}}
}
