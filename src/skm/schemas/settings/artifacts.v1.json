            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "ui": {
              "group": "Storage",
              "order": 20,
              "widget": "text"
            }
          }
        }
