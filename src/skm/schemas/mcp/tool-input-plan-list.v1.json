{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-input:plan-list:v1",
  "title": "skm_plan_list input",
  "description": "Input for the skm_plan_list MCP tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "all"
      ],
      "default": "active"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "after": {
      "type": "string"
    }
  }
}
