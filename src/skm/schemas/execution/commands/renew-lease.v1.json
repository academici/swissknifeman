{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:execution:command:renew-lease:v1",
  "title": "RenewLease",
  "description": "Normative execution contract; details and semantic validation: spec/modules/execution.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim": {
      "$ref": "urn:skm:execution:defs:v1#/$defs/worker-claim"
