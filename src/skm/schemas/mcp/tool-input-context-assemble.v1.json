{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-input:context-assemble:v1",
  "title": "skm_context_assemble input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": [
        "scout",
        "executor",
        "reviewer",
        "triager",
        "advisor",
        "researcher",
        "registrar"
      ]
    },
    "runtime_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "context_window_tokens": {
      "type": "integer",
      "minimum": 2000
    }
  },
  "required": [
    "role",
    "runtime_id",
    "model",
    "context_window_tokens"
  ]
}
