{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SKM GUI",
  "version": "0.1.0",
  "identifier": "app.swissknifeman.gui",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SKM GUI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/gui-backend"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["skm-gui"]
      }
    }
  }
}
