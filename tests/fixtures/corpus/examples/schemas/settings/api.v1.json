          "maximum": 256,
          "default": 16,
          "description": "Threads executing bus calls of the API (bootstrap database.pool_max_size must be at least it plus enabled background services and 3).",
          "x-skm": {
            "chain": "host",
            "levels": [
              "instance",
              "host"
            ],
            "merge": "replace",
            "reload": "restart",
            "override": false,
            "sensitivity": "public",
            "portable": false,
            "lockable": true,
            "nullable": false,
            "pack": false,
            "confirm": false,
            "ui": {
              "group": "Server",
              "order": 40,
              "widget": "number"
            }
          }
        }
      }
    },
