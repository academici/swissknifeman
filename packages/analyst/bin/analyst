#!/usr/bin/env bash
# analyst — CLI слоя непрерывного обучения экосистемы academici.
# Тонкий лаунчер: проверяет окружение и передаёт управление пакету lib/analyst
# (python3 -m analyst). Вся логика — в lib/ (импортируемо и тестируемо: см. tests/).
#
# Команды (корень пакета = каталог установки analyst):
#   digest    извлечь кандидат-уроки из run-report прогона (--project ID | --cwd | --session UUID)
#   scan      cross-project паттерны уроков (config.json) → suggestions (namespace-изолированно)
#   review    показать уроки по состояниям + diff против активных (--state S | --project ID)
#   recompute пересчитать confidence из events.ndjson + числовая state-machine (--now | --dry-run)
#   promote   продвинуть урок по конвейеру: ephemeral→candidate→curated (человек в гейте)
#   deprecate демоутнуть урок (soft, не удаляется — аудит)
#   doctor    диагностика окружения
#   version   версия (git SHA) и путь к пакету
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: analyst требует python3 (apt install python3 / brew install python3)" >&2
  exit 1
fi
if [[ ! -d "$REPO_ROOT/lib/analyst" ]]; then
  echo "ERROR: пакет lib/analyst не найден в $REPO_ROOT/lib" >&2
  echo "Пакет повреждён или это старая копия — git pull / перезапустите install.sh." >&2
  exit 1
fi

usage() { grep '^#' "$SELF" | sed 's/^# \{0,1\}//' | sed -n '2,13p'; }

CMD="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
  -h|--help|help) usage; exit 0 ;;
  version)
    sha="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "analyst $sha ($REPO_ROOT)"
    exit 0 ;;
  digest|scan|review|recompute|promote|deprecate|doctor) ;;
  *) echo "Неизвестная команда: $CMD" >&2; usage >&2; exit 1 ;;
esac

# Корень монорепо (на два уровня выше пакета) даёт пакет `core` (общий фундамент).
# Fallback на standalone-раскладку: если каталога core рядом нет — путь не добавляется.
# (Python-эквивалент — core.repo.find_monorepo_root; здесь фикс. ../.., т.к. core
#  ещё не на PYTHONPATH — осознанный дубль bash-стороны.)
MONOREPO_ROOT="$(cd "$REPO_ROOT/../.." 2>/dev/null && pwd || true)"
[ -d "$MONOREPO_ROOT/core" ] || MONOREPO_ROOT=""
exec env PYTHONPATH="$REPO_ROOT/lib${MONOREPO_ROOT:+:$MONOREPO_ROOT}${PYTHONPATH:+:$PYTHONPATH}" \
  python3 -m analyst "$REPO_ROOT" "$CMD" "$@"
