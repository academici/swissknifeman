          "type": "integer",
          "minimum": 65536,
          "maximum": 1073741824,
          "default": 5242880,
          "description": "Bytes scanned as text for secrets; larger content gets the info finding CS-NOT-SCANNED.",
          "x-skm": {
            "chain": "work",
            "levels": [
              "instance"
            ],
            "merge": "replace",
            "reload": "live",
            "override": false,
            "sensitivity": "public",
            "portable": true,
            "lockable": true,
            "nullable": false,
            "pack": true,
            "confirm": false,
            "ui": {
              "group": "Safety",
              "order": 30,
