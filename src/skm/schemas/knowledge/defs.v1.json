        "workspace_id",
        "project_id",
        "repository_id",
        "source",
        "generation",
        "revision",
        "dirty",
        "languages",
        "basis_default",
        "tool_name",
        "tool_version",
        "indexed_at",
        "completeness",
        "limitations",
        "files_indexed",
        "files_skipped",
        "nodes",
        "edges"
