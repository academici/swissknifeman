    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "urn:skm:policy:profile:v1#/$defs/access_capability"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "write_scope",
    "delete_scope",
    "operations",
    "capabilities"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.policy.generated.documents",
      "class": "TaskAuthority",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "policy.ts",
      "name": "TaskAuthority"
    }
  }
}
