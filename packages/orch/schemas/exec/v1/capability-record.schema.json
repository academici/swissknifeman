{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:orch:exec:capability-record:v1",
  "title": "capability-record",
  "type": "object",
  "description": "Engine-neutral capability-record contract.",
  "properties": {
    "current_input_receipt": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
      "description": "Pre-dispatch current API request input receipt acquisition, distinct from completed usage accounting. Missing means unknown. A declared support level alone does not prove an implemented acquisition path or current request admission."
    },
    "$schema": {
      "const": "urn:swissknifeman:orch:exec:capability-record:v1",
      "description": "Schema identifier."
    },
    "contract_version": {
      "const": "exec/v1",
      "description": "Execution contract version."
    },
    "binding": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/binding",
      "description": "Engine binding."
    },
    "provider": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/provider",
      "description": "Provider identifier."
    },
    "cli": {
      "type": "object",
      "description": "CLI identity.",
      "properties": {
        "name": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
          "description": "Native CLI name."
        },
        "version": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
          "description": "Declared CLI version."
        },
        "verified_version": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
          "description": "Verified CLI version."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "declared",
        "probed"
      ],
      "description": "Evidence status."
    },
    "recorded_at": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/ts",
      "description": "Record timestamp."
    },
    "transport": {
      "type": "string",
      "enum": [
        "jsonl",
        "acp",
        "tui",
        "prompt"
      ],
      "description": "Provider transport."
    },
    "auth_route": {
      "type": "string",
      "enum": [
        "subscription_oauth",
        "api_key",
        "gateway",
        "unknown"
      ],
      "description": "Authentication route."
    },
    "model": {
      "type": "object",
      "description": "Model selection and observation support.",
      "properties": {
        "set": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
          "description": "Ability to select the setting."
        },
        "observe": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
          "description": "Ability to observe the effective setting."
        }
      },
      "required": [
        "set",
        "observe"
      ],
      "additionalProperties": false
    },
    "effort": {
      "type": "object",
      "description": "Effort selection and observation support.",
      "properties": {
        "set": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
          "description": "Ability to select the setting."
        },
        "observe": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
          "description": "Ability to observe the effective setting."
        }
      },
      "required": [
        "set",
        "observe"
      ],
      "additionalProperties": false
    },
    "stream": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
      "description": "Stream support."
    },
    "attach": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
      "description": "Attach support."
    },
    "cancel": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
      "description": "Cancel support."
    },
    "resume": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
      "description": "Resume support."
    },
    "usage": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
      "description": "Usage support."
    },
    "plan_write_prevention": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
      "description": "Plan write prevention support."
    },
    "restrictions": {
      "type": "object",
      "description": "Restriction capabilities.",
      "properties": {
        "tools_native": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
          "description": "Native tool restrictions."
        },
        "sandbox_os": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
          "description": "Operating system sandbox support."
        },
        "prompt_only": {
          "type": "boolean",
          "description": "Whether restrictions rely only on the prompt."
        }
      },
      "required": [
        "tools_native",
        "sandbox_os",
        "prompt_only"
      ],
      "additionalProperties": false
    },
    "skill_delivery": {
      "type": "object",
      "description": "Skill delivery capabilities.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "native_plugin_dir",
            "isolated_home",
            "project_dir",
            "profile_skills",
            "prompt_inline",
            "unsupported",
            "unknown"
          ],
          "description": "Skill delivery mode."
        },
        "per_run_isolation": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/support",
          "description": "Isolation of skills per run."
        },
        "notes": {
          "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
          "description": "Skill delivery notes."
        }
      },
      "required": [
        "mode",
        "per_run_isolation"
      ],
      "additionalProperties": false
    },
    "terminal_signal": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
      "description": "Terminal result signal."
    },
    "evidence": {
      "type": "array",
      "description": "Supporting evidence.",
      "items": {
        "type": "object",
        "description": "Supporting evidence.",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "doc",
              "perplexity",
              "probe",
              "code"
            ],
            "description": "Evidence category."
          },
          "ref": {
            "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
            "description": "Evidence reference."
          },
          "note": {
            "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
            "description": "Evidence note."
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object",
      "description": "Open binding-specific extension data."
    },
    "source": {
      "$ref": "urn:swissknifeman:aicore:capability-support:v1#/$defs/source",
      "description": "How the record was obtained: declared, probed or inferred."
    },
    "observed_at": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/ts",
      "description": "When the facts of the record were observed."
    },
    "fresh_until": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/ts",
      "description": "Until when the record can be trusted."
    },
    "remediation": {
      "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
      "description": "What to do to obtain a capability the record reports as unsupported."
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "urn:swissknifeman:orch:exec:defs:v1#/$defs/text",
        "description": "Capability that this record depends on."
      },
      "description": "Capabilities whose availability this record depends on."
    }
  },
  "required": [
    "$schema",
    "contract_version",
    "binding",
    "provider",
    "cli",
    "status",
    "recorded_at",
    "transport",
    "auth_route",
    "model",
    "effort",
    "stream",
    "attach",
    "cancel",
    "resume",
    "usage",
    "restrictions",
    "skill_delivery",
    "plan_write_prevention",
    "terminal_signal",
    "evidence"
  ],
  "additionalProperties": false
}
