{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/repair-decision-v1.schema.json",
  "title": "Task repair decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "item_id", "origin", "original_carrier", "baseline", "candidate", "affected_paths", "bounded_diff", "material_surface", "pre_validation", "post_validation", "evidence_ids", "design"],
  "properties": {
    "schema_version": {"const": "repair-decision/v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "item_id": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"},
    "origin": {"enum": ["validation", "checkpoint", "producer-readiness"]},
    "original_carrier": {"$ref": "#/$defs/carrier"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "affected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "bounded_diff": {"$ref": "#/$defs/diff"},
    "material_surface": {"$ref": "#/$defs/surface"},
    "pre_validation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/carrier"}},
    "post_validation": {"type": "array", "items": {"$ref": "#/$defs/carrier"}},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "design": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/design"}]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "carrier": {"type": "object", "additionalProperties": false, "required": ["command", "digest", "result"], "properties": {"command": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "result": {"enum": ["green", "red"]}}},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["reproduced", "carrier"], "properties": {"reproduced": {"type": "boolean"}, "carrier": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/carrier"}]}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["delta_proved", "evidence_ids"], "properties": {"delta_proved": {"type": "boolean"}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "path": {"type": "object", "additionalProperties": false, "required": ["path", "owner_item", "declared_file"], "properties": {"path": {"type": "string", "minLength": 1}, "owner_item": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"}, "declared_file": {"type": "boolean"}}},
    "diff": {"type": "object", "additionalProperties": false, "required": ["files_changed", "max_files", "reversible"], "properties": {"files_changed": {"type": "integer", "minimum": 0}, "max_files": {"type": "integer", "minimum": 1}, "reversible": {"type": "boolean"}}},
    "surface": {"type": "object", "additionalProperties": false, "required": ["public", "frozen", "security", "schema", "dependency", "authority", "irreversible", "product", "test_topology"], "properties": {"public": {"type": "boolean"}, "frozen": {"type": "boolean"}, "security": {"type": "boolean"}, "schema": {"type": "boolean"}, "dependency": {"type": "boolean"}, "authority": {"type": "boolean"}, "irreversible": {"type": "boolean"}, "product": {"type": "boolean"}, "test_topology": {"type": "boolean"}}},
    "design": {"type": "object", "additionalProperties": false, "required": ["decision_question", "evidence_gap", "alternatives", "expected_artifact"], "properties": {"decision_question": {"type": "string", "minLength": 1}, "evidence_gap": {"type": "string", "minLength": 1}, "alternatives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "expected_artifact": {"type": "string", "minLength": 1}}}
  }
}
