{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Shell(**)",
      "Mcp(*:*)",
      "WebFetch(*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Write(**/.env*)",
      "Write(**/*.key)",
      "Write(**/*.pem)"
    ]
  }
}
