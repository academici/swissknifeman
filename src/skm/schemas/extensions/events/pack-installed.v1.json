      "minLength": 0
    },
    "version": {
      "type": "string",
      "minLength": 0
    },
    "digest": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/digest"
    },
    "trust": {
      "$ref": "urn:skm:extensions:defs:v1#/$defs/pack_trust"
