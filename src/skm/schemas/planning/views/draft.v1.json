{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:planning:view:draft:v1",
  "title": "DraftView",
  "description": "planning owner contract; see the planning module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "draft_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "base_revision_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_revision_no": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "edit_version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "published",
        "abandoned"
      ]
    },
    "created_by": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "created_at": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "updated_at": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
    },
    "stale": {
      "type": "boolean"
    },
    "document": {
      "$ref": "urn:skm:planning:specification:v1"
    },
    "document_digest": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/digest"
    },
    "published_revision_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "closed_at": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "draft_id",
    "base_revision_id",
    "base_revision_no",
    "edit_version",
    "state",
    "created_by",
    "created_at",
    "updated_by",
    "updated_at",
    "stale",
    "document",
    "document_digest",
    "published_revision_id",
    "closed_at"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.planning.generated.views",
      "class": "DraftView",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "planning.ts",
      "name": "DraftView"
    }
  }
}
