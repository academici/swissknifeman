{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:orch:event-data:orch-work-blocked:v1",
  "title": "orch.work.blocked",
  "description": "A piece of work ended blocked.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the run."
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Id of the piece of work (the input id of the work source)."
    },
    "item": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Reference of the piece of work in its plan."
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "description": "Code of the first escalation of the report (QUESTION, REVIEW_LIMIT, PROVIDER_QUOTA, ...)."
    },
    "step": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$",
      "description": "Step that ended blocked."
    }
  },
  "required": [
    "run_id",
    "work_id",
    "code"
  ],
  "additionalProperties": false
}
