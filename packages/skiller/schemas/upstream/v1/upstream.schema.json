{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:skiller:upstream:v1",
  "title": "skiller upstream provenance (upstream.json)",
  "description": "External provenance of a derived skill next to SKILL.md. Runtime validation is scripts/validate.sh. strategy=merge is a skill assembled from two or more sources (origins: one base and at least one supplement) and is synced by hand. strategy=merge requires origins and merge; replace, notify and fork do not.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "strategy",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "The schema_version value."
    },
    "source": {
      "type": "string",
      "enum": [
        "github",
        "http",
        "file"
      ],
      "description": "file — local fixtures only/tests."
    },
    "strategy": {
      "type": "string",
      "enum": [
        "replace",
        "notify",
        "fork",
        "merge"
      ],
      "description": "replace — mirror (autoroll); notify — adapted copy (report); fork — fork with changes (review-gate); merge — composite of ≥2 sources (manual agent-merge)."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "Monitored mirror files with integrity.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "url",
          "sha256",
          "fetched_at"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "The path value."
          },
          "url": {
            "type": "string",
            "description": "The url value."
          },
          "sha256": {
            "type": "string",
            "description": "The sha256 value."
          },
          "fetched_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "The fetched_at value."
          }
        },
        "additionalProperties": false
      }
    },
    "fork": {
      "type": "object",
      "description": "Gate fork: review_pending=true blocks propagation until the diff is manually transferred.",
      "properties": {
        "review_pending": {
          "type": "boolean",
          "description": "The review_pending value."
        },
        "last_review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The last_review value."
        }
      },
      "additionalProperties": false
    },
    "review_pending": {
      "type": "boolean",
      "description": "Compatibility: gate fork can also lie flat."
    },
    "last_review": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The last_review value."
    },
    "origins": {
      "type": "array",
      "minItems": 2,
      "description": "Only for strategy=merge: composite sources with roles. Exactly one base + ≥1 supplement.",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "role",
          "url",
          "sha256",
          "fetched_at"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "description": "Source, e.g. 'antfu/skills'."
          },
          "role": {
            "type": "string",
            "enum": [
              "base",
              "supplement"
            ],
            "description": "base — is taken as a basis; supplement — complementary source-«suggest»."
          },
          "url": {
            "type": "string",
            "description": "The url value."
          },
          "ref": {
            "type": "string",
            "description": "Thread/tag/commit (optional)."
          },
          "sha256": {
            "type": "string",
            "description": "The sha256 value."
          },
          "fetched_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "The fetched_at value."
          },
          "note": {
            "type": "string",
            "description": "Which is taken from the source."
          },
          "suggest": {
            "type": "string",
            "description": "Hint: than supplement added base."
          }
        },
        "additionalProperties": false
      }
    },
    "merge": {
      "type": "object",
      "description": "Gate merge: on the drift of any origin review_pending=true blocks validate/registry/release before manual re-merge agent.",
      "properties": {
        "review_pending": {
          "type": "boolean",
          "description": "The review_pending value."
        },
        "last_review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The last_review value."
        }
      },
      "additionalProperties": false
    },
    "body_path": {
      "type": "string",
      "description": "P7.3 thin-navigator: path (regarding the skill catalog, from files[].path) to a file with a real upstream body - when SKILL.md became a locally written thin navigator, and NOT a mirror of the upstream (e.g. 'references/full.md'). scripts/update-upstreams.sh thinks sha/drift on THIS file (files[]-entry below this path), and not by SKILL.md. Additive field; absence = body in SKILL.md (back-compat, old behavior). Orthogonal strategy: is most often used with notify/replace (y fork/merge already plays the same role files[].path on pristine-mirror, specifying both is redundant)."
    },
    "notes": {
      "type": "string",
      "description": "The notes value."
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "description": "replace, notify and fork do not require origins or merge.",
      "properties": {
        "strategy": {
          "enum": ["replace", "notify", "fork"],
          "description": "A strategy other than merge."
        }
      }
    },
    {
      "description": "strategy=merge requires origins and merge.",
      "properties": {
        "strategy": {
          "const": "merge",
          "description": "Composite of two or more sources."
        }
      },
      "required": ["origins", "merge"]
    }
  ]
}
