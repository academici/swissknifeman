{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:config:secret-ref:v1",
  "title": "SecretRef",
  "description": "Reference to a secret, never the secret itself. secret://env/NAME, secret://file/<absolute-or-~-path>, secret://keyring/<service>/<name>.",
  "type": "string",
  "pattern": "^secret://(env/[A-Z_][A-Z0-9_]{0,127}|file/[^\\s]{1,1024}|keyring/[A-Za-z0-9._-]{1,128}/[A-Za-z0-9._@-]{1,128})(?![\\s\\S])",
  "examples": [
    "secret://env/SKM_DATABASE_URL",
    "secret://file/~/.local/state/skm/secrets/token-pepper",
    "secret://keyring/skm-prod/api-token"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.platform.config.generated",
      "class": "SecretRefText",
      "kind": "alias"
    }
  }
}
