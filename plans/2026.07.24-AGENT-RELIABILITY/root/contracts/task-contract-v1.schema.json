{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-contract-v1",
  "title": "Task Contract v1",
  "description": "Sealed checked contract compiled before any mutation and before any final response. Generated/validated state with provenance, not a narrative SSOT. Owner item: 2026.07.24-AGENT-RELIABILITY P0.2 (D5/D8/D26/D30).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "version",
    "goal",
    "must",
    "never",
    "done",
    "authority",
    "next",
    "route",
    "evidence",
    "portability",
    "conflicts",
    "slice",
    "cold_start"
  ],
  "properties": {
    "schema_version": {"const": "task-contract/v1"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "version": {"$ref": "#/$defs/version"},
    "goal": {"$ref": "#/$defs/goal"},
    "must": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/must_entry"}},
    "never": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/never_entry"}},
    "done": {"$ref": "#/$defs/done"},
    "authority": {"$ref": "#/$defs/authority"},
    "next": {"$ref": "#/$defs/next"},
    "route": {"$ref": "#/$defs/route"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_entry"}},
    "portability": {"$ref": "#/$defs/portability"},
    "conflicts": {"type": "array", "minItems": 0, "items": {"$ref": "#/$defs/conflict_entry"}},
    "slice": {"$ref": "#/$defs/slice"},
    "cold_start": {"$ref": "#/$defs/cold_start"}
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "content_hash", "supersedes"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "supersedes": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "non_goals"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "must_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "source_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^M[0-9]+$"},
        "requirement": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "never_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prohibition", "source_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^N[0-9]+$"},
        "prohibition": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_acceptance"],
      "properties": {
        "public_acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "predicate", "scope", "check", "evidence_ref"],
            "properties": {
              "id": {"type": "string", "pattern": "^A[0-9]+$"},
              "predicate": {"type": "string", "minLength": 1},
              "scope": {"enum": ["public", "internal"]},
              "check": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "pattern": "^E[0-9]+$"}
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "granted", "granted_by", "auto_allowed", "stop_boundaries", "loop_budget", "observed_rounds"],
      "properties": {
        "class": {"enum": ["routine", "owner-gate"]},
        "granted": {"type": "boolean"},
        "granted_by": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "auto_allowed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "stop_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "loop_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audit_rounds_max", "same_finding_max"],
          "properties": {
            "audit_rounds_max": {"type": "integer", "minimum": 1},
            "same_finding_max": {"type": "integer", "minimum": 1}
          }
        },
        "observed_rounds": {"type": "integer", "minimum": 0}
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "carrier", "context", "origin", "changed_by"],
      "properties": {
        "form": {
          "enum": [
            "exec-items",
            "run-items",
            "audit-design",
            "design-phase",
            "design-item",
            "audit-phase",
            "close",
            "archive",
            "terminal",
            "manual",
            "waiting"
          ]
        },
        "carrier": {"type": "string", "minLength": 1},
        "context": {"enum": ["same-session — item", "cold-start — orchestration", "cold-start — plan-step"]},
        "origin": {"enum": ["approved-goal", "typed-finding", "diagnostic"]},
        "changed_by": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["finding_id", "transition"],
              "properties": {
                "finding_id": {"type": "string", "minLength": 1},
                "transition": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "actual", "capabilities"],
      "properties": {
        "required": {"$ref": "#/$defs/route_pair"},
        "actual": {"$ref": "#/$defs/route_pair"},
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "support"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "support": {"enum": ["native", "adapted", "unsupported", "unknown"]}
            }
          }
        }
      }
    },
    "route_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_class", "effort"],
      "properties": {
        "model_class": {"enum": ["economy", "implementation", "frontier"]},
        "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]}
      }
    },
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "proof_class", "algorithm"],
      "properties": {
        "id": {"type": "string", "pattern": "^E[0-9]+$"},
        "path": {"type": "string", "minLength": 1},
        "proof_class": {"enum": ["recomputed", "cross-checked", "pinned-not-recomputable", "unknown"]},
        "algorithm": {"type": "string", "minLength": 1}
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "execution_inputs", "provenance_only", "privacy", "semantic_carrier", "provider_renderers"],
      "properties": {
        "tier": {"enum": ["brief-acceptance", "committed-bundle"]},
        "execution_inputs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "producer"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "kind": {"enum": ["committed", "produced-by-predecessor"]},
              "producer": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
            }
          }
        },
        "provenance_only": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimized", "excluded_classes"],
          "properties": {
            "minimized": {"type": "boolean"},
            "excluded_classes": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "semantic_carrier": {"type": "string", "minLength": 1},
        "provider_renderers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude", "codex"],
          "properties": {
            "claude": {"type": "string", "minLength": 1},
            "codex": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "conflict_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "winner", "loser", "rule", "resolution", "question"],
      "properties": {
        "id": {"type": "string", "pattern": "^C[0-9]+$"},
        "winner": {"$ref": "#/$defs/carrier_ref"},
        "loser": {"$ref": "#/$defs/carrier_ref"},
        "rule": {
          "enum": [
            "latest-owner-instruction-in-scope",
            "narrow-safety-never-widen-authority",
            "frozen-contract-wins",
            "typed-finding-transition"
          ]
        },
        "resolution": {"enum": ["resolved", "unknown"]},
        "question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "carrier_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "carrier_class"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "carrier_class": {
          "enum": [
            "owner-instruction",
            "plan-decision",
            "item-spec",
            "package-canon",
            "handoff-carrier",
            "incidental-diagnostic"
          ]
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subagent_keys", "root_only_keys"],
      "properties": {
        "subagent_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "root_only_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "cold_start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "item_id", "reads", "carrier"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "reads": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]+$"}},
        "carrier": {"type": "string", "minLength": 1}
      }
    }
  }
}
