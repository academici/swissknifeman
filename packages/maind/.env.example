# agent-memory (Node-demon) — ports/URL node. Copy to .env and adjust it to suit you.
# These values ​​override the port from config/memory/iii-config.yaml And .maind.json —
# set separate ports, so as not to conflict with another node (For example Brain).
AGENTMEMORY_PORT=4111
AGENTMEMORY_STREAM_PORT=4112
AGENTMEMORY_VIEWER_PORT=4113
AGENTMEMORY_URL=http://127.0.0.1:4111
AGENTMEMORY_III_CONFIG=config/memory/iii-config.yaml

# LLM — optional. Enables compression/memory summarization.
# ANTHROPIC_API_KEY=
