{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:task:plan:read-catalog:v1",
  "title": "Read catalog",
  "type": "object",
  "description": "Parser-derived plan API catalog. No plan is loaded and no file is written.",
  "properties": {
    "verbs": {
      "type": "array",
      "description": "Every CLI verb, sorted by name.",
      "items": {
        "type": "object",
        "description": "One verb from the live parser, with its explicit output and refusal contracts.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Verb name.",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "description": "English description from the parser.",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "description": "Default invocation mode; mixed mutation verbs are write. Output files and read-only flags are documented separately.",
            "enum": [
              "read",
              "write"
            ]
          },
          "args": {
            "type": "array",
            "description": "Global and verb parser arguments, in parser order.",
            "items": {
              "type": "object",
              "description": "One parser argument; group metadata describes alternative required inputs.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Primary option spelling or positional argument name.",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean",
                  "description": "Whether this individual argument is required."
                },
                "help": {
                  "type": "string",
                  "description": "Parser help, or an empty string when the parser does not provide help."
                },
                "scope": {
                  "type": "string",
                  "description": "Global options precede the verb; verb arguments follow it.",
                  "enum": [
                    "global",
                    "verb"
                  ]
                },
                "nargs": {
                  "type": [
                    "integer",
                    "string"
                  ],
                  "description": "Number of values, or an argparse cardinality marker such as ?, + or *."
                },
                "aliases": {
                  "type": "array",
                  "description": "Other accepted option spellings, including negative boolean flags.",
                  "items": {
                    "type": "string"
                  }
                },
                "choices": {
                  "type": "array",
                  "description": "Allowed parser values, when constrained.",
                  "items": {
                    "type": "string"
                  }
                },
                "exclusive_with": {
                  "type": "array",
                  "description": "Mutually exclusive argument names.",
                  "items": {
                    "type": "string"
                  }
                },
                "required_group": {
                  "type": "boolean",
                  "description": "When true, one argument of this exclusive group must be supplied."
                }
              },
              "required": [
                "name",
                "required",
                "help",
                "scope",
                "nargs"
              ],
              "additionalProperties": false
            }
          },
          "data_kind": {
            "type": "string",
            "description": "Dedicated plan/v1 data schema, when available. schema uses read-catalog for --verbs/default; <kind> returns the schema itself. Legacy polymorphic outputs have no plan/v1 data kind.",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "errors": {
            "type": "array",
            "description": "Conservative registered refusal codes; IO_ERROR and USAGE are shared CLI errors.",
            "items": {
              "type": "string",
              "description": "One stable refusal code.",
              "enum": [
                "ACCEPT_REQUIRED",
                "ACTOR_REQUIRED",
                "AGENT_REQUIRED",
                "ALREADY_ARCHIVED",
                "ARCHIVE_EXISTS",
                "ATTEMPT_CONFLICT",
                "ATTEMPT_ID_INVALID",
                "BRIDGE_INVALID",
                "BRIDGE_UNKNOWN",
                "BRIDGE_VERB_UNKNOWN",
                "BY_INVALID",
                "CHECKS_MISSING",
                "CHECKS_RED",
                "CHECK_UNKNOWN",
                "CONTENT_INVALID",
                "DECISION_NOT_ACCEPTED",
                "DECISION_NOT_OPEN",
                "DECISION_REQUIRED",
                "DECISION_SELF_SUPERSEDE",
                "DECISION_SUPERSEDED",
                "DEPENDENCY_NOT_READY",
                "DEPTH_INVALID",
                "DESIGN_INCOMPLETE",
                "DEVIATION_REQUIRED",
                "DIRECTION_INVALID",
                "ESCALATION_REQUIRED",
                "EVIDENCE_CONFLICT",
                "EVIDENCE_INVALID",
                "EVIDENCE_REQUIRED",
                "EVIDENCE_SUBJECT",
                "EXTERNAL_GATE",
                "FIELD_NOT_ARRAY",
                "FIELD_OWNED",
                "FIELD_UNKNOWN",
                "GATE_INVALID",
                "GATE_NOT_GRANTED",
                "GATE_UNKNOWN",
                "HUMAN_VIEW",
                "ID_DUPLICATE",
                "IO_ERROR",
                "ITEMS_DUPLICATE",
                "ITEMS_REQUIRED",
                "ITEMS_SPAN_PHASES",
                "ITEM_NOT_IN_PROGRESS",
                "ITEM_NOT_STARTABLE",
                "KIND_UNKNOWN",
                "LIMIT_INVALID",
                "LINK_INVALID",
                "LOG_INVALID",
                "LOG_TYPE_INVALID",
                "MESSAGE_REQUIRED",
                "MINUTES_INVALID",
                "NOTES_REQUIRED",
                "NOTE_REQUIRED",
                "NOT_STARTED",
                "NOT_TERMINAL",
                "OPTION_UNKNOWN",
                "PARALLEL_LIMIT",
                "PATCH_INVALID",
                "PATH_INVALID",
                "PHASE_NOT_DETAILED",
                "PLAN_AMBIGUOUS",
                "PLAN_CODENAME_INVALID",
                "PLAN_DATE_INVALID",
                "PLAN_EXISTS",
                "PLAN_INVALID",
                "PLAN_LOCKED",
                "PLAN_NOT_DONE",
                "PLAN_NOT_FOUND",
                "RATIONALE_REQUIRED",
                "READ_MISSING",
                "REASON_REQUIRED",
                "REF_INVALID",
                "REF_QUALIFIED",
                "REF_UNKNOWN",
                "REPO_UNKNOWN",
                "ROUTE_MISMATCH",
                "ROUTE_UNDERSHOOT",
                "ROUTING_UNAVAILABLE",
                "SCHEMA_INVALID",
                "SECTION_UNKNOWN",
                "SINCE_INVALID",
                "STATUS_INVALID",
                "UNITS_OPEN",
                "UNIT_DEPENDENCY",
                "UNIT_INVALID",
                "UNIT_SELF",
                "UNIT_STATE",
                "USAGE",
                "VERB_FAILED"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "summary",
          "mode",
          "args",
          "errors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verbs"
  ],
  "additionalProperties": false
}
