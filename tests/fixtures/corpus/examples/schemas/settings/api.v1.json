    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_body_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864,
          "default": 1048576,
          "description": "Largest JSON request body; byte uploads use artifacts.upload.max_bytes.",
          "x-skm": {
            "chain": "work",
            "levels": [
              "instance"
            ],
            "merge": "replace",
            "reload": "live",
            "override": false,
