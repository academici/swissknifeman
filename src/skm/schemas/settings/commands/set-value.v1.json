{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:settings:command:set-value:v1",
  "title": "SetValue",
  "description": "settings command contract from the owning specification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope": {
      "$ref": "urn:skm:config:entry:v1#/$defs/scope_ref"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
    },
    "expected_row_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 2000,
      "default": ""
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "value": {
      "description": "JSON value; value-specific validation belongs to the owner."
    },
    "mode": {
      "type": "string",
      "enum": [
        "set",
        "append"
      ],
      "default": "set"
    },
    "locked": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "scope",
    "key",
    "value"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.settings.generated.commands",
      "class": "SetValue",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "settings.ts",
      "name": "SetValue"
    }
  }
}
