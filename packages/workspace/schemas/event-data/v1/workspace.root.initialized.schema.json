{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:workspace:event-data:workspace-root-initialized:v1",
  "title": "workspace.root.initialized",
  "description": "A workspace was created on this machine.",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z]([a-z0-9]|-(?=[a-z0-9])){0,39}$",
      "description": "Code of the workspace."
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Id of the workspace."
    }
  },
  "required": [
    "code",
    "workspace_id"
  ],
  "additionalProperties": false
}
