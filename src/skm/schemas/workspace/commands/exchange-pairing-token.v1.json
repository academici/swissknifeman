{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:workspace:command:exchange-pairing-token:v1",
  "title": "ExchangePairingToken",
  "description": "Exchange a single-use pairing secret in the workspace where it was issued.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "pairing_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "pairing_secret": {
      "type": "string",
      "pattern": "^skm_pair_[A-Za-z0-9_-]{43}$",
      "x-skm-secret": true
    }
  },
  "required": [
    "workspace_id",
    "pairing_id",
    "pairing_secret"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.workspace.generated.commands",
      "class": "ExchangePairingToken",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "workspace.ts",
      "name": "ExchangePairingToken"
    }
  }
}
