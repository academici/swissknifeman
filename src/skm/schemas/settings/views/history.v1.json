{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:settings:view:history:v1",
  "title": "HistoryView",
  "description": "settings view contract from the owning specification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
