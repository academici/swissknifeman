{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:planner:event-data:planner-plan-closed:v1",
  "title": "planner.plan.closed",
  "description": "Data of the planner.plan.closed event. A plan was closed: every phase is closed and none is blocked.",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Id of the plan the event belongs to.",
      "minLength": 1
    },
    "short_id": {
      "type": "string",
      "description": "Short id of the plan such as PLAN7.",
      "pattern": "^PLAN[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "description": "Title of the plan.",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "description": "Repository the plan belongs to.",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Final status of the plan.",
      "enum": [
        "done"
      ]
    },
    "goal": {
      "type": "string",
      "description": "Goal of the plan.",
      "minLength": 1
    },
    "closed_at": {
      "type": "string",
      "description": "When the plan was closed (RFC 3339).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "phases": {
      "type": "array",
      "description": "The closed phases in plan order.",
      "items": {
        "type": "object",
        "description": "One phase.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Phase id.",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "description": "Phase title.",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "description": "Closure result of the phase.",
            "enum": [
              "done",
              "done_with_deviations",
              "blocked",
              "skipped"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "description": "Number of items by final status.",
      "properties": {
        "items": {
          "type": "integer",
          "description": "All items of the plan.",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "description": "Items done.",
          "minimum": 0
        },
        "done_with_deviations": {
          "type": "integer",
          "description": "Items done with deviations.",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "description": "Items skipped by decision.",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "description": "Items blocked.",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "description": "References to the artifacts of the plan.",
      "items": {
        "$ref": "urn:swissknifeman:aicore:artifact-ref:v1"
      }
    }
  },
  "required": [
    "plan_id",
    "title",
    "status"
  ],
  "additionalProperties": false
}
