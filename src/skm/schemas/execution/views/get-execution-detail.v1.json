{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:execution:view:get-execution-detail:v1",
  "title": "ExecutionDetailView",
  "description": "Run ownership and detail metadata for execution pages.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "workspace_id": {
