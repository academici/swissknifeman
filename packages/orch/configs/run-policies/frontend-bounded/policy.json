{
  "$schema": "urn:swissknifeman:orch:exec:run-policy:v1",
  "contract_version": "exec/v1",
  "policy_id": "frontend-bounded",
  "description": "A frontier primary stage and a bounded implementer on an economy model for a closed scope, then checks and registration.",
  "stages": [
    {
      "id": "context",
      "kind": "context",
      "role": "deterministic",
      "required": true,
      "on_unavailable": "refuse"
    },
    {
      "id": "scout",
      "kind": "scout",
      "role": "scout",
      "required": true,
      "on_unavailable": "refuse",
      "model_class": "economy"
    },
    {
      "id": "primary",
      "kind": "primary",
      "role": "executor",
      "required": true,
      "on_unavailable": "refuse",
      "model_class": "frontier"
    },
    {
      "id": "bounded",
      "kind": "bounded",
      "role": "bounded-implementer",
      "required": true,
      "on_unavailable": "refuse",
      "model_class": "economy"
    },
    {
      "id": "checks",
      "kind": "checks",
      "role": "deterministic",
      "required": true,
      "on_unavailable": "refuse"
    },
    {
      "id": "registrar",
      "kind": "registrar",
      "role": "deterministic",
      "required": true,
      "on_unavailable": "refuse"
    }
  ],
  "review": {
    "enabled": false,
    "independent_provider": false,
    "max_rounds": 2,
    "max_corrections": 1
  },
  "retries_budget": {
    "total_max": 1
  },
  "git_action": "none",
  "finalize": {
    "kind": "deterministic",
    "register": true
  },
  "version": "1.0.0"
}
