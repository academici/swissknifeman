{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:access:view:principal:v1",
  "title": "PrincipalView",
  "description": "access view contract from the owning specification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "principal_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "kind": {
      "$ref": "urn:skm:access:defs:v1#/$defs/principal_kind"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "created_at": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
    },
    "row_version": {
      "type": "integer",
      "minimum": 1
    },
    "identities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "issuer",
          "subject"
        ]
      }
    }
  },
  "required": [
    "principal_id",
    "kind",
    "display_name",
    "state",
    "created_at",
    "row_version",
    "identities"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.access.generated.views",
      "class": "PrincipalView",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "access.ts",
      "name": "PrincipalView"
    }
  }
}
