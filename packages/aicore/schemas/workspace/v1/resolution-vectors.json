{
 "$schema": "urn:swissknifeman:aicore:workspace-resolution-vectors:v1",
 "description": "Vectors of the plan-store resolution rule. `op` is `resolve` (resolve_plans_store(project_root)) or `source_root` (source_root_of(plan_dir, launcher=)). `files` maps a path relative to a fresh temporary directory to its text; `{tmp}` in files, env and paths is that directory (real path). `env` is the whole environment of the call. `expect`: for `resolve` {kind, plans_root, project_id, reason} or {error: code}; for `source_root` {source_root: path or null} or {error: code}.",
 "vectors": [
  {
   "name": "no marker: legacy plans folder",
   "op": "resolve",
   "files": {
    "proj/plans/p1/plan.json": "{}\n"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "kind": "legacy",
    "plans_root": "{tmp}/proj/plans",
    "project_id": null,
    "reason": "no-marker"
   }
  },
  {
   "name": "marker legacy: legacy plans folder",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"legacy\"\n}\n"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "kind": "legacy",
    "plans_root": "{tmp}/proj/plans",
    "project_id": "billium",
    "reason": "marker-legacy"
   }
  },
  {
   "name": "marker workspace and the project folder exists",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n",
    "home/data/workspaces/axioma/projects/billium/plans/p1/plan.json": "{}\n"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "kind": "workspace",
    "plans_root": "{tmp}/home/data/workspaces/axioma/projects/billium/plans",
    "project_id": "billium",
    "reason": "marker-workspace"
   }
  },
  {
   "name": "marker workspace and the project folder is missing",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "error": "WORKSPACE_PROJECT_MISSING"
   }
  },
  {
   "name": "marker workspace: a plans file instead of the folder counts as missing",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"workspace\"\n}\n",
    "home/data/workspaces/axioma/projects/billium/plans": "x"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "error": "WORKSPACE_PROJECT_MISSING"
   }
  },
  {
   "name": "invalid marker: not JSON",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{not json"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "error": "PROJECT_MARKER_INVALID"
   }
  },
  {
   "name": "invalid marker: not an object",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "[]\n"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
    "error": "PROJECT_MARKER_INVALID"
   }
  },
  {
   "name": "invalid marker: unknown plans_store",
   "op": "resolve",
   "files": {
    "proj/.swissknifeman/project.json": "{\n  \"$schema\": \"urn:swissknifeman:aicore:project-marker:v1\",\n  \"workspace\": \"axioma\",\n  \"project_id\": \"billium\",\n  \"plans_store\": \"cloud\"\n}\n"
   },
   "env": {
    "SKM_HOME": "{tmp}/home"
   },
   "project_root": "{tmp}/proj",
   "expect": {
