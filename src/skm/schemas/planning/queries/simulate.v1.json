{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:planning:query:simulate:v1",
  "title": "Simulate",
  "description": "Estimate one model call per implementation task on a pinned plan source.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "revision_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "draft_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "expected_edit_version": {
      "type": "integer",
      "minimum": 1
    },
    "tokens_per_second": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "description": "Assumed effective input and output token throughput for one model call."
    }
  },
  "required": [
    "plan_id"
  ],
  "oneOf": [
    {
      "required": [
        "revision_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "draft_id"
            ]
          },
          {
            "required": [
              "expected_edit_version"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "draft_id",
        "expected_edit_version"
      ],
      "not": {
        "required": [
          "revision_id"
        ]
      }
    }
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.planning.generated.queries",
      "class": "Simulate",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "planning.ts",
      "name": "Simulate"
    }
  }
}
