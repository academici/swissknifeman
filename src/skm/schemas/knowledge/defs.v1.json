        "message": {
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "count"
      ]
    },
    "GraphIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
