{
  "schema_version": "ecosystem-units/v1",
  "_doc": "Hub map of the module split, read by scripts/ecosystem-units.py. targets: final module ids; module_aliases: current folder id -> target id; retired: folders without unit.json that are being removed; foundation: the shared base module and the names its code is imported under today; transitional_roots: root-level trees still being moved; standalone: foundation_paths (tracked paths copied next to vendor/<id> as the foundation stand-in), unset_env, timeout_s per command; version_sources: where the version of each module is read from (unit.json must equal it); ownership: files that move to another module (longest path wins); path_patterns: regexes with a named group 'target' that find paths of other folders in module files (climb: count only ../ runs that leave the module); path_suffixes: file suffixes scanned for path patterns; path_allow: files exempt from the path patterns, each with a reason.",
  "targets": [
    "aicore",
    "skiller",
    "planner",
    "orch",
    "maind",
    "analyst",
    "harness",
    "brain",
    "bridges/planner-orch",
    "bridges/orch-skiller",
    "bridges/orch-harness",
    "hub",
    "retired"
  ],
  "module_aliases": {
    "task": "planner"
  },
  "retired": [
    "artifex"
  ],
  "foundation": {
    "id": "aicore",
    "aliases": [
      "core"
    ]
  },
  "transitional_roots": [
    "core/",
    "orch/",
    "packages/artifex/",
    "packages/task/"
  ],
  "version_sources": {
    "analyst": {"path": "packages/analyst/package.json", "read": "json:version"},
    "harness": {"path": "packages/harness/package.json", "read": "json:version"},
    "maind": {"path": "packages/maind/package.json", "read": "json:version"},
    "orch": {"path": "packages/orch/lib/orch/__init__.py", "read": "python:__version__"},
    "skiller": {"path": "packages/skiller/package.json", "read": "json:version"},
    "task": {"path": "packages/task/.claude-plugin/plugin.json", "read": "json:version"}
  },
  "path_patterns": [
    {"id": "sibling-package", "regex": "packages/(?P<target>[a-z][a-z0-9-]*)/", "reason": "a module must not name another module's folder; use a bridge or an event"},
    {"id": "repo-escape", "regex": "\\.\\./(?:\\.\\./)*(?P<target>core|configs|scripts|bin|orch)\\b", "reason": "a module must not reach into hub-level folders through relative paths", "climb": true}
  ],
  "path_suffixes": [".py", ".sh", ".js", ".mjs", ".json", ".toml", ".yml", ".yaml"],
  "path_allow": [
    {"path": "packages/aicore/configs/provider-capabilities.json", "reason": "evidence[].source are pointers to the documents and checks of other modules, kept as data of the manifest; no code reads them as paths"},
    {"path": "packages/aicore/lib/aicore/provider/runtime.py", "reason": "emits the shell locator of the shared task runtime into generated projections; moves with the Task command renderer"}
  ],
  "standalone": {
    "foundation_paths": ["core"],
    "unset_env": ["PYTHONPATH", "SKILLER_HOST_CONFIG"],
    "timeout_s": 1800
  },
  "ownership": [
    {"path": "core/__init__.py", "target": "aicore", "subsystem": "shim", "phase": "P11", "confidence": "fixed", "note": "transitional alias package; deleted with core/"},
    {"path": "core/runs.py", "target": "analyst", "phase": "P11", "confidence": "fixed"},
    {"path": "core/pathology.py", "target": "analyst", "phase": "P11", "confidence": "fixed"},
    {"path": "core/codegraph_telemetry.py", "target": "analyst", "phase": "P11", "confidence": "fixed"},
    {"path": "core/tests/test_shim.py", "target": "aicore", "subsystem": "shim", "phase": "P11", "confidence": "fixed", "note": "deleted with core/"},
    {"path": "core/tests/test_find_run_report.py", "target": "analyst", "subsystem": "tests", "phase": "P11", "confidence": "fixed"},
    {"path": "core/tests/test_runs.py", "target": "analyst", "subsystem": "tests", "phase": "P11", "confidence": "fixed"},
    {"path": "core/tests/test_pathology.py", "target": "analyst", "subsystem": "tests", "phase": "P11", "confidence": "fixed"},
    {"path": "core/tests/test_codegraph_telemetry.py", "target": "analyst", "subsystem": "tests", "phase": "P11", "confidence": "fixed"},
    {"path": "orch/", "target": "orch", "subsystem": "docs/research", "phase": "P10", "confidence": "fixed", "note": "root research documents of the orchestration module"},
    {"path": "packages/artifex/", "target": "retired", "phase": "P11", "confidence": "fixed", "note": "module is retired and not scanned by the boundary check"},
    {"path": "packages/task/", "target": "planner", "phase": "P9", "confidence": "fixed", "note": "folder is renamed to planner (module_aliases)"},
    {"path": "packages/task/configs/command-routing.json", "target": "planner", "phase": "P9", "confidence": "fixed", "note": "mappings.<provider>.{class_selectors,effort_selectors,model_inventory} are a transitional copy of packages/aicore/configs/model-catalog.json (parity test); the copy is removed in P9"},
    {"path": "packages/task/bridges/orch/", "target": "bridges/planner-orch", "phase": "P10", "confidence": "fixed"},
    {"path": "packages/orch/bridges/task/", "target": "bridges/planner-orch", "phase": "P10", "confidence": "fixed"},
    {"path": "packages/orch/bridges/skiller/", "target": "bridges/orch-skiller", "phase": "P10", "confidence": "fixed"},
    {"path": "packages/orch/bridges/harness/", "target": "bridges/orch-harness", "phase": "P10", "confidence": "hypothesis", "note": "not described by the architecture; refine in P10"},
    {"path": "packages/skiller/lib/skiller/common.py", "target": "aicore", "subsystem": "content", "phase": "P5", "confidence": "hypothesis"},
    {"path": "packages/skiller/lib/skiller/skillset.py", "target": "aicore", "subsystem": "delivery", "phase": "P5", "confidence": "hypothesis"},
    {"path": "packages/skiller/lib/skiller/delivery.py", "target": "aicore", "subsystem": "delivery", "phase": "P5", "confidence": "hypothesis"},
    {"path": "packages/skiller/lib/skiller/release.py", "target": "aicore", "subsystem": "release", "phase": "P5", "confidence": "hypothesis"},
    {"path": "packages/skiller/lib/skiller/release_attestation.py", "target": "aicore", "subsystem": "release", "phase": "P5", "confidence": "hypothesis"},
    {"path": "packages/skiller/lib/skiller/topology.py", "target": "maind", "phase": "P11", "confidence": "fixed"},
    {"path": "packages/skiller/lib/skiller/listing.py", "target": "maind", "phase": "P11", "confidence": "fixed"},
    {"path": "packages/skiller/lib/skiller/state.py", "target": "maind", "phase": "P11", "confidence": "fixed"},
    {"path": "packages/skiller/lib/skiller/brain_sync.py", "target": "brain", "phase": "P7", "confidence": "fixed"},
    {"path": "packages/skiller/skills/system/agent-packs/", "target": "harness", "subsystem": "skills", "phase": "P8", "confidence": "fixed"},
    {"path": "packages/skiller/skills/system/agents/", "target": "harness", "subsystem": "skills", "phase": "P8", "confidence": "fixed"},
    {"path": "packages/skiller/skills/system/brain-locator/", "target": "brain", "subsystem": "skills", "phase": "P7", "confidence": "fixed"},
    {"path": "packages/skiller/skills/system/local-topology/", "target": "maind", "subsystem": "skills", "phase": "P8", "confidence": "fixed"},
    {"path": "packages/skiller/skills/system/swissknifeman-locator/", "target": "maind", "subsystem": "skills", "phase": "P8", "confidence": "fixed"},
    {"path": "packages/skiller/skills/system/cross-project-coordinator/", "target": "maind", "subsystem": "skills", "phase": "P8", "confidence": "fixed"},
    {"path": "packages/skiller/skills/system/shared-memory/", "target": "maind", "subsystem": "skills", "phase": "P8", "confidence": "fixed"},
    {"path": "packages/skiller/skills/system/session-observer/", "target": "analyst", "subsystem": "skills", "phase": "P8", "confidence": "fixed"},
    {"path": "packages/harness/lib/harness/cursor_render.py", "target": "aicore", "subsystem": "provider", "phase": "P11", "confidence": "hypothesis", "note": "rendering part; see the harness architecture section"},
    {"path": "packages/harness/lib/harness/grok_render.py", "target": "aicore", "subsystem": "provider", "phase": "P11", "confidence": "hypothesis", "note": "rendering part; see the harness architecture section"},
    {"path": "packages/harness/lib/harness/provider_render.py", "target": "aicore", "subsystem": "provider", "phase": "P11", "confidence": "hypothesis", "note": "rendering part; see the harness architecture section"},
    {"path": "packages/maind/scripts/cache-brain-docs.sh", "target": "brain", "phase": "P7", "confidence": "fixed"},
    {"path": "scripts/ecosystem-units.py", "target": "aicore", "subsystem": "unit", "phase": "P12", "confidence": "hypothesis", "note": "becomes the aicore unit check"}
  ]
}
