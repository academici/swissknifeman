{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:planning:query:get-entity:v1",
  "title": "GetEntity",
  "description": "planning owner contract; see the planning module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "revision_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "draft_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "expected_edit_version": {
      "type": "integer",
      "minimum": 1
    },
    "ref": {
      "type": "string",
      "minLength": 0
    }
  },
  "required": [
    "plan_id",
    "ref"
  ],
  "oneOf": [
    {
      "required": [
        "revision_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "draft_id"
            ]
          },
          {
            "required": [
              "expected_edit_version"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "draft_id",
        "expected_edit_version"
      ],
      "not": {
        "required": [
          "revision_id"
        ]
      }
    }
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.planning.generated.queries",
      "class": "GetEntity",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "planning.ts",
      "name": "GetEntity"
    }
  }
}
