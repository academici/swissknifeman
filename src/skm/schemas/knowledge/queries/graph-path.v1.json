{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:knowledge:query:graph-path:v1",
  "title": "GraphPath",
  "description": "knowledge contract; semantics: the knowledge module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "edge_types": {
      "type": "array",
      "items": {
        "$ref": "urn:skm:knowledge:defs:v1#/$defs/EdgeType"
      }
    },
    "at_revision": {
      "type": "string"
    },
    "src_key": {
      "type": "string"
    },
    "dst_key": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "both"
      ],
      "default": "out"
    },
    "project_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    }
  },
  "required": [
    "workspace_id",
    "src_key",
    "dst_key"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.knowledge.generated.queries",
      "class": "GraphPath",
      "kind": "typeddict"
    },
    "typescript": {
      "file": "knowledge.ts",
      "name": "GraphPath"
    }
  }
}
