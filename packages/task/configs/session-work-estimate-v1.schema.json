{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/session-work-estimate-v1.schema.json",
  "schema_version": "session-work-estimate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_attested",
    "capabilities_attested",
    "capabilities_sufficient",
    "context_attested",
    "context_health",
    "batch_receipt_valid",
    "remaining_batch_digest",
    "loaded_inputs_reusable",
    "cold_start_cost",
    "lifecycle",
    "isolated_review",
    "reviewer_task",
    "checkpoint",
    "external_pause"
  ],
  "properties": {
    "schema_version": {"const": "session-work-estimate/v1"},
    "route_attested": {"type": "boolean"},
    "capabilities_attested": {"type": "boolean"},
    "capabilities_sufficient": {"type": "boolean"},
    "context_attested": {"type": "boolean"},
    "context_health": {"enum": ["sufficient", "insufficient", "unavailable"]},
    "batch_receipt_valid": {"type": "boolean"},
    "remaining_batch_digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "loaded_inputs_reusable": {"type": "boolean"},
    "cold_start_cost": {"type": "integer", "minimum": 0},
    "lifecycle": {"enum": ["active", "scope-complete", "waiting-owner", "waiting-external", "owner-pause-no-resume", "owner-requested-new-session", "whole-plan-independent-audit", "design-root-terminal", "terminal"]},
    "isolated_review": {"type": "boolean"},
    "reviewer_task": {"type": ["string", "null"]},
    "checkpoint": {"type": ["string", "null"]},
    "external_pause": {"type": ["object", "null"], "additionalProperties": false,
      "required": ["reason", "started_at", "resume_at", "observed_at", "fingerprint", "runnable_after", "predicate_satisfied", "continuation"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "resume_at": {"type": "string", "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "fingerprint": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
        "runnable_after": {"type": "string", "minLength": 1},
        "predicate_satisfied": {"type": "boolean"},
        "continuation": {"type": "string", "minLength": 1}
      }}
  }
}
