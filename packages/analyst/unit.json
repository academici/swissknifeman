{
  "$schema": "urn:swissknifeman:aicore:unit:v1",
  "id": "analyst",
  "title": "Session and usage analysis",
  "kind": "capability",
  "version": "0.3.0",
  "stability": "beta",
  "destination": "hub",
  "requires": [
    {"unit": "aicore", "range": "^0.1", "description": "Shared helpers (today the root core package)."}
  ],
  "provides": {
    "cli": ["bin/analyst"],
    "config": "configs/config.schema.json",
    "plugins": [{"name": "analyst", "manifest": ".claude-plugin/plugin.json"}],
    "contracts": [
      {"id": "urn:swissknifeman:analyst:run-lookup", "path": "schemas/run-lookup/v1", "version": "v1", "stability": "alpha"},
      {"id": "urn:swissknifeman:analyst:run-codegraph", "path": "schemas/run-codegraph/v1", "version": "v1", "stability": "alpha"}
    ],
    "doctor": [
      {"id": "analyst.environment", "category": "environment", "probe": ["bin/analyst", "doctor"], "output": "text"}
    ]
  },
  "dev": {
    "test": ["bash", "scripts/test.sh"],
    "validate": ["bash", "scripts/validate.sh"]
  }
}
