          "id": "intent",
          "order": 0,
          "title": "Intent"
        },
        {
          "id": "inputs",
          "order": 10,
          "title": "Inputs"
        },
        {
          "id": "execution",
          "order": 20,
          "title": "Execution"
        },
        {
          "id": "review",
          "order": 30,
          "title": "Review"
        },
        {
          "id": "gates",
          "order": 40,
          "title": "Gates"
        },
        {
          "id": "research",
          "order": 50,
          "title": "Research"
        },
        {
          "id": "validation",
          "order": 60,
          "title": "Validation"
        },
        {
          "id": "result",
          "order": 70,
          "title": "Result"
        }
      ],
      "id": "gui-planner.item",
      "schema": "urn:swissknifeman:task:plan:item:v1"
    },
    {
      "fields": [
        {
          "group": "intent",
          "order": 0,
          "pointer": "/title",
          "widget": "text"
        },
        {
          "group": "intent",
          "order": 10,
          "pointer": "/goal",
          "widget": "textarea"
        },
        {
          "group": "intent",
          "order": 20,
          "pointer": "/context",
          "widget": "textarea"
        },
        {
          "group": "intent",
          "order": 30,
          "pointer": "/scope",
          "widget": "json"
        },
        {
          "group": "execution",
          "order": 0,
          "pointer": "/depends_on",
          "widget": "list"
        },
        {
          "group": "execution",
          "order": 10,
          "pointer": "/deliverables",
          "widget": "list"
        },
        {
          "group": "execution",
          "order": 20,
          "pointer": "/validation",
          "widget": "json"
        },
        {
          "group": "result",
          "order": 0,
          "pointer": "/design",
          "readonly": true,
          "widget": "text"
        },
        {
          "group": "result",
          "order": 10,
          "pointer": "/closed",
          "readonly": true,
          "widget": "json"
        }
      ],
      "groups": [
        {
          "id": "intent",
          "order": 0,
          "title": "Intent"
        },
        {
          "id": "execution",
          "order": 10,
          "title": "Execution"
        },
        {
          "id": "result",
          "order": 20,
          "title": "Result"
        }
      ],
      "id": "gui-planner.phase",
      "schema": "urn:swissknifeman:task:plan:phase:v1"
    },
    {
      "fields": [
        {
          "group": "question",
          "order": 0,
          "pointer": "/title",
          "widget": "text"
        },
        {
          "group": "question",
          "order": 10,
          "pointer": "/question",
          "widget": "textarea"
        },
        {
          "group": "question",
          "order": 20,
          "pointer": "/options",
          "readonly": true,
