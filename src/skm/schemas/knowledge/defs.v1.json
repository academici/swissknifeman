        },
        "tool_name": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "indexed_at": {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/timestamp"
        },
        "completeness": {
          "$ref": "urn:skm:knowledge:defs:v1#/$defs/Completeness"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "urn:skm:knowledge:defs:v1#/$defs/Limitation"
          }
        },
        "files_indexed": {
          "type": "integer",
          "minimum": 0
