{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:settings:learning:v1",
  "title": "Learning settings",
  "description": "Settings section 'learning' owned by learning. Every leaf carries x-skm metadata read by the settings registry.",
  "type": "object",
  "additionalProperties": false,
  "x-skm-section": {
    "id": "learning",
    "owner": "learning",
    "title": "Learning",
    "validators": [
      {
        "id": "learning.thresholds_order",
        "keys": [
          "learning.thresholds.deprecate_conf",
          "learning.thresholds.candidate_min_conf",
          "learning.thresholds.curated_min_conf",
          "learning.thresholds.candidate_min_n",
          "learning.thresholds.curated_min_n",
          "learning.thresholds.candidate_min_n_floor"
        ],
        "rule": "deprecate_conf < candidate_min_conf <= curated_min_conf and candidate_min_n_floor <= candidate_min_n <= curated_min_n"
      },
      {
        "id": "learning.pathology_order",
        "keys": [
          "learning.detectors.pathology_min_hits",
          "learning.detectors.pathology_window"
        ],
        "rule": "pathology_min_hits <= pathology_window"
      }
    ]
  },
