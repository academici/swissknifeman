    },
    "project_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "plan_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_id": {
      "anyOf": [
        {
          "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
        },
        {
          "type": "null"
