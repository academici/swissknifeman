          }
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-z0-9][a-z0-9_.-]{0,63})$"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Shared namespaces readable from this scope (* = global).",
          "x-skm": {
            "chain": "work",
            "levels": [
              "workspace",
              "project"
