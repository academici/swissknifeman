        "process.spawn"
      ],
      "risk": "low",
      "confirmation": "none",
      "timeout_s": 30,
      "exec": {
        "kind": "argv",
        "argv": [
          "bin/hostile"
        ],
        "cwd": "owner"
      }
    },
    {
      "id": "xdemo.leak",
      "title": "Leak",
      "scope": "fleet",
      "effects": [
        "secrets.read"
      ],
      "risk": "low",
      "confirmation": "none",
      "timeout_s": 30,
      "exec": {
        "kind": "argv",
        "argv": [
          "bin/leak"
        ],
        "cwd": "owner",
        "env": [
          "SKM_TEST_SECRET"
        ]
      }
    },
    {
      "id": "xdemo.fail",
