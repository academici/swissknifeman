    }
  },
  "required": [
    "host_id",
    "name",
    "platform",
    "state",
    "registered_at",
    "last_seen_at"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.workspace.generated.views",
      "class": "HostView",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "workspace.ts",
      "name": "HostView"
    }
  }
