{
  "schema_version": "return-loop/v1",
  "cap": {
    "default": 2,
    "name": "same_return_max",
    "subject": "durable_fingerprint",
    "third_occurrence_rule": "occurrences > cap"
  },
  "counted_namespaces": {
    "classified": {
      "counts": true
    },
    "provisional": {
      "counts": true
    },
    "ungroupable": {
      "counts": false
    }
  },
  "eligibility": {
    "local_fix_requires": [
      "deterministic",
      "reproducible",
      "within_scope",
      "within_files",
      "no_risk_trigger"
    ],
    "risk_triggers": [
      "protected_boundary",
      "frozen_contract",
      "public_contract",
      "security",
      "destructive",
      "irreversible",
      "cross_package",
      "rule_conflict",
      "unclear_architecture",
      "unclear_acceptance"
    ],
    "trigger_source": "observed_facts_only",
    "wording_is_not_a_trigger": [
      "blocked",
      "escalated"
    ]
  },
  "ladder": [
    {
      "action": "local-fix",
      "blocks": false,
      "occurrences": 1,
      "requires_eligibility": true
    },
    {
      "action": "isolated-review",
      "blocks": true,
      "occurrences": 2,
      "review_budget": 1
    },
    {
      "action": "owner-gate",
      "blocks": true,
      "occurrences_rule": "occurrences > cap"
    }
  ],
  "risk_trigger_action": {
    "action": "isolated-review",
    "blocks": true,
    "occurrences_min": 1,
    "review_budget": 1
  },
  "review_effect": {
    "may_allow_after_review_below_cap": true,
    "may_change_fingerprint": false,
    "may_decrease_occurrences": false,
    "may_remove_owner_gate_above_cap": false
  },
  "outcomes": {
    "at_cap": {
      "action": "owner-gate",
      "action_class": "OWNER",
      "attention": "batched",
      "blocks": true,
      "recorded": true
    },
    "under_cap": {
      "action": "ladder",
      "action_class": "AUTO-FIX",
      "attention": "none",
      "blocks": false,
      "recorded": true
    },
    "ungroupable": {
      "action": "record-only",
      "action_class": "AUTO",
      "attention": "none",
      "blocks": false,
      "recorded": true
    }
  },
  "owner_packet": [
    "fingerprint_tuple",
    "fingerprint_digest",
    "occurrences",
    "cap",
    "history",
    "judgements",
    "resolutions_tried"
  ],
  "owner_packet_history_fields": [
    "ts",
    "attempt",
    "actor",
    "command",
    "decision_refs",
    "finding_refs"
  ],
  "pre_p5_policy": {
    "action": "hard-stop-and-print-owner-packet",
    "blocks": true
  },
  "escalation_qualification": {
    "enum": [
      "new",
      "repeat",
      "unqualifiable"
    ],
    "required_by_value": {
      "new": [
        "fingerprint_digest",
        "occurrences"
      ],
      "repeat": [
        "fingerprint_digest",
        "occurrences"
      ],
      "unqualifiable": [
        "missing_carrier_reason"
      ]
    }
  },
  "reason_codes": [
    "RETURN_LOOP_ISOLATED_REVIEW_REQUIRED",
    "RETURN_LOOP_OWNER_GATE_REQUIRED",
    "RETURN_LOOP_QUALIFICATION_REQUIRED"
  ],
  "borrowed_authority_sets": {
    "action_classes": [
      "AUTO",
      "AUTO-FIX",
      "OWNER"
    ],
    "attention_classes": [
      "none",
      "batched",
      "immediate"
    ],
    "extension_allowed": false,
    "source": "authority-policy-v1"
  },
  "advisory_mode": false
}
