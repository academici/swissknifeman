{
  "$schema": "urn:swissknifeman:aicore:unit:v1",
  "id": "planner",
  "title": "Planner: plans, phases, items and execution commands",
  "kind": "capability",
  "version": "0.28.3",
  "stability": "beta",
  "destination": "own-repo",
  "requires": [
    {"unit": "aicore", "range": "^0.1", "description": "Shared helpers (today the root core package)."}
  ],
  "provides": {
    "cli": ["scripts/plan.py"],
    "config": "configs/config.schema.json",
    "plugins": [{"name": "planner", "manifest": ".claude-plugin/plugin.json"}],
    "contracts": [
      {"id": "urn:swissknifeman:task:plan", "path": "schemas/plan/v1", "version": "v1", "stability": "beta"},
      {"id": "urn:swissknifeman:planner:event-data", "path": "schemas/event-data/v1", "version": "v1", "stability": "beta"}
    ],
    "events": [
      "planner.plan.created", "planner.plan.closed", "planner.phase.closed",
      "planner.item.started", "planner.item.finished", "planner.decision.accepted"
    ]
  },
  "dev": {
    "validate": ["bash", "scripts/validate.sh"]
  }
}
