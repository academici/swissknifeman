{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:execution:role-result:reviewer:v1",
  "title": "ReviewerResult",
  "description": "Review findings of the reviewer role (document kind review-findings). finding_key is computed by the server (execution.md §5.8); the role gives only local ids F<n>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verdict",
    "summary",
    "findings",
    "residual_risk"
  ],
  "properties": {
    "schema": {
      "const": "urn:skm:execution:role-result:reviewer:v1"
    },
    "verdict": {
      "enum": [
        "green",
        "attention",
        "red"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "residual_risk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths_reviewed": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "criteria_checked": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "pattern": "^AC[0-9]{1,4}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "green"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "severity": {
                  "enum": [
                    "minor",
                    "nit"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "attention",
              "red"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "confidence",
        "basis",
        "category",
        "message",
        "failure_scenario",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{1,3}$"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "nit"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "basis": {
          "enum": [
            "correctness",
            "security",
            "contract",
            "test",
            "maintainability",
            "docs"
          ]
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,40}(/[a-z][a-z0-9_]{0,40})?$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "failure_scenario": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mount",
            "path"
          ],
          "properties": {
            "mount": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "expected_exit": {
              "type": "integer"
            }
          }
        },
        "fix_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.execution.generated.documents",
      "class": "ReviewerResultDoc",
      "kind": "typeddict"
    },
    "typescript": {
      "file": "execution.ts",
      "name": "ReviewerResultDoc"
    }
  }
}
