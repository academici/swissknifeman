{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:execution:stage-outcome-run-checks:v1",
  "title": "StageOutcomeRunChecks",
  "description": "Normative execution contract; details and semantic validation: spec/modules/execution.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "round_no": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_execution_id": {
            "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
          },
          "check_spec_id": {
            "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "passed",
              "failed",
              "manual_pending",
              "error",
              "cancelled",
              "unknown"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence_file_version_ids": {
            "type": "array",
            "items": {
              "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
            }
          },
          "reused_from": {
            "anyOf": [
              {
                "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "fingerprint": {
            "$ref": "urn:skm:kernel:defs:v1#/$defs/digest"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "check_spec_id",
          "state"
        ]
      }
    },
    "tree_changed": {
      "type": "boolean"
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "detail": {
      "type": "string"
    },
    "error_class": {
      "type": "string"
    },
    "worktree_dirty": {
      "type": "boolean"
    },
    "retry_after_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [],
  "anyOf": [
    {
      "required": [
        "round_no",
        "results"
      ]
    },
    {
      "required": [
        "error_code"
      ]
    }
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.execution.generated.documents",
      "class": "StageOutcomeRunChecks",
      "kind": "typeddict"
    },
    "typescript": {
      "file": "execution.ts",
      "name": "StageOutcomeRunChecks"
    }
  }
}
