{
  "$schema": "urn:swissknifeman:aicore:extension:v1",
  "id": "fake-cs",
  "kind": "command",
  "version": "0.1.0",
  "description": "Test work source of the conductor: a plan of pieces of work kept in one JSON state file.",
  "protocol": {"min": "1", "max": "1"},
  "entrypoint": ["python3", "plugin.py"],
  "provides": {"points": ["orch:work-source"]},
  "permissions": {"env": ["FAKE_CS_STATE", "FAKE_CS_INPUT"]},
  "timeout_seconds": 60
}
