{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swissknifeman:aicore:workspace-project:v1",
  "title": "workspace-project",
  "type": "object",
  "description": "Project record in the workspace (projects/<project_id>/project.json). Portable: it holds no absolute path.",
  "properties": {
    "$schema": {
      "const": "urn:swissknifeman:aicore:workspace-project:v1",
      "description": "Schema identifier."
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Project id: prj_ and 26 Crockford base32 characters."
    },
    "name": {
      "type": "string",
      "pattern": "^(?![/~]|[A-Za-z]:[\\\\/]).+$",
      "description": "Human-readable project name; never a path."
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Creation time, UTC, second precision."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "description": "What `workspace project attach` matches a checkout against.",
      "properties": {
        "remotes": {
          "type": "array",
          "uniqueItems": true,
          "description": "Normalized remotes of the project (`host/owner/repo`, no scheme, no user information).",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?(/[^/\\s@]+)+$",
            "description": "One normalized remote."
          }
        }
      },
      "required": [
        "remotes"
      ]
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "description": "Other names of the project.",
      "items": {
        "type": "string",
        "pattern": "^(?![/~]|[A-Za-z]:[\\\\/]).+$",
        "description": "One alias; never a path."
      }
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ],
      "description": "Whether the project takes part in sync and listings."
    }
  },
  "required": [
    "$schema",
    "project_id",
    "name",
    "created_at",
    "identity",
    "aliases",
    "status"
  ],
  "additionalProperties": false
}
