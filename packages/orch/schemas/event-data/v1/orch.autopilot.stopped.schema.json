{
  "$id": "urn:swissknifeman:orch:event-data:orch-autopilot-stopped:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The autopilot controller of a project ended its session with a stop code (orch conduct autopilot start).",
  "properties": {
    "code": {
      "description": "AUTOPILOT_* stop code.",
      "enum": [
        "AUTOPILOT_NO_WORK",
        "AUTOPILOT_DRAINED",
        "AUTOPILOT_STOPPED",
        "AUTOPILOT_MAX_RUNS",
        "AUTOPILOT_MAX_WALL",
        "AUTOPILOT_NOT_ALLOWED",
        "AUTOPILOT_DISABLED",
        "AUTOPILOT_BUSY",
        "AUTOPILOT_NOT_READY",
        "AUTOPILOT_OWNER_NEEDED",
        "AUTOPILOT_BUDGET",
        "AUTOPILOT_QUOTA",
        "AUTOPILOT_REPEATED_BLOCKER",
        "AUTOPILOT_NO_PROGRESS",
        "AUTOPILOT_DECISIONS_EXCEEDED",
        "AUTOPILOT_RECOVERY_EXHAUSTED",
        "AUTOPILOT_CHECKOUT_LOST",
        "AUTOPILOT_STATE_INVALID",
        "AUTOPILOT_RUN_STOPPED",
        "AUTOPILOT_INTERRUPTED"
      ],
      "type": "string"
    },
    "items_closed": {
      "description": "Pieces the session closed.",
      "minimum": 0,
      "type": "integer"
    },
    "message": {
      "description": "What happened and the one action that goes on.",
      "maxLength": 500,
      "type": "string"
    },
    "plan": {
      "description": "Collection of the work source.",
      "minLength": 1,
      "type": "string"
    },
    "runs": {
      "description": "Conductor runs the session started.",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "plan",
    "code",
    "runs",
    "items_closed"
  ],
  "title": "orch.autopilot.stopped",
  "type": "object"
}
