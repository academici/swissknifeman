{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swissknifeman.local/task/producer-readiness-v1.schema.json",
  "title": "Task producer readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_item", "consumer_item", "mode", "roots", "command", "candidate_count", "candidate_paths_sha256", "source_commit", "predicate", "exclusions"],
  "properties": {
    "schema_version": {"const": "producer-readiness/v1"},
    "producer_item": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"},
    "consumer_item": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]+$"},
    "mode": {"enum": ["nonempty-candidates", "empty-by-decision"]},
    "roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidate_paths_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "predicate": {"type": "string", "minLength": 1},
    "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owner_decision": {"type": "string", "pattern": "^D[0-9]+$"}
  }
}
