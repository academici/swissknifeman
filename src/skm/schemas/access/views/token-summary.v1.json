  "required": [
    "token_id",
    "kind",
    "name",
    "prefix",
    "scope_id",
    "permissions",
    "state",
    "expires_at",
    "last_used_at",
    "created_at",
    "superseded_by",
    "assignment_id",
    "step_id"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.access.generated.views",
      "class": "TokenSummaryView",
      "kind": "dataclass"
    },
    "typescript": {
      "file": "access.ts",
      "name": "TokenSummaryView"
    }
  }
