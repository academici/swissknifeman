{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:policy:tool-call:v1",
  "title": "ToolCall",
  "description": "One tool call of an agent judged by check_tool_call (policy.md §5.3): a file call, a shell command with its working directory, a web access or an MCP call. Paths are resolved by the host (PathFacts.resolve) before the decision; the pure core performs no IO.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "fs.read"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "tool",
        "path"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "fs.write"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "tool",
        "path"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "fs.edit"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "tool",
        "path"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "fs.delete"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "tool",
        "path"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "shell.run"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "cwd": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "tool",
        "command",
        "cwd"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "web.fetch"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "tool",
        "url"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "web.search"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "tool",
        "query"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "description": "MCP call; its tool name for policy is mcp:<server>/<tool>.",
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "server": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "tool",
        "server"
      ]
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.policy.generated.documents",
      "class": "ToolCall",
      "kind": "alias"
    },
    "typescript": {
      "file": "policy.ts",
      "name": "ToolCall"
    }
  }
}
