{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:mcp:tool-input:plan-draft-rebase:v1",
  "title": "skm_plan_draft_rebase input",
  "description": "Input for the skm_plan_draft_rebase MCP tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan": {
      "type": "string",
      "minLength": 1
    },
    "draft_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "expected_edit_version": {
      "type": "integer",
      "minimum": 1
    },
    "onto_revision_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
    },
    "resolutions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "conflict_id": {
                "type": "string",
                "minLength": 0
              },
              "keep": {
                "type": "string",
                "enum": [
                  "yours",
                  "theirs"
                ]
              }
            },
            "required": [
              "conflict_id",
              "keep"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "conflict_id": {
                "type": "string",
                "minLength": 0
              },
              "new_key": {
                "type": "string",
                "minLength": 0
              }
            },
            "required": [
              "conflict_id",
              "new_key"
            ]
          }
        ]
      },
      "maxItems": 500
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "plan",
    "draft_id",
    "expected_edit_version",
    "idempotency_key"
  ]
}
