{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skm:policy:view:intent-summary:v1",
  "title": "IntentSummaryView",
  "description": "policy owner contract; see the policy module.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "$ref": "urn:skm:kernel:defs:v1#/$defs/uuid"
