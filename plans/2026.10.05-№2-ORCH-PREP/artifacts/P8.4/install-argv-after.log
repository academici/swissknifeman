## default rc=0
argv: codex plugin marketplace add <ROOT>
argv: codex plugin add core@swissknifeman
argv: codex plugin add task@swissknifeman
argv: grok plugin marketplace add <ROOT>
argv: grok plugin install <ROOT>/packages/task --trust
argv: grok plugin install <ROOT>/packages/task/adapters/grok/prefix-hold --trust
stdout: Installed: <TMP>/bin/skiller -> <ROOT>/packages/skiller/bin/skiller
stdout: WARN: <TMP>/bin not in PATH. Add:
stdout:   echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
stdout: Check: skiller doctor
stdout: Codex plugins installed: core task
stdout: Grok plugins installed: task prefix-hold
