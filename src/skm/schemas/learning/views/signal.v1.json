  },
  "required": [
    "signal_id",
    "source",
    "observed_at",
    "sessions_known",
    "sessions_success",
    "evidence_dependency",
    "tests_total",
    "tests_passed",
    "activity"
  ],
  "x-skm-codegen": {
    "python": {
      "module": "skm.modules.learning.generated.views",
      "class": "SignalView",
      "kind": "typeddict"
    },
    "typescript": {
      "file": "learning.ts",
      "name": "SignalView"
    }
  }
